---
import '../styles/store.css';
import Mark from '../components/store/Mark.astro';
import { perch } from '../data/perch';
interface Props { title?: string; description?: string; noindex?: boolean }
const { title = 'Perch — A little less agent babysitting.', description = perch.description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, perch.origin).href;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>{title}</title><meta name="description" content={description}/>
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'}/>
    <link rel="canonical" href={canonical}/><link rel="icon" href="/products/perch-icon.webp" type="image/webp"/>
    <link rel="apple-touch-icon" href="/apple-touch-icon.png"/><link rel="manifest" href="/site.webmanifest"/>
    <meta name="theme-color" content="#fafbf8"/>
    <meta property="og:title" content={title}/><meta property="og:description" content={description}/>
    <meta property="og:type" content="website"/><meta property="og:url" content={canonical}/><meta property="og:site_name" content="Perch"/>
    <meta property="og:locale" content="en_US"/><meta property="og:image" content={`${perch.origin}/social-card.png`}/>
    <meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/>
    <meta property="og:image:alt" content="Perch. Your agents. Your notes. A place at the edge. $29 USD, one time."/>
    <meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/>
    <meta name="twitter:description" content={description}/><meta name="twitter:image" content={`${perch.origin}/social-card.png`}/>
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Perch information for language models"/>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="header"><nav class="shell nav" aria-label="Main navigation">
      <a href="/" class="brand"><Mark product="perch" size={32}/>Perch.</a>
      <div class="nav-links"><a href="/#how">How it works</a><a href="/#pricing">Pricing</a><a href="/#questions">FAQ</a></div>
      <a class="button small nav-cta" href="/checkout/">Perch · $29 <span aria-hidden="true">↗</span></a>
    </nav></header>
    <main id="main"><slot/></main>
    <footer class="shell footer">
      <div><a class="brand" href="/"><Mark product="perch" size={28}/>Perch.</a><p>Keep the little things in view.</p></div>
      <div class="footer-links"><a href={perch.support}>Support ↗</a><a href="/privacy/">Privacy</a><a href="/terms/">Terms</a></div>
      <div class="footer-bottom"><span>© {new Date().getFullYear()} Perch</span><span>$29 USD · One payment. No subscription.</span></div>
    </footer>
  </body>
</html>
