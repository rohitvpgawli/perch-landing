---
import '../styles/store.css';
import Mark from '../components/store/Mark.astro';
import { perch, analyticsToken, purchaseHref, checkoutReady } from '../data/perch';
interface Props { title?: string; description?: string; noindex?: boolean }
const { title = 'Perch: stop babysitting your coding agents', description = perch.description, noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, perch.origin).href;
const footer = [
  { title: 'Product', links: [['Live demo', '/#demo'], ['What’s in Perch', '/#inside'], ['How it works', '/#how'], ['Works with', '/#agents'], ['Privacy', '/#privacy']] },
  { title: 'Pricing', links: [['Pricing', '/#pricing'], ['Refunds', '/terms/#refunds'], ['Post for money back', '/back/'], ['FAQ', '/#questions']] },
  { title: 'Support', links: [['Email support', perch.support], ['Privacy policy', '/privacy/'], ['Terms & refunds', '/terms/']] },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/>
    <title>{title}</title><meta name="description" content={description}/>
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'}/>
    <link rel="canonical" href={canonical}/><link rel="icon" href="/products/perch-icon.webp" type="image/webp"/>
    <link rel="apple-touch-icon" href="/apple-touch-icon.png"/><link rel="manifest" href="/site.webmanifest"/>
    <meta name="theme-color" content="#08090a"/>
    <meta property="og:title" content={title}/><meta property="og:description" content={description}/>
    <meta property="og:type" content="website"/><meta property="og:url" content={canonical}/><meta property="og:site_name" content="Perch"/>
    <meta property="og:locale" content="en_US"/><meta property="og:image" content={`${perch.origin}/social-card.png`}/>
    <meta property="og:image:width" content="1200"/><meta property="og:image:height" content="630"/>
    <meta property="og:image:alt" content="Perch. Your agents. Your notes. A place at the edge. $29 USD, one time."/>
    <meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content={title}/>
    <meta name="twitter:description" content={description}/><meta name="twitter:image" content={`${perch.origin}/social-card.png`}/>
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Perch information for language models"/>
    {analyticsToken && <script is:inline defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: analyticsToken })}></script>}
  </head>
  <body class="dark">
    <script is:inline>document.documentElement.classList.add('js')</script>
    <a class="skip" href="#main">Skip to content</a>
    <header class="header"><nav class="shell nav" aria-label="Main navigation">
      <a href="/" class="brand"><Mark product="perch" size={32}/>Perch.</a>
      <div class="nav-links"><a href="/#demo">Demo</a><a href="/#inside">Features</a><a href="/#privacy">Privacy</a><a href="/#pricing">Pricing</a><a href="/#questions">FAQ</a></div>
      <a class="button small nav-cta" href={purchaseHref}>{checkoutReady ? `Get Perch · $${perch.price}` : 'Get early access'}</a>
    </nav></header>
    <main id="main"><slot/></main>
    <footer class="site-footer">
      <div class="shell footer-top">
        <div class="footer-brand">
          <a class="brand" href="/" aria-label="Perch home"><Mark product="perch" size={30}/>Perch.</a>
          <p>Your coding agents at the edge of your Mac. Paid for once.</p>
          <a class="footer-buy" href={purchaseHref}><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/></svg>{checkoutReady ? 'Get Perch for Mac' : 'Join the waitlist'}</a>
          <small>${perch.price} once for the first {perch.launchSeats.toLocaleString('en-US')} customers, then ${perch.regularPrice}.</small>
        </div>
        <nav class="footer-cols" aria-label="Footer">
          {footer.map(column => <div><b>{column.title}</b>{column.links.map(([label, href]) => <a href={href}>{label}</a>)}</div>)}
        </nav>
      </div>
      <div class="shell footer-bottom">
        <span>Perch runs on your Mac. Nothing it sees leaves it.</span>
        <div class="footer-company"><span>© {new Date().getFullYear()} {perch.company}</span><span>Made in Vancouver <span role="img" aria-label="with love">❤️</span> by <a class="footer-team" href="https://trillium.one" target="_blank" rel="noopener">quietmachines</a></span></div>
      </div>
      <div class="footer-wordmark" aria-hidden="true">
        <svg viewBox="0 0 1000 300" preserveAspectRatio="xMidYMin slice"><defs><pattern id="perch-stripes" width="13" height="10" patternUnits="userSpaceOnUse"><rect width="6" height="10" fill="#ffffff"/></pattern><linearGradient id="perch-fade" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#fff" stop-opacity=".2"/><stop offset="1" stop-color="#fff" stop-opacity=".04"/></linearGradient><mask id="perch-mask"><rect width="1000" height="300" fill="url(#perch-fade)"/></mask></defs><text x="500" y="285" text-anchor="middle" font-size="330" font-weight="700" letter-spacing="-6" fill="url(#perch-stripes)" mask="url(#perch-mask)" font-family="Inter Tight, -apple-system, sans-serif">perch</text></svg>
      </div>
    </footer>
  </body>
</html>
