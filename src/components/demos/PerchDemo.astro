---
/**
 * Perch demo: three agents work, ask, and finish. Answer with 1/2/3, undo with Escape,
 * clear a finished card with E, move between cards with J/K.
 */
const agents = [
  {
    id: "claude-7",
    cwd: "~/shop/web",
    color: "#d97757",
    task: "Add a pricing page",
    ask: "Which layout should the pricing page use?",
    opts: ["Three tiers", "One plan", "A table"],
    rec: 0,
    done: "Pricing page added. 3 tiers, responsive, 0 lint errors.",
    next: ["Open a PR", "Show me a preview"],
    delay: 1200,
  },
  {
    id: "codex-12",
    cwd: "~/shop/api",
    color: "#10a37f",
    task: "Add Stripe checkout",
    ask: "Use the test keys from .env.example?",
    opts: ["Yes, test keys", "No, I'll add mine", "Skip Stripe for now"],
    rec: 0,
    done: "Stripe checkout wired up. 42 tests passed in 3.1s.",
    next: ["Open a PR", "Run it locally"],
    delay: 4800,
  },
  {
    id: "opencode-3",
    cwd: "~/shop/docs",
    color: "#5e5ce6",
    task: "Update the README",
    ask: "Rewrite the README, or append a section?",
    opts: ["Append a section", "Rewrite it", "Leave it"],
    rec: 0,
    done: "README updated with a Pricing section and screenshots.",
    next: ["Open a PR"],
    delay: 8800,
  },
];
---

<div class="perch" data-perch tabindex="0" aria-label="Perch inbox demo. Press 1, 2 or 3 to answer an agent.">
  <div class="rail" aria-hidden="true">
    {agents.map((a, i) => <i class="dot" data-dot={i} style={`--c:${a.color}`} />)}
  </div>

  <div class="inbox">
    <div class="head">
      <b>Inbox</b>
      <span data-summary>3 working</span>
    </div>

    <ul class="cards" data-cards>
      {
        agents.map((a, i) => (
          <li class="card" data-card={i} data-s="work" data-delay={a.delay} style={`--c:${a.color}`}>
            <div class="who">
              <i />
              <b>{a.id}</b>
              <span>{a.cwd}</span>
              <em class="state" data-state>
                Working
              </em>
            </div>
            <p class="task" data-task>
              {a.task}
            </p>

            <div class="ask" data-ask hidden>
              <b>{a.ask}</b>
              <div class="opts">
                {a.opts.map((o, j) => (
                  <button type="button" data-opt={j}>
                    <kbd>{j + 1}</kbd>
                    <span>{o}</span>
                    {j === a.rec && <small>Recommended</small>}
                  </button>
                ))}
              </div>
            </div>

            <div class="sent" data-sent hidden>
              <span>
                Sending <b data-choice />
              </span>
              <button type="button" data-undo>
                Undo <kbd>esc</kbd>
              </button>
              <i class="fuse" data-fuse />
            </div>

            <div class="done" data-done hidden>
              <b>{a.done}</b>
              <div class="next">
                {a.next.map((n) => (
                  <span>{n}</span>
                ))}
                <button type="button" class="clear" data-clear>
                  Clear <kbd>E</kbd>
                </button>
              </div>
            </div>

            <span class="bar">
              <i data-bar />
            </span>
          </li>
        ))
      }
    </ul>

    <div class="foot">
      <span data-foot>Click the inbox, then press <kbd>1</kbd> <kbd>2</kbd> <kbd>3</kbd> to answer.</span>
      <button type="button" class="again" data-again hidden>Run again</button>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-perch]").forEach((root) => {
    const cards = [...root.querySelectorAll<HTMLElement>("[data-card]")];
    const dots = [...root.querySelectorAll<HTMLElement>("[data-dot]")];
    const summary = root.querySelector<HTMLElement>("[data-summary]")!;
    const foot = root.querySelector<HTMLElement>("[data-foot]")!;
    const again = root.querySelector<HTMLButtonElement>("[data-again]")!;

    type S = "work" | "ask" | "sent" | "work2" | "done" | "cleared";
    type St = { s: S; p: number; fuse: number; timer: number; choice: string };
    const st: St[] = cards.map(() => ({ s: "work", p: 0, fuse: 0, timer: 0, choice: "" }));
    let focus = -1;
    let loop = 0;
    let started = false;

    const label: Record<S, string> = { work: "Working", ask: "Needs you", sent: "Sending", work2: "Working", done: "Done", cleared: "" };

    const render = () => {
      let work = 0;
      let ask = 0;
      let done = 0;
      cards.forEach((c, i) => {
        const s = st[i];
        c.dataset.s = s.s;
        c.classList.toggle("focus", i === focus && s.s !== "cleared");
        c.querySelector<HTMLElement>("[data-state]")!.textContent = label[s.s];
        c.querySelector<HTMLElement>("[data-ask]")!.hidden = s.s !== "ask";
        c.querySelector<HTMLElement>("[data-sent]")!.hidden = s.s !== "sent";
        c.querySelector<HTMLElement>("[data-done]")!.hidden = s.s !== "done";
        c.querySelector<HTMLElement>("[data-bar]")!.style.transform = `scaleX(${s.p / 100})`;
        c.querySelector<HTMLElement>("[data-choice]")!.textContent = s.choice;
        dots[i].dataset.s = s.s;
        if (s.s === "work" || s.s === "work2" || s.s === "sent") work++;
        if (s.s === "ask") ask++;
        if (s.s === "done") done++;
      });
      summary.textContent = ask ? `${ask} need${ask === 1 ? "s" : ""} you` : work ? `${work} working` : done ? "All done" : "All clear";
      summary.classList.toggle("amber", ask > 0);
      const over = st.every((s) => s.s === "cleared" || s.s === "done") && !st.some((s) => s.s === "done");
      again.hidden = !over;
      if (over) {
        foot.textContent = "Nothing is waiting on you.";
        stop();
      }
    };

    const firstAsk = () => st.findIndex((s) => s.s === "ask");
    const refocus = () => {
      if (focus >= 0 && st[focus].s !== "cleared") return;
      focus = firstAsk() >= 0 ? firstAsk() : st.findIndex((s) => s.s !== "cleared");
    };

    const tick = () => {
      const t = performance.now();
      cards.forEach((c, i) => {
        const s = st[i];
        if (s.s === "work") {
          s.p = Math.min(40, s.p + 1.4);
          if (t - t0 > Number(c.dataset.delay)) {
            s.s = "ask";
            s.p = 40;
            if (focus < 0 || st[focus].s !== "ask") focus = i;
            foot.innerHTML = "Press <kbd>1</kbd> <kbd>2</kbd> <kbd>3</kbd> to answer, or click. <kbd>esc</kbd> takes it back.";
          }
        } else if (s.s === "work2") {
          s.p = Math.min(100, s.p + 0.9 + Math.random() * 0.6);
          if (s.p >= 100) {
            s.s = "done";
            foot.innerHTML = "<kbd>E</kbd> clears a finished card. <kbd>J</kbd> and <kbd>K</kbd> move between cards.";
          }
        }
      });
      render();
    };

    let t0 = 0;
    const start = () => {
      if (loop) return;
      t0 = performance.now() - (started ? 99999 : 0);
      started = true;
      loop = window.setInterval(tick, 80);
    };
    const stop = () => {
      clearInterval(loop);
      loop = 0;
    };

    const answer = (i: number, j: number) => {
      const s = st[i];
      if (s.s !== "ask") return;
      const card = cards[i];
      s.choice = card.querySelectorAll<HTMLElement>("[data-opt] span")[j].textContent!;
      s.s = "sent";
      const fuse = card.querySelector<HTMLElement>("[data-fuse]")!;
      fuse.style.animation = "none";
      void fuse.offsetWidth;
      fuse.style.animation = "";
      s.timer = window.setTimeout(() => {
        if (s.s !== "sent") return;
        s.s = "work2";
        s.p = 42;
        refocus();
        render();
        start();
      }, 2000);
      render();
    };

    const undo = (i: number) => {
      const s = st[i];
      if (s.s !== "sent") return;
      clearTimeout(s.timer);
      s.s = "ask";
      render();
    };

    const clear = (i: number) => {
      const s = st[i];
      if (s.s !== "done") return;
      s.s = "cleared";
      if (focus === i) {
        focus = -1;
        refocus();
      }
      render();
    };

    const move = (d: number) => {
      const live = st.map((s, i) => (s.s === "cleared" ? -1 : i)).filter((i) => i >= 0);
      if (!live.length) return;
      const at = live.indexOf(focus);
      focus = live[(at + d + live.length) % live.length];
      render();
    };

    cards.forEach((c, i) => {
      c.querySelectorAll<HTMLButtonElement>("[data-opt]").forEach((b) => b.addEventListener("click", () => answer(i, Number(b.dataset.opt))));
      c.querySelector("[data-undo]")!.addEventListener("click", () => undo(i));
      c.querySelector("[data-clear]")!.addEventListener("click", () => clear(i));
      c.addEventListener("click", () => {
        if (st[i].s !== "cleared") {
          focus = i;
          render();
        }
      });
    });

    root.addEventListener("keydown", (e) => {
      if (e.metaKey || e.ctrlKey || e.altKey) return;
      const k = e.key;
      if (k === "1" || k === "2" || k === "3") {
        const i = focus >= 0 && st[focus].s === "ask" ? focus : firstAsk();
        if (i >= 0) {
          e.preventDefault();
          focus = i;
          answer(i, Number(k) - 1);
        }
      } else if (k === "Escape") {
        const i = st.findIndex((s) => s.s === "sent");
        if (i >= 0) {
          e.preventDefault();
          undo(i);
        }
      } else if (k === "e" || k === "E") {
        const i = focus >= 0 && st[focus].s === "done" ? focus : st.findIndex((s) => s.s === "done");
        if (i >= 0) {
          e.preventDefault();
          clear(i);
        }
      } else if (k === "j" || k === "J" || k === "ArrowDown") {
        e.preventDefault();
        move(1);
      } else if (k === "k" || k === "K" || k === "ArrowUp") {
        e.preventDefault();
        move(-1);
      }
    });

    again.addEventListener("click", () => {
      st.forEach((s) => {
        clearTimeout(s.timer);
        Object.assign(s, { s: "work", p: 0, choice: "" });
      });
      focus = -1;
      started = false;
      foot.innerHTML = "Press <kbd>1</kbd> <kbd>2</kbd> <kbd>3</kbd> to answer, or click.";
      render();
      start();
    });

    render();
    new IntersectionObserver(
      ([e]) => {
        const busy = st.some((s) => s.s === "work" || s.s === "work2");
        if (e.isIntersecting && busy) start();
        else stop();
      },
      { threshold: 0.35 },
    ).observe(root);
  });
</script>

<style>
  .perch {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 14px;
    padding: 20px 16px 22px 12px;
    min-height: 460px;
    background:
      radial-gradient(70% 50% at 100% 0%, color-mix(in srgb, var(--accent) 24%, transparent), transparent 70%),
      linear-gradient(170deg, #0d1614, #090d0c);
    color: #f5f5f7;
    outline: none;
  }

  .perch:focus-visible {
    box-shadow: inset 0 0 0 2px color-mix(in srgb, var(--accent) 70%, #fff);
  }

  /* Toolbar rail */
  .rail {
    align-self: start;
    display: grid;
    gap: 12px;
    padding: 12px 9px;
    border-radius: 999px;
    background: rgb(0 0 0 / 0.5);
    box-shadow: inset 0 0 0 0.5px rgb(255 255 255 / 0.16);
  }

  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: #0a84ff;
    transition: background 0.3s, box-shadow 0.3s, opacity 0.3s;
  }

  .dot[data-s="work"],
  .dot[data-s="work2"],
  .dot[data-s="sent"] {
    animation: pulse 1.6s ease-in-out infinite;
  }

  .dot[data-s="ask"] {
    background: #ff9f0a;
    box-shadow: 0 0 0 3px rgb(255 159 10 / 0.3);
  }

  .dot[data-s="done"] {
    background: #30d158;
  }

  .dot[data-s="cleared"] {
    opacity: 0.2;
    background: #8e8e93;
  }

  @keyframes pulse {
    50% {
      opacity: 0.45;
    }
  }

  /* Inbox */
  .inbox {
    min-width: 0;
    display: grid;
    align-content: start;
    gap: 8px;
    padding: 10px;
    border-radius: 18px;
    background: rgb(28 30 34 / 0.75);
    box-shadow:
      inset 0 0 0 0.5px rgb(255 255 255 / 0.12),
      0 30px 60px -30px rgb(0 0 0 / 0.7);
  }

  .head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 6px 8px 2px;
    font-size: 15px;
  }

  .head span {
    font-size: 12.5px;
    color: rgb(255 255 255 / 0.55);
    transition: color 0.3s;
  }

  .head span.amber {
    color: #ffb340;
  }

  .cards {
    display: grid;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .card {
    position: relative;
    display: grid;
    gap: 8px;
    padding: 12px 12px 14px;
    border-radius: 13px;
    background: rgb(255 255 255 / 0.06);
    box-shadow: inset 0 0 0 0.5px rgb(255 255 255 / 0.06);
    font-size: 13.5px;
    overflow: hidden;
    transition: background 0.3s, box-shadow 0.3s, opacity 0.4s, transform 0.4s;
  }

  .card.focus {
    box-shadow: inset 0 0 0 1.5px rgb(255 255 255 / 0.5);
  }

  .card[data-s="ask"] {
    background: rgb(255 159 10 / 0.13);
    box-shadow: inset 0 0 0 0.5px rgb(255 159 10 / 0.4);
  }

  .card[data-s="ask"].focus {
    box-shadow: inset 0 0 0 1.5px rgb(255 179 64 / 0.9);
  }

  .card[data-s="done"] {
    background: rgb(48 209 88 / 0.1);
  }

  .card[data-s="cleared"] {
    opacity: 0;
    transform: translateX(24px);
    pointer-events: none;
    max-height: 0;
    padding-block: 0;
    margin-top: -8px;
  }

  .who {
    display: flex;
    align-items: center;
    gap: 7px;
    font-size: 12.5px;
    color: rgb(255 255 255 / 0.7);
  }

  .who i {
    width: 14px;
    height: 14px;
    border-radius: 4px;
    background: var(--c);
  }

  .who b {
    color: #fff;
  }

  .who span {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    opacity: 0.6;
  }

  .state {
    margin-left: auto;
    flex: none;
    font-style: normal;
    font-weight: 600;
    color: #6fb7ff;
  }

  [data-s="ask"] .state {
    color: #ffb340;
  }

  [data-s="done"] .state {
    color: #6ee89a;
  }

  .task {
    color: rgb(255 255 255 / 0.8);
  }

  [data-s="ask"] .task,
  [data-s="done"] .task {
    display: none;
  }

  .ask {
    display: grid;
    gap: 8px;
  }

  .ask > b {
    font-size: 14.5px;
    line-height: 1.3;
  }

  .opts {
    display: grid;
    gap: 5px;
  }

  .opts button {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: 36px;
    padding: 0 10px;
    border: 0;
    border-radius: 9px;
    background: rgb(255 255 255 / 0.09);
    color: #fff;
    font-size: 13.5px;
    text-align: left;
    cursor: pointer;
    transition: background 0.2s;
  }

  .opts button:hover {
    background: rgb(255 255 255 / 0.16);
  }

  .opts button small {
    margin-left: auto;
    font-size: 11px;
    color: #ffb340;
  }

  .perch :global(kbd) {
    display: inline-grid;
    place-items: center;
    min-width: 20px;
    height: 20px;
    padding: 0 5px;
    border-radius: 5px;
    background: rgb(255 255 255 / 0.14);
    font: 600 11.5px var(--sans);
    color: #fff;
  }

  .sent {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    padding: 8px 10px;
    border-radius: 9px;
    background: rgb(255 255 255 / 0.08);
    overflow: hidden;
  }

  .sent > span b {
    font-weight: 600;
  }

  .sent button,
  .clear,
  .again {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 28px;
    padding: 0 10px;
    border: 0;
    border-radius: 7px;
    background: rgb(255 255 255 / 0.14);
    color: #fff;
    font-size: 12.5px;
    font-weight: 600;
    cursor: pointer;
  }

  .fuse {
    position: absolute;
    left: 0;
    bottom: 0;
    height: 2px;
    width: 100%;
    background: var(--accent);
    transform-origin: left;
    animation: fuse 2s linear forwards;
  }

  @keyframes fuse {
    from {
      transform: scaleX(1);
    }
    to {
      transform: scaleX(0);
    }
  }

  .done {
    display: grid;
    gap: 8px;
  }

  .done > b {
    font-size: 14px;
    line-height: 1.3;
  }

  .next {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    align-items: center;
  }

  .next span {
    padding: 5px 11px;
    border-radius: 999px;
    background: rgb(48 209 88 / 0.18);
    color: #8df0ad;
    font-size: 12.5px;
    font-weight: 600;
  }

  .clear {
    margin-left: auto;
  }

  .bar {
    position: absolute;
    left: 0;
    right: 0;
    bottom: 0;
    height: 2px;
    background: rgb(255 255 255 / 0.06);
  }

  .bar i {
    display: block;
    height: 100%;
    background: #6fb7ff;
    transform-origin: left;
    transform: scaleX(0);
    transition: transform 0.1s linear;
  }

  [data-s="ask"] .bar i {
    background: #ffb340;
  }

  [data-s="done"] .bar i {
    background: #30d158;
  }

  .foot {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 10px;
    padding: 8px 8px 4px;
    font-size: 12.5px;
    color: rgb(255 255 255 / 0.55);
  }

  .foot :global(kbd) {
    min-width: 18px;
    height: 18px;
    font-size: 11px;
  }

  .again {
    flex: none;
    background: var(--accent);
    color: #04140c;
  }

  @media (min-width: 735px) {
    .perch {
      padding: 28px 28px 30px 20px;
      gap: 18px;
    }

    .inbox {
      width: min(100%, 520px);
      justify-self: center;
    }
  }
</style>
