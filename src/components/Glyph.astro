---
import { glyphs, type GlyphName } from "./glyphs";

interface Props {
  name: GlyphName;
  id: string;
  grad: [string, string];
  size?: number;
  class?: string;
}

const { name, id, grad, size = 96, class: cls } = Astro.props;
---

<svg class={cls} width={size} height={size} viewBox="0 0 24 24" fill="none" aria-hidden="true">
  <defs>
    <linearGradient id={id} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color={grad[0]}></stop>
      <stop offset="1" stop-color={grad[1]}></stop>
    </linearGradient>
  </defs>
  <path d={glyphs[name]} stroke={`url(#${id})`} stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
