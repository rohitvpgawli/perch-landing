---
import type { SoonApp } from "../data/apps";
import AppIcon from "./AppIcon.astro";
import Motif from "./Motif.astro";

interface Props {
  app: SoonApp;
}

const { app } = Astro.props;
---

<a class="soon-tile dark" href={`/apps/${app.slug}`} style={`--g1:${app.grad[0]};--g2:${app.grad[1]};--accent:${app.accent}`}>
  <Motif slug={app.slug} class="motif" />
  <div class="text reveal">
    <AppIcon app={app} size={56} morph />
    <h2>{app.name}</h2>
    <p class="sub">{app.pitch}</p>
    <p class="status">{app.tag}<sup>1</sup></p>
    <span class="more">Take a peek</span>
  </div>
</a>

<style>
  .soon-tile {
    position: relative;
    display: grid;
    align-content: center;
    min-height: 520px;
    padding: 56px var(--pad);
    text-align: center;
    overflow: hidden;
    background: #000;
    isolation: isolate;
  }

  .soon-tile :global(.motif) {
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0.9;
    transition: transform 1.2s cubic-bezier(0.2, 0.8, 0.2, 1), opacity 0.6s;
  }

  .soon-tile:hover :global(.motif) {
    transform: scale(1.04);
    opacity: 1;
  }

  .text {
    position: relative;
    z-index: 1;
    display: grid;
    justify-items: center;
    gap: 6px;
  }

  .text :global(.icon) {
    margin-bottom: 14px;
    transition: transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .soon-tile:hover .text :global(.icon) {
    transform: translateY(-4px) scale(1.04);
  }

  h2 {
    font-size: clamp(36px, 6vw, 48px);
    line-height: 1.07;
    letter-spacing: -0.005em;
    color: #f5f5f7;
  }

  .sub {
    max-width: 16em;
    font-size: clamp(19px, 2.4vw, 23px);
    line-height: 1.2;
    color: rgb(255 255 255 / 0.72);
  }

  .status {
    margin-top: 6px;
    font-size: 14px;
    font-weight: 600;
    color: #ff9f5a;
  }

  .more {
    margin-top: 14px;
  }

  @media (min-width: 735px) {
    .soon-tile {
      border-radius: 28px;
    }
  }
</style>
