---
import Glyph from "./Glyph.astro";
import type { GlyphName } from "./glyphs";

interface Props {
  id: string;
  items: { title: string; body: string; icon: GlyphName }[];
  grad: [string, string];
  label: string;
}

const { id, items, grad, label } = Astro.props;
---

<div class="gallery" data-gallery>
  <ul class="track" data-track aria-label={label} tabindex="0">
    {
      items.map((it, i) => (
        <li class="card">
          <p class="copy">
            <b>{it.title}</b> {it.body}
          </p>
          <Glyph name={it.icon} id={`${id}-${i}`} grad={grad} size={120} class="glyph" />
        </li>
      ))
    }
  </ul>
  <div class="paddles content">
    <button type="button" data-dir="-1" aria-label="Previous" disabled>
      <svg viewBox="0 0 24 24" width="18" height="18"><path d="M14.5 6 8.5 12l6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>
    <button type="button" data-dir="1" aria-label="Next">
      <svg viewBox="0 0 24 24" width="18" height="18"><path d="m9.5 6 6 6-6 6" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-gallery]").forEach((g) => {
    const track = g.querySelector<HTMLElement>("[data-track]")!;
    const [prev, next] = g.querySelectorAll<HTMLButtonElement>("[data-dir]");
    const sync = () => {
      prev.disabled = track.scrollLeft < 4;
      next.disabled = track.scrollLeft + track.clientWidth > track.scrollWidth - 4;
    };
    g.querySelectorAll<HTMLButtonElement>("[data-dir]").forEach((b) =>
      b.addEventListener("click", () => {
        const card = track.firstElementChild as HTMLElement;
        track.scrollBy({ left: Number(b.dataset.dir) * (card.offsetWidth + 20), behavior: "smooth" });
      }),
    );
    track.addEventListener("scroll", sync, { passive: true });
    sync();
  });
</script>

<style>
  .track {
    --edge: max(var(--pad), calc((100vw - var(--content)) / 2));
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(82vw, 372px);
    gap: 20px;
    margin: 0;
    padding: 0 var(--edge) 4px;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--edge);
    overscroll-behavior-x: contain;
    scrollbar-width: none;
  }

  .track::-webkit-scrollbar {
    display: none;
  }

  .card {
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: clamp(400px, 60vw, 500px);
    padding: clamp(28px, 4vw, 40px);
    border-radius: 28px;
    background: var(--bg-2);
  }

  :global(.gray) .card {
    background: #fff;
  }

  :global(.dark) .card {
    background: #1d1d1f;
  }

  .copy {
    font-size: clamp(21px, 2.4vw, 24px);
    line-height: 1.17;
    font-weight: 600;
    letter-spacing: 0.009em;
    color: var(--muted);
  }

  .copy b {
    color: var(--ink);
    font-weight: 600;
  }

  :global(.dark) .copy {
    color: #86868b;
  }

  :global(.dark) .copy b {
    color: #f5f5f7;
  }

  .card :global(.glyph) {
    align-self: flex-end;
    width: clamp(96px, 26vw, 140px);
    height: auto;
  }

  .paddles {
    display: flex;
    justify-content: flex-end;
    gap: 18px;
    margin-top: 28px;
  }

  .paddles button {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 50%;
    background: rgb(210 210 215 / 0.64);
    color: rgb(0 0 0 / 0.56);
    cursor: pointer;
    transition: background 0.2s, opacity 0.2s;
  }

  .paddles button:hover:not(:disabled) {
    background: rgb(223 223 227 / 0.9);
  }

  .paddles button:disabled {
    opacity: 0.42;
    cursor: default;
  }

  :global(.dark) .paddles button {
    background: rgb(66 66 69 / 0.72);
    color: rgb(255 255 255 / 0.8);
  }
</style>
