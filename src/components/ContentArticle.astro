---
import Store from '../layouts/Store.astro';
import { perch, checkoutReady, purchaseHref } from '../data/perch';
import { collectionFor, findPage, pagePath, sectionId, markdownPath } from '../content/registry';
import { contentDate, type ContentPage } from '../content/types';
import { contentSchema } from '../content/format';
import '../styles/resources.css';
const { page } = Astro.props as { page: ContentPage };
const path = pagePath(page);
const collection = collectionFor(page.category);
const article = ['blog', 'guides', 'alternatives'].includes(page.category);
const readingMinutes = Math.max(1, Math.ceil([page.lead, ...page.sections.flatMap(s => [...s.paragraphs ?? [], ...s.steps ?? [], ...s.bullets ?? []])].join(' ').split(/\s+/).length / 200));
const labelFor = (href: string) => findPage(href)?.title ?? (href === '/privacy/' ? 'Privacy policy' : href === '/alternatives/' ? 'Compare workflows' : href);
---
<Store title={`${page.title} | Perch`} description={page.description} ogType={article ? 'article' : 'website'}>
  <Fragment slot="head">
    <link rel="alternate" type="text/markdown" href={markdownPath(path)} title="Read this page as Markdown"/>
    <link rel="alternate" type="application/rss+xml" href="/blog/rss.xml" title="Perch blog"/>
    {article && <><meta property="article:published_time" content={page.published ?? contentDate}/><meta property="article:modified_time" content={contentDate}/></>}
    <script type="application/ld+json" set:html={JSON.stringify(contentSchema(page)).replace(/</g, '\\u003c')}/>
  </Fragment>
  <article class="shell policy resource-article">
    <nav class="resource-breadcrumb" aria-label="Breadcrumb"><a href="/">Home</a><span aria-hidden="true">/</span><a href={`/${page.category}/`}>{collection.title}</a><span aria-hidden="true">/</span><span aria-current="page">{page.title}</span></nav>
    <p class="eyebrow">{collection.title}</p>
    <h1>{page.title}</h1>
    <p class="updated">{page.category === 'blog' && <>By the Perch team · </>}{page.published ? 'Published' : 'Updated'} <time datetime={page.published ?? contentDate}>October 23, 2026</time> · {readingMinutes} min read</p>
    <p class="resource-lead">{page.lead}</p>
    <nav class="short resource-toc" aria-label="On this page">
      <h2>On this page</h2><ol>{page.sections.map(section => <li><a href={`#${sectionId(section.title)}`}>{section.title}</a></li>)}{page.faqs?.length && <li><a href="#questions">Common questions</a></li>}</ol>
    </nav>
    {page.sections.map(section => <section class="resource-section" aria-labelledby={sectionId(section.title)}>
      <h2 id={sectionId(section.title)}>{section.title}</h2>
      {section.paragraphs?.map(text => <p>{text}</p>)}
      {section.steps && <ol>{section.steps.map(text => <li>{text}</li>)}</ol>}
      {section.bullets && <ul>{section.bullets.map(text => <li>{text}</li>)}</ul>}
      {section.table && <div class="resource-table" role="region" aria-label={section.table.caption} tabindex="0"><table><caption>{section.table.caption}</caption><thead><tr>{section.table.columns.map(column => <th scope="col">{column}</th>)}</tr></thead><tbody>{section.table.rows.map(row => <tr>{row.map((cell, i) => i === 0 ? <th scope="row">{cell}</th> : <td>{cell}</td>)}</tr>)}</tbody></table></div>}
      {section.links?.map(link => <p><a href={link.href}>{link.label} <span aria-hidden="true">↗</span></a></p>)}
    </section>)}
    {page.faqs?.length && <section class="resource-section" aria-labelledby="questions"><h2 id="questions">Common questions</h2><div class="faq">{page.faqs.map(item => <details><summary>{item.q}</summary><p>{item.a}</p></details>)}</div></section>}
    <aside class="resource-section resource-related" aria-labelledby="related-title"><h2 id="related-title">Keep reading</h2><ul>{page.related.map(href => <li><a href={href}>{labelFor(href)}</a></li>)}</ul></aside>
    <div class="short resource-cta"><h2>Your agents, one glance away.</h2><p>{checkoutReady ? 'Keep supported agent activity at the edge of your Mac.' : 'Perch is launching soon. Join the launch list to hear when it is ready.'}</p><div class="actions"><a class="button small" href={purchaseHref}>{checkoutReady ? 'Get Perch' : 'Get early access'}</a><a href="/#demo">Watch the demo ↗</a></div><p class="fine">{perch.requirements}</p></div>
    <p class="fine resource-formats"><a href={markdownPath(path)}>Read as Markdown</a> · <a href="/resources/content.json">Content index</a> · <a href={perch.support}>Contact support</a></p>
  </article>
</Store>
