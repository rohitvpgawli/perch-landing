---
import type { App } from "../data/apps";
import AppIcon from "./AppIcon.astro";
import { apps } from "../data/apps";

interface Props {
  app: App;
  class?: string;
}

const { app, class: cls } = Astro.props;
const s = app.slug;
const dock = ["#3d8bfd,#9fd0ff", "#1e90ff,#7fd3ff", "#34c759,#a6f0b5", "#ff375f,#ff9aa9", "#ffd60a,#fff3a6", "#1d1d1f,#5a5a5f"];
const label = {
  wisp: "A Mac desktop with Messages open. Wisp is listening under the notch and a cleaned-up reply has just landed in the compose field.",
  perch: "A Mac desktop with a terminal running Claude Code. The Perch inbox on the right shows one agent asking which layout to use and another that has finished.",
  handle: "",
  sakana: "",
}[s];
---

<div class:list={["screen", s, cls]} role="img" aria-label={label}>
  <div class="ui">
    <div class="menubar">
      <span class="mb-left">
        <b>{s === "wisp" ? "Messages" : "Terminal"}</b><span>File</span><span>Edit</span><span>View</span><span>Window</span><span>Help</span>
      </span>
      <span class="mb-right">
        <span class="mb-extra">
          {s === "wisp" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round"><path d="M5 10.5v3M8.5 8v8M12 5v14M15.5 8v8M19 10.5v3" /></svg>}
          {s === "perch" && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"><path d="M4 16.5h16" /><circle cx="10.5" cy="11.5" r="3.6" fill="currentColor" stroke="none" /></svg>}
        </span>
        <svg class="mb-ico" viewBox="0 0 24 24"><path d="M2.5 9a14 14 0 0 1 19 0M5.8 12.4a9.2 9.2 0 0 1 12.4 0M9.1 15.8a4.5 4.5 0 0 1 5.8 0" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /><circle cx="12" cy="19" r="1.4" fill="currentColor" /></svg>
        <svg class="mb-ico bat" viewBox="0 0 30 14"><rect x="1" y="1" width="24" height="12" rx="3.5" fill="none" stroke="currentColor" stroke-width="1.4" opacity=".5" /><rect x="3" y="3" width="17" height="8" rx="2" fill="currentColor" /><path d="M27 5v4" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" opacity=".5" /></svg>
        <span>Wed 9:41 AM</span>
      </span>
    </div>

    {
      s === "wisp" && (
        <>
          <div class="hud">
            <span class="wave" aria-hidden="true">
              {[0, 1, 2, 3, 4, 5, 6].map((i) => (
                <i style={`--i:${i}`} />
              ))}
            </span>
            <span class="hud-txt">um can we meet at ten thirty on friday</span>
            <kbd>fn</kbd>
          </div>

          <div class="window msgs">
            <div class="w-bar">
              <i />
              <i />
              <i />
              <span class="w-title">
                <b>Aoife Byrne</b>
                <span>iMessage</span>
              </span>
            </div>
            <div class="convos">
              {[
                ["Aoife Byrne", "Does Friday still work…", "#ff9f0a", true],
                ["Caleb", "lol no", "#30d158", false],
                ["Mum", "Did you see the video I sent?", "#bf5af2", false],
                ["Priya Nair", "Deck looks great", "#0a84ff", false],
                ["Run club", "Seawall at 7?", "#ff375f", false],
              ].map(([n, m, c, on]) => (
                <span class:list={["convo", { on }]}>
                  <i style={`background:${c}`} />
                  <span>
                    <b>{n}</b>
                    <span>{m}</span>
                  </span>
                </span>
              ))}
            </div>
            <div class="thread">
              <span class="day">Today 9:12 AM</span>
              <span class="bubble in">Hi, Aoife here from the design side. Could you send the deck before Thursday?</span>
              <span class="bubble out">Sure Aoife, sending it now.</span>
              <span class="bubble out">Also attached the icon explorations from last week.</span>
              <span class="bubble in">Perfect, thank you. Does Friday still work for the kickoff?</span>
              <span class="ts">Read 9:40 AM</span>
            </div>
            <div class="compose">
              <span class="typed">Can we meet at 10:30 AM on Friday?</span>
              <span class="land">0.7s</span>
            </div>
          </div>
        </>
      )
    }

    {
      s === "perch" && (
        <>
          <div class="window term">
            <div class="w-bar">
              <i />
              <i />
              <i />
              <span class="w-title">
                <b>claude-7</b>
                <span>~/shop/web</span>
              </span>
            </div>
            <div class="t-body">
              <span class="t-ln p">› Add a pricing page to the site</span>
              <span class="t-ln">⏺ Read src/pages/index.astro</span>
              <span class="t-ln">⏺ Read src/styles/global.css</span>
              <span class="t-ln">⏺ Read src/components/Nav.astro</span>
              <span class="t-ln">⏺ Searched for "pricing" in 14 files</span>
              <span class="t-ln">⏺ Wrote src/pages/pricing.astro</span>
              <span class="t-ln q">? Which layout should the pricing page use?</span>
              <span class="t-ln dim">
                <i>1</i> Three tiers <i>2</i> One plan <i>3</i> A table
              </span>
              <span class="t-ln cur">
                › <em />
              </span>
            </div>
          </div>

          <div class="rail">
            <i class="d blue" />
            <i class="d amber" />
            <i class="d green" />
          </div>

          <div class="inbox">
            <div class="ib-head">
              <b>Inbox</b>
              <span>1 needs you</span>
            </div>
            <div class="card ask">
              <span class="who">
                <i style="background:#d97757" />
                claude-7 <em>~/shop/web</em>
              </span>
              <b>Which layout should the pricing page use?</b>
              <span class="opts">
                <span class="opt rec">
                  <kbd>1</kbd>Three tiers<small>Recommended</small>
                </span>
                <span class="opt">
                  <kbd>2</kbd>One plan
                </span>
                <span class="opt">
                  <kbd>3</kbd>A table
                </span>
              </span>
            </div>
            <div class="card done">
              <span class="who">
                <i style="background:#10a37f" />
                codex-12 <em>~/shop/api</em>
              </span>
              <b>Added Stripe checkout. 42 tests passed.</b>
              <span class="next">
                <span>Open a PR</span>
                <span>Run it locally</span>
              </span>
            </div>
          </div>
        </>
      )
    }

    <div class="dock">
      {dock.map((g) => <i style={`background:linear-gradient(160deg,${g.split(",")[1]},${g.split(",")[0]})`} />)}
      <span class="sep" />
      {apps.map((a) => <span class:list={["d-app", { on: a.slug === s }]}><AppIcon app={a} size={40} /></span>)}
    </div>
  </div>
</div>

<style>
  .screen {
    container-type: inline-size;
    position: relative;
    aspect-ratio: 5 / 4;
    overflow: hidden;
    border-radius: 18px;
    isolation: isolate;
  }

  .ui {
    --u: 2.15cqw;
    --mb: #fff;
    position: absolute;
    inset: 0;
    font: 500 calc(var(--u) * 1.1) / 1.3 var(--sans);
    letter-spacing: 0;
    color: #1d1d1f;
    text-align: left;
  }

  @container (min-width: 620px) {
    .ui {
      --u: 1cqw;
    }
  }

  @media (min-width: 735px) {
    .screen {
      aspect-ratio: 16 / 10;
    }
  }

  .wisp {
    background:
      radial-gradient(60% 70% at 10% 100%, #bfe9ff 0%, transparent 60%),
      radial-gradient(55% 60% at 90% 10%, #7fb8ff 0%, transparent 60%),
      linear-gradient(160deg, #0b3f9e 0%, #1e74e6 40%, #58b6ff 72%, #cfeeff 100%);
  }

  .perch {
    background:
      radial-gradient(60% 70% at 15% 100%, #2fd4a7 0%, transparent 60%),
      radial-gradient(50% 60% at 90% 0%, #0f5f5a 0%, transparent 65%),
      linear-gradient(160deg, #06201f 0%, #0c3d3a 45%, #138a6e 80%, #4fd9b0 100%);
  }

  /* Menu bar */
  .menubar {
    position: absolute;
    inset: 0 0 auto;
    height: calc(var(--u) * 2.4);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0 calc(var(--u) * 1.2);
    color: var(--mb);
    background: rgb(255 255 255 / 0.12);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    font-size: calc(var(--u) * 1.1);
    white-space: nowrap;
  }

  .mb-left,
  .mb-right {
    display: flex;
    align-items: center;
    gap: calc(var(--u) * 1.6);
  }

  .mb-left {
    overflow: hidden;
  }

  .mb-right {
    flex: none;
    gap: calc(var(--u) * 1.3);
  }

  .mb-extra {
    display: grid;
    place-items: center;
    height: calc(var(--u) * 1.8);
    min-width: calc(var(--u) * 2.4);
    padding: 0 calc(var(--u) * 0.5);
    border-radius: calc(var(--u) * 0.4);
    background: rgb(255 255 255 / 0.25);
  }

  .mb-extra svg,
  .mb-ico {
    width: calc(var(--u) * 1.3);
    height: calc(var(--u) * 1.3);
  }

  .bat {
    width: calc(var(--u) * 2.2);
  }

  /* Windows */
  .window {
    position: absolute;
    display: grid;
    grid-template-rows: auto 1fr auto;
    border-radius: calc(var(--u) * 1.1);
    overflow: hidden;
    box-shadow:
      0 0 0 0.5px rgb(0 0 0 / 0.3),
      0 calc(var(--u) * 2) calc(var(--u) * 5) rgb(0 0 0 / 0.35);
  }

  .w-bar {
    display: flex;
    align-items: center;
    gap: calc(var(--u) * 0.6);
    padding: calc(var(--u) * 1) calc(var(--u) * 1.1);
  }

  .w-bar i {
    width: calc(var(--u) * 1.05);
    height: calc(var(--u) * 1.05);
    border-radius: 50%;
    background: #ff5f57;
  }

  .w-bar i:nth-child(2) {
    background: #febc2e;
  }

  .w-bar i:nth-child(3) {
    background: #28c840;
  }

  .w-title {
    margin-left: calc(var(--u) * 0.8);
    display: flex;
    gap: calc(var(--u) * 0.7);
    align-items: baseline;
    font-size: calc(var(--u) * 1.05);
  }

  .w-title span {
    opacity: 0.55;
  }

  /* Wisp: HUD under the notch */
  .hud {
    position: absolute;
    top: calc(var(--u) * 3.2);
    left: 50%;
    transform: translateX(-50%);
    display: flex;
    align-items: center;
    gap: calc(var(--u) * 1);
    padding: calc(var(--u) * 0.7) calc(var(--u) * 0.9) calc(var(--u) * 0.7) calc(var(--u) * 1.2);
    border-radius: 999px;
    background: rgb(20 20 24 / 0.86);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    color: #fff;
    box-shadow: 0 calc(var(--u) * 1) calc(var(--u) * 3) rgb(0 0 0 / 0.35);
    z-index: 3;
    white-space: nowrap;
    animation: hud-in 7s ease-in-out infinite;
  }

  .wave {
    display: flex;
    align-items: center;
    gap: calc(var(--u) * 0.28);
    height: calc(var(--u) * 1.6);
  }

  .wave i {
    width: calc(var(--u) * 0.32);
    height: 100%;
    border-radius: 999px;
    background: #5ac8fa;
    transform-origin: center;
    animation: bar 0.9s ease-in-out calc(var(--i) * -0.12s) infinite alternate;
  }

  @keyframes bar {
    from {
      transform: scaleY(0.2);
    }
    to {
      transform: scaleY(1);
    }
  }

  .hud-txt {
    font-size: calc(var(--u) * 1.05);
    color: rgb(255 255 255 / 0.85);
    overflow: hidden;
    max-width: calc(var(--u) * 24);
    animation: reveal 7s steps(32) infinite;
  }

  @keyframes reveal {
    0%,
    8% {
      max-width: 0;
    }
    55%,
    100% {
      max-width: calc(var(--u) * 24);
    }
  }

  @keyframes hud-in {
    0%,
    4% {
      opacity: 0;
      transform: translate(-50%, calc(var(--u) * -1));
    }
    10%,
    62% {
      opacity: 1;
      transform: translate(-50%, 0);
    }
    70%,
    100% {
      opacity: 0;
      transform: translate(-50%, calc(var(--u) * -1));
    }
  }

  .hud kbd {
    font: 600 calc(var(--u) * 0.85) var(--sans);
    padding: 0.15em 0.55em;
    border-radius: 0.45em;
    background: rgb(255 255 255 / 0.14);
    color: rgb(255 255 255 / 0.8);
  }

  .msgs {
    left: 11%;
    right: 11%;
    top: calc(var(--u) * 9.5);
    bottom: calc(var(--u) * 7);
    grid-template-columns: 30% 1fr;
    grid-template-rows: auto 1fr auto;
    background: #fff;
    color: #1d1d1f;
  }

  .msgs .w-bar {
    grid-column: 1 / -1;
  }

  .convos {
    grid-row: 2 / 4;
    display: grid;
    align-content: start;
    gap: calc(var(--u) * 0.3);
    padding: calc(var(--u) * 0.8);
    background: #f6f6f8;
    border-right: 0.5px solid rgb(0 0 0 / 0.08);
    overflow: hidden;
  }

  .convo {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: center;
    gap: calc(var(--u) * 0.7);
    padding: calc(var(--u) * 0.6) calc(var(--u) * 0.7);
    border-radius: calc(var(--u) * 0.7);
    font-size: calc(var(--u) * 0.95);
    line-height: 1.25;
  }

  .convo.on {
    background: #0a84ff;
    color: #fff;
  }

  .convo > i {
    width: calc(var(--u) * 2.2);
    height: calc(var(--u) * 2.2);
    border-radius: 50%;
  }

  .convo > span {
    display: grid;
    min-width: 0;
  }

  .convo > span span {
    color: #86868b;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    font-size: calc(var(--u) * 0.85);
  }

  .convo.on > span span {
    color: rgb(255 255 255 / 0.8);
  }

  .day {
    justify-self: center;
    font-size: calc(var(--u) * 0.85);
    color: #86868b;
    margin-bottom: calc(var(--u) * 0.4);
  }

  .msgs .w-bar {
    border-bottom: 0.5px solid rgb(0 0 0 / 0.1);
    background: #f6f6f8;
  }

  .thread {
    display: grid;
    align-content: end;
    min-height: 0;
    overflow: hidden;
    gap: calc(var(--u) * 0.6);
    padding: calc(var(--u) * 1.4) calc(var(--u) * 1.6);
    font-size: calc(var(--u) * 1.15);
    line-height: 1.3;
  }

  .bubble {
    max-width: 68%;
    padding: calc(var(--u) * 0.7) calc(var(--u) * 1.1);
    border-radius: calc(var(--u) * 1.4);
  }

  .bubble.in {
    justify-self: start;
    background: #e9e9eb;
    border-bottom-left-radius: calc(var(--u) * 0.4);
  }

  .bubble.out {
    justify-self: end;
    background: #0a84ff;
    color: #fff;
    border-bottom-right-radius: calc(var(--u) * 0.4);
  }

  .ts {
    justify-self: end;
    font-size: calc(var(--u) * 0.85);
    color: #86868b;
  }

  .compose {
    display: flex;
    align-items: center;
    gap: calc(var(--u) * 1);
    margin: 0 calc(var(--u) * 1.6) calc(var(--u) * 1.4);
    padding: calc(var(--u) * 0.7) calc(var(--u) * 1.2);
    border-radius: 999px;
    border: 0.5px solid rgb(0 0 0 / 0.18);
    font-size: calc(var(--u) * 1.15);
    min-height: calc(var(--u) * 3);
  }

  .typed {
    white-space: nowrap;
    overflow: hidden;
    animation: typed 7s steps(36) infinite;
    border-right: 1.5px solid #0a84ff;
  }

  @keyframes typed {
    0%,
    62% {
      max-width: 0;
      border-color: transparent;
    }
    64% {
      border-color: #0a84ff;
    }
    78%,
    100% {
      max-width: 100%;
      border-color: #0a84ff;
    }
  }

  .land {
    margin-left: auto;
    flex: none;
    font-size: calc(var(--u) * 0.85);
    font-weight: 600;
    color: #0a84ff;
    opacity: 0;
    animation: land 7s ease infinite;
  }

  @keyframes land {
    0%,
    76% {
      opacity: 0;
    }
    80%,
    94% {
      opacity: 1;
    }
    100% {
      opacity: 0;
    }
  }

  /* Perch */
  .term {
    left: 6%;
    width: 48%;
    top: calc(var(--u) * 6);
    height: 52%;
    background: #15171c;
    color: #e6e6e6;
  }

  .term .w-title {
    color: #fff;
  }

  .t-body {
    display: grid;
    align-content: start;
    gap: calc(var(--u) * 0.9);
    padding: calc(var(--u) * 0.6) calc(var(--u) * 1.6);
    font: 500 calc(var(--u) * 1.05) / 1.35 var(--mono);
  }

  .t-ln.p {
    color: #fff;
  }

  .t-ln.q {
    color: #ffb340;
  }

  .t-ln.dim {
    color: rgb(255 255 255 / 0.55);
    display: flex;
    gap: calc(var(--u) * 0.6);
    align-items: center;
    flex-wrap: wrap;
  }

  .t-ln.dim i {
    font-style: normal;
    display: inline-grid;
    place-items: center;
    width: calc(var(--u) * 1.5);
    height: calc(var(--u) * 1.5);
    border-radius: calc(var(--u) * 0.35);
    background: rgb(255 255 255 / 0.12);
    color: #fff;
  }

  .t-ln.dim i:not(:first-child) {
    margin-left: calc(var(--u) * 0.6);
  }

  .t-ln.cur em {
    display: inline-block;
    width: calc(var(--u) * 0.7);
    height: calc(var(--u) * 1.2);
    background: #fff;
    vertical-align: text-bottom;
    animation: blink 1.1s steps(1) infinite;
  }

  @keyframes blink {
    50% {
      opacity: 0;
    }
  }

  .rail {
    position: absolute;
    right: calc(var(--u) * 1.2);
    top: calc(var(--u) * 5);
    display: grid;
    gap: calc(var(--u) * 0.9);
    padding: calc(var(--u) * 0.8) calc(var(--u) * 0.6);
    border-radius: 999px;
    background: rgb(0 0 0 / 0.45);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: inset 0 0 0 0.5px rgb(255 255 255 / 0.18);
    z-index: 4;
  }

  .d {
    width: calc(var(--u) * 1);
    height: calc(var(--u) * 1);
    border-radius: 50%;
  }

  .d.blue {
    background: #0a84ff;
    animation: pulse 1.6s ease-in-out infinite;
  }

  .d.amber {
    background: #ff9f0a;
    box-shadow: 0 0 0 calc(var(--u) * 0.25) rgb(255 159 10 / 0.3);
  }

  .d.green {
    background: #30d158;
  }

  @keyframes pulse {
    50% {
      opacity: 0.4;
    }
  }

  .inbox {
    position: absolute;
    right: calc(var(--u) * 5);
    top: calc(var(--u) * 4);
    width: calc(var(--u) * 34);
    display: grid;
    gap: calc(var(--u) * 0.8);
    padding: calc(var(--u) * 1);
    border-radius: calc(var(--u) * 1.6);
    background: rgb(28 30 34 / 0.78);
    backdrop-filter: blur(30px) saturate(1.5);
    -webkit-backdrop-filter: blur(30px) saturate(1.5);
    box-shadow:
      inset 0 0 0 0.5px rgb(255 255 255 / 0.14),
      0 calc(var(--u) * 2) calc(var(--u) * 5) rgb(0 0 0 / 0.4);
    color: #fff;
    z-index: 3;
  }

  .ib-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: calc(var(--u) * 0.4) calc(var(--u) * 0.6) calc(var(--u) * 0.2);
    font-size: calc(var(--u) * 1.25);
  }

  .ib-head span {
    font-size: calc(var(--u) * 1);
    color: #ffb340;
  }

  .card {
    display: grid;
    gap: calc(var(--u) * 0.7);
    padding: calc(var(--u) * 1) calc(var(--u) * 1.1);
    border-radius: calc(var(--u) * 1.1);
    background: rgb(255 255 255 / 0.07);
    font-size: calc(var(--u) * 1.1);
  }

  .card.ask {
    background: rgb(255 159 10 / 0.14);
    box-shadow: inset 0 0 0 0.5px rgb(255 159 10 / 0.35);
  }

  .who {
    display: flex;
    align-items: center;
    gap: calc(var(--u) * 0.6);
    font-size: calc(var(--u) * 0.95);
    color: rgb(255 255 255 / 0.7);
  }

  .who i {
    width: calc(var(--u) * 1.4);
    height: calc(var(--u) * 1.4);
    border-radius: calc(var(--u) * 0.4);
  }

  .who em {
    font-style: normal;
    opacity: 0.6;
  }

  .card b {
    font-size: calc(var(--u) * 1.2);
    line-height: 1.25;
  }

  .opts {
    display: grid;
    gap: calc(var(--u) * 0.45);
  }

  .opt {
    display: flex;
    align-items: center;
    gap: calc(var(--u) * 0.8);
