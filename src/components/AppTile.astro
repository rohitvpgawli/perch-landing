---
import type { ReadyApp } from "../data/apps";
import AppIcon from "./AppIcon.astro";
import Screen from "./Screen.astro";

interface Props {
  app: ReadyApp;
  tone?: "light" | "gray" | "dark";
}

const { app, tone = "light" } = Astro.props;
---

<section class:list={["tile", tone, { dark: tone === "dark" }]} style={`--g1:${app.grad[0]};--g2:${app.grad[1]};--accent:${app.accent}`}>
  <div class="text reveal">
    <AppIcon app={app} size={64} morph />
    <h2>{app.name}</h2>
    <p class="sub">{app.tagline}</p>
    <p class="status tag">{app.status}<sup>1</sup></p>
    <div class="ctas">
      <a class="btn" href={`/apps/${app.slug}`}>Learn more</a>
      <a class="btn secondary" href={`/apps/${app.slug}#get`}>{app.cta}</a>
    </div>
  </div>
  <div class="media">
    <Screen app={app} class="grow" />
  </div>
</section>

<style>
  .tile {
    display: grid;
    align-content: start;
    gap: 32px;
    padding: 48px var(--pad) 44px;
    text-align: center;
    overflow: hidden;
    border-radius: 0;
  }

  .light {
    background: #fff;
  }

  .gray {
    background: var(--bg-2);
  }

  .text {
    display: grid;
    justify-items: center;
    gap: 6px;
  }

  .text :global(.icon) {
    margin-bottom: 12px;
  }

  h2 {
    font-size: clamp(40px, 7vw, 56px);
    line-height: 1.07;
    letter-spacing: -0.005em;
  }

  .sub {
    max-width: 20em;
  }

  .status {
    font-size: 14px;
    margin-top: 4px;
  }

  .ctas {
    margin-top: 14px;
  }

  .media {
    width: 100%;
    max-width: 980px;
    margin-inline: auto;
  }

  .dark .sub {
    color: #f5f5f7;
  }

  .dark .status {
    color: #ff9f5a;
  }

  .media :global(.screen) {
    box-shadow: 0 30px 60px -30px rgb(0 0 0 / 0.35);
  }

  @media (min-width: 735px) {
    .tile {
      padding-top: 60px;
      border-radius: 28px;
    }
  }
</style>
