---
import AppIcon from "../AppIcon.astro";
import { apps, type Slug } from "../../data/apps";

interface Msg {
  side: "in" | "out";
  label: string;
  text: string;
}

interface Scene {
  slug: Slug;
  tab: string;
  window: string;
  msgs: Msg[];
  note: string;
  toast: { title: string; meta: string };
}

const soonLine = (slug: Slug) => {
  const a = apps.find((x) => x.slug === slug);
  return a && a.kind === "soon" ? a : null;
};
const handle = soonLine("handle")!;
const sakana = soonLine("sakana")!;

const scenes: Scene[] = [
  {
    slug: "wisp",
    tab: "Type by talking",
    window: "Mail",
    msgs: [
      { side: "out", label: "You said", text: "um so can we like push the kickoff to ten thirty friday" },
      { side: "in", label: "Wisp typed", text: "Can we push the kickoff to 10:30 AM on Friday?" },
    ],
    note: "Typed into Mail",
    toast: { title: "Text landed", meta: "0.7s · never left your Mac" },
  },
  {
    slug: "perch",
    tab: "Answer your agents",
    window: "Perch",
    msgs: [
      { side: "in", label: "claude-7 asks", text: "Which layout should the pricing page use? 1 Three tiers, 2 One plan, 3 A table" },
      { side: "out", label: "You pressed 1", text: "Three tiers." },
    ],
    note: "Sent to claude-7",
    toast: { title: "Agent unblocked", meta: "~/shop/web · now" },
  },
  {
    slug: "handle",
    tab: "Coming soon",
    window: "Handle",
    msgs: [
      { side: "out", label: "You", text: "What is it?" },
      { side: "in", label: "Handle", text: handle.whispers[0] },
    ],
    note: handle.whispers[1],
    toast: { title: "Handle", meta: `Coming ${handle.eta}` },
  },
  {
    slug: "sakana",
    tab: "Still a secret",
    window: "Sakana",
    msgs: [
      { side: "out", label: "You", text: "Any hints?" },
      { side: "in", label: "Sakana", text: sakana.whispers[0] },
    ],
    note: sakana.whispers[1],
    toast: { title: "Sakana", meta: `Coming ${sakana.eta}` },
  },
];

const appOf = (s: Slug) => apps.find((a) => a.slug === s)!;
---

<div class="showcase" data-showcase>
  <div class="tabs" role="tablist" aria-label="What the apps do">
    {
      scenes.map((s, i) => (
        <button
          role="tab"
          class="tab"
          id={`sc-tab-${s.slug}`}
          aria-controls={`sc-${s.slug}`}
          aria-selected={i === 0 ? "true" : "false"}
          tabindex={i === 0 ? 0 : -1}
          data-i={i}
        >
          <AppIcon app={appOf(s.slug)} size={34} reveal />
          <span>{s.tab}</span>
        </button>
      ))
    }
  </div>

  <div class="device">
    <div class="bar">
      <i></i><i></i><i></i>
      <span class="title" data-title>{scenes[0].window}</span>
      <span class="clock">9:41</span>
    </div>
    <div class="screen">
      {
        scenes.map((s, i) => (
          <div
            class:list={["scene", { on: i === 0 }]}
            id={`sc-${s.slug}`}
            role="tabpanel"
            aria-labelledby={`sc-tab-${s.slug}`}
            data-window={s.window}
            hidden={i !== 0}
          >
            {s.msgs.map((m, j) => (
              <p class:list={["msg", m.side]} style={`--d:${200 + j * 650}ms`}>
                <small>{m.label}</small>
                {m.text}
              </p>
            ))}
            <p class="note" style={`--d:${200 + s.msgs.length * 650}ms`}>
              <svg viewBox="0 0 16 16"><path d="M3.5 8.5 6.5 11.5 12.5 4.5" /></svg>
              {s.note}
            </p>
            <div class="toast" style={`--d:${600 + s.msgs.length * 650}ms`}>
              <AppIcon app={appOf(s.slug)} size={40} reveal />
              <span>
                <b>{s.toast.title}</b>
                <em>now</em>
                <span>{s.toast.meta}</span>
              </span>
            </div>
          </div>
        ))
      }
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>("[data-showcase]").forEach((root) => {
    const strip = root.querySelector<HTMLElement>(".tabs")!;
    const tabs = [...strip.querySelectorAll<HTMLButtonElement>(".tab")];
    const scenes = [...root.querySelectorAll<HTMLElement>(".scene")];
    const title = root.querySelector<HTMLElement>("[data-title]")!;
    const still = matchMedia("(prefers-reduced-motion: reduce)").matches;
    let cur = 0;
    let timer = 0;
    let visible = false;
    let pausedUntil = 0;

    const show = (i: number, focus = false) => {
      cur = (i + scenes.length) % scenes.length;
      tabs.forEach((t, j) => {
        const on = j === cur;
        t.setAttribute("aria-selected", String(on));
        t.tabIndex = on ? 0 : -1;
        if (on) {
          strip.scrollTo({ left: t.offsetLeft - (strip.clientWidth - t.offsetWidth) / 2, behavior: still ? "auto" : "smooth" });
          if (focus) t.focus({ preventScroll: true });
        }
      });
      scenes.forEach((s, j) => {
        s.classList.remove("on");
        s.hidden = j !== cur;
      });
      title.textContent = scenes[cur].dataset.window ?? "";
      requestAnimationFrame(() => requestAnimationFrame(() => scenes[cur].classList.add("on")));
    };

    const tick = () => {
      window.clearTimeout(timer);
      if (still) return;
      timer = window.setTimeout(() => {
        if (visible && Date.now() > pausedUntil) show(cur + 1);
        tick();
      }, 5200);
    };

    tabs.forEach((t, i) =>
      t.addEventListener("click", () => {
        pausedUntil = Date.now() + 14000;
        show(i);
      }),
    );

    strip.addEventListener("keydown", (e) => {
      const k = (e as KeyboardEvent).key;
      if (k !== "ArrowRight" && k !== "ArrowLeft") return;
      e.preventDefault();
      pausedUntil = Date.now() + 14000;
      show(cur + (k === "ArrowRight" ? 1 : -1), true);
    });

    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
    }).observe(root);

    tick();
  });
</script>

<style>
  .showcase {
    display: grid;
    justify-items: center;
    gap: clamp(36px, 6vw, 56px);
  }

  .tabs {
    position: relative;
    display: flex;
    gap: 8px;
    max-width: 100%;
    padding: 6px;
    overflow-x: auto;
    scrollbar-width: none;
    scroll-snap-type: x proximity;
    -webkit-mask: linear-gradient(90deg, transparent, #000 24px, #000 calc(100% - 24px), transparent);
    mask: linear-gradient(90deg, transparent, #000 24px, #000 calc(100% - 24px), transparent);
    padding-inline: 24px;
  }

  .tabs::-webkit-scrollbar {
    display: none;
  }

  .tab {
    flex: none;
    display: inline-flex;
    align-items: center;
    gap: 14px;
    padding: 9px 22px 9px 9px;
    border-radius: 999px;
    font-size: clamp(16px, 1.6vw, 19px);
    font-weight: 600;
    color: var(--faint);
    scroll-snap-align: center;
    transition:
      color 0.3s,
      background-color 0.3s,
      box-shadow 0.3s;
  }

  .tab :global(.icon) {
    filter: grayscale(1) contrast(0.6) brightness(1.25);
    opacity: 0.7;
    transition:
      filter 0.3s,
      opacity 0.3s;
  }

  .tab:hover {
    color: var(--muted);
  }

  .tab[aria-selected="true"] {
    color: var(--ink);
    background: linear-gradient(180deg, #fff, #f1f2f6);
    box-shadow:
      inset 0 0 0 1px rgb(0 0 0 / 0.05),
      0 10px 30px -14px rgb(30 40 80 / 0.35);
  }

  .tab[aria-selected="true"] :global(.icon) {
    filter: none;
    opacity: 1;
  }

  .device {
    width: min(100%, 520px);
    border-radius: 30px;
    padding: 8px;
    background: linear-gradient(160deg, #d9dade, #a9abb1 40%, #e3e4e7 70%, #9c9ea4);
    box-shadow:
      0 1px 0 rgb(255 255 255 / 0.6) inset,
      0 40px 80px -40px rgb(20 30 60 / 0.45);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 7px;
    height: 46px;
    padding: 0 18px;
    border-radius: 23px 23px 0 0;
    background: #fbfbfa;
    border-bottom: 1px solid rgb(0 0 0 / 0.06);
    font-size: 14px;
    font-weight: 600;
  }

  .bar i {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: #ff5f57;
  }

  .bar i:nth-child(2) {
    background: #febc2e;
  }

  .bar i:nth-child(3) {
    background: #28c840;
  }

  .title {
    margin-left: 10px;
  }

  .clock {
    margin-left: auto;
    color: var(--faint);
    font-variant-numeric: tabular-nums;
  }

  .screen {
    position: relative;
    height: clamp(380px, 48vw, 420px);
    border-radius: 0 0 23px 23px;
    background: #fff;
    overflow: hidden;
  }

  .scene {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: 28px 22px;
  }

  .msg {
    max-width: 78%;
    padding: 14px 20px;
    border-radius: 22px;
    font-size: clamp(16px, 1.7vw, 18px);
    line-height: 1.4;
    letter-spacing: -0.005em;
  }

  .msg small {
    display: block;
    margin-bottom: 3px;
    font-size: 12px;
    font-weight: 600;
    color: var(--faint);
    letter-spacing: 0;
  }

  .msg.out {
    align-self: flex-end;
    background: #fff;
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.1);
    color: var(--muted);
  }

  .msg.in {
    align-self: flex-start;
    background: #f1f0ec;
    color: var(--ink);
  }

  .note {
    display: flex;
    align-items: center;
    gap: 6px;
    padding-left: 10px;
    font-size: 13px;
    font-weight: 500;
    color: var(--faint);
  }

  .note svg {
    width: 14px;
    height: 14px;
    fill: none;
    stroke: #30a46c;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .toast {
    margin-top: auto;
    display: flex;
    align-items: center;
    gap: 14px;
    padding: 14px 16px;
    border-radius: 22px;
    background: rgb(250 250 248 / 0.92);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    box-shadow:
      inset 0 0 0 1px rgb(0 0 0 / 0.06),
      0 18px 40px -18px rgb(0 0 0 / 0.35);
  }

  .toast > span {
    display: grid;
    grid-template-columns: 1fr auto;
    flex: 1;
    min-width: 0;
    font-size: 15px;
    line-height: 1.3;
  }

  .toast b {
    font-weight: 600;
  }

  .toast em {
    font-style: normal;
    font-size: 13px;
    color: var(--faint);
  }

  .toast span span {
    grid-column: 1 / -1;
    color: var(--muted);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .scene > * {
    opacity: 0;
    transform: translateY(14px) scale(0.98);
    transition:
      opacity 0.5s ease,
      transform 0.6s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .scene.on > * {
    opacity: 1;
    transform: none;
    transition-delay: var(--d);
  }

  .scene > .toast {
    transform: translateY(40px);
  }

  .scene.on > .toast {
    transform: none;
  }
</style>
