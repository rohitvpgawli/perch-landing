---
import { Picture } from "astro:assets";
import Warm from "../../layouts/Warm.astro";
import HeroSky from "../../components/v2/HeroSky.astro";
import Showcase from "../../components/v2/Showcase.astro";
import AppIcon from "../../components/AppIcon.astro";
import Glyph from "../../components/Glyph.astro";
import { glyphs, type GlyphName } from "../../components/glyphs";
import WinnerCard from "../../components/v2/WinnerCard.astro";
import { apps, ready, soon, type Slug } from "../../data/apps";
import { site } from "../../data/site";
import portrait from "../../assets/riley-desk.jpg";

const [wisp, perch] = ready;
const app = (s: Slug) => apps.find((a) => a.slug === s)!;
const wispLife = wisp.pricing.plans[0];
const perchLife = perch.pricing.plans.find((p) => p.name === "Lifetime")!;

const winners = [
  {
    app: wisp,
    hook: "Still typing every Slack reply?",
    us: ["Hold a key. Finished text.", "100% on your Mac", `Pay once · ${wispLife.price}`],
    them: { name: "Cloud dictation", cons: ["Monthly subscription", "Uploads your voice", "Needs an account"] },
    risk: "7 days free · 30-day refund",
    cta: wispLife.cta,
  },
  {
    app: perch,
    hook: "Waiting on three agents at once?",
    us: ["One inbox for every agent", "Answer in a keystroke", `Lifetime · ${perchLife.price}`],
    them: { name: "Alt-tabbing terminals", cons: ["Questions get buried", "Agents sit idle", "No single overview"] },
    risk: "Free forever · upgrade once",
    cta: perchLife.cta,
  },
] as const;

const rotating = ["Type by talking", "Answer your agents", "100% on your Mac", "Pay once"];

const nav = [
  { label: "How it works", href: "#how" },
  { label: "Privacy", href: "#privacy" },
  { label: "Apps", href: "#apps" },
  { label: "Pricing", href: "#pricing" },
  { label: "FAQs", href: "#faqs" },
];

const days: { label: string; glyph: GlyphName; slug: Slug }[] = [
  { label: "Long emails", glyph: "tone", slug: "wisp" },
  { label: "Code review", glyph: "inbox", slug: "perch" },
  { label: "Slack replies", glyph: "apps", slug: "wisp" },
  { label: "Late deploys", glyph: "server", slug: "perch" },
  { label: "Agent briefs", glyph: "terminal", slug: "wisp" },
  { label: "On the train", glyph: "phone", slug: "perch" },
  { label: "Morning pages", glyph: "book", slug: "wisp" },
  { label: "Writing in French", glyph: "globe", slug: "wisp" },
];

const proof = [
  { value: "100%", label: "on your Mac" },
  { value: "0", label: "bytes sent to us" },
  { value: "0", label: "trackers or analytics" },
  { value: "0", label: "accounts to make" },
];

const layers: { title: string; body: string; glyph: GlyphName; grad: [string, string] }[] = [
  {
    title: "Apple's dictation models",
    body: "Speech turns into text on your Mac's Neural Engine, with the same on-device models macOS uses for dictation.",
    glyph: "mic",
    grad: ["#5ac8fa", "#0a84ff"],
  },
  {
    title: "Apple Intelligence",
    body: "Cleanup, tone and Perch's router run on Apple's on-device model. Never a cloud model, ours or anyone's.",
    glyph: "sparkle",
    grad: ["#bf5af2", "#ff6482"],
  },
  {
    title: "Nothing tracked",
    body: "No analytics, no crash reporter, no ad IDs, no account. We genuinely don't know who you are.",
    glyph: "lock",
    grad: ["#30d158", "#00c7be"],
  },
];

const nopes = ["$12 a month", "Sign in with Google", "Upload to our cloud", "Usage analytics"];

const included = [
  "No account",
  "Works offline",
  "Apple Intelligence",
  "Nothing tracked",
  "Up to 2 Macs",
  "No subscriptions, ever",
  "30-day refund",
  "A person on email",
];

const routes = [
  { ask: "Ship the fix", to: "codex-12", where: "~/shop/api", reply: "Opened a pull request. Checks are running." },
  { ask: "Run the tests", to: "claude-7", where: "~/shop/web", reply: "142 passed, 0 failed, in 38 seconds." },
  { ask: "What's blocking?", to: "Perch", where: "3 agents", reply: "claude-7 needs a layout choice. Everything else is moving." },
  { ask: "Pause the deploy", to: "codex-12", where: "prod-1", reply: "Paused at step 3 of 5. Say resume when you're ready." },
  { ask: "Summarize today", to: "Perch", where: "since 9 AM", reply: "Nine jobs done, two waiting on you, nothing stuck." },
];

const starts = [
  {
    n: "01",
    kicker: "Free for 7 days",
    title: "Try Wisp",
    body: "Every feature, every language. No card and nothing to sign in to.",
    href: "/apps/wisp#get",
  },
  {
    n: "02",
    kicker: "Free forever",
    title: "Start on Perch Free",
    body: "The Inbox, the Toolbar, and 25 routed requests a day.",
    href: "/apps/perch#get",
  },
];

const works: { title: string; body: string; meta: string; glyph: GlyphName; grad: [string, string] }[] = [
  {
    title: "Your Mac",
    body: "Drag it to Applications and it's working. No installer, no sign-up screen.",
    meta: "macOS 26+ · Apple Intelligence on",
    glyph: "keyboard",
    grad: wisp.grad,
  },
  {
    title: "Your iPhone",
    body: "Scan a code in Perch and agent questions follow you out the door.",
    meta: "iOS 17+ · about 30 seconds",
    glyph: "phone",
    grad: perch.grad,
  },
  {
    title: "Your servers",
    body: "Paste one command on a Linux box and its agents join the same Inbox.",
    meta: "End-to-end encrypted · no open port",
    glyph: "server",
    grad: ["#5e5ce6", "#64d2ff"],
  },
];

const faqs = [
  {
    q: `What is ${site.studio}?`,
    a: "A one-person studio in Vancouver making small Mac apps for the frictions of an ordinary workday. Wisp and Perch are out. Handle and Sakana are close.",
  },
  { q: "Do I need an account?", a: "No. Neither app asks who you are. Wisp is a key you buy once. Perch Free needs nothing at all." },
  {
    q: "Does anything leave my Mac?",
    a: "No. Both apps run on Apple's on-device dictation and Apple Intelligence models, on your Mac's own chip. There are no analytics, no trackers and no server of ours. The only request either app makes on its own is an update check, and you can turn it off.",
  },
  wisp.faq.find((f) => f.q.startsWith("Which AI"))!,
  wisp.faq.find((f) => f.q.startsWith("Is my voice"))!,
  perch.faq.find((f) => f.q.startsWith("Is Perch another"))!,
  {
    q: "Is anything a subscription?",
    a: `No, and it never will be. Wisp Lifetime is ${wispLife.price} once. Perch is free, or ${perchLife.price} once for Lifetime. Nothing renews, ever.`,
  },
  { q: "Which Macs does it work on?", a: "Any Apple silicon Mac on macOS 26 Tahoe or later, with Apple Intelligence turned on. Perch's iPhone app needs iOS 17." },
  wisp.faq.find((f) => f.q.startsWith("What if"))!,
];

const askPrompt = encodeURIComponent(`Tell me about ${site.studio}'s Mac apps, Wisp and Perch, at ${Astro.site?.host ?? "rileygallagher.com"}.`);

const arrow = '<svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M10 3.5v12M4.5 10.5 10 16l5.5-5.5"/></svg>';
---

<Warm>
  <div class="announce" data-announce>
    <a href="#pricing">
      <i class="hot" />
      <b>Wisp Lifetime for {wispLife.price}.</b>
      <span>Perch Lifetime for {perchLife.price} →</span>
    </a>
    <button aria-label="Dismiss announcement" data-dismiss>
      <svg viewBox="0 0 16 16"><path d="M4 4l8 8M12 4l-8 8" /></svg>
    </button>
  </div>

  <header class="float-nav" data-float>
    <a class="logo" href="/v2">{site.studio}</a>
    <nav aria-label="Main">
      {nav.map((n) => <a href={n.href}>{n.label}</a>)}
    </nav>
    <a class="pill-btn small" href="#apps">Get the apps</a>
  </header>

  <main id="main">
    <section class="hero" data-hero>
      <HeroSky banner="Wisp & Perch are out!" />
      <div class="hero-nav">
        <a class="logo" href="/v2">{site.studio}</a>
        <nav aria-label="Hero">
          {nav.map((n) => <a href={n.href}>{n.label}</a>)}
        </nav>
      </div>
      <div class="hero-copy">
        <p class="rot" aria-live="off">
          {rotating.map((w, i) => <span class:list={{ on: i === 0 }}>{w}</span>)}
        </p>
        <h1>Made for the Mac.<br />Made to disappear.</h1>
        <p class="hero-sub">Four small apps. Two out today. 100% on your Mac.</p>
        <a class="glass" href="#apps">Get the apps <Fragment set:html={arrow} /></a>
      </div>
    </section>

    <section id="how" class="block how">
      <div class="wrap center">
        <h2 class="h2 rv">Your Mac turns talk into text, and questions into answers.</h2>
        <p class="lede rv" style="--d:80ms">forget the subscriptions.</p>
      </div>
      <div class="wrap rv" style="--d:160ms">
        <Showcase />
      </div>
      <div class="wrap center try rv">
        <p class="mono">try it in your browser · no install</p>
        <div class="try-links">
          <a href="/apps/wisp#try">Wisp demo</a>
          <a href="/apps/perch#try">Perch demo</a>
        </div>
      </div>
    </section>

    <section id="privacy" class="private">
      <div class="private-in">
        <div class="wrap center">
          <p class="mono rv">runs on apple intelligence · on your mac</p>
          <h2 class="h2 rv" style="--d:60ms">100% private.<br /><span class="ai">Just how Apple would make it.</span></h2>
          <p class="lede rv" style="--d:120ms">
            Your voice becomes text on Apple's own dictation models. Cleanup, tone and routing run on Apple Intelligence. All of it happens on your Mac's
            chip, and none of it is tracked or sent anywhere.
          </p>
        </div>

        <ul class="wrap zeros">
          {
            proof.map((p, i) => (
              <li class="rv" style={`--d:${i * 70}ms`}>
                <b>{p.value}</b>
                <span>{p.label}</span>
              </li>
            ))
          }
        </ul>

        <ul class="wrap layers">
          {
            layers.map((l, i) => (
              <li class="rv" style={`--d:${i * 90}ms`}>
                <Glyph name={l.glyph} id={`layer-${i}`} grad={l.grad} size={44} />
                <h3>{l.title}</h3>
                <p>{l.body}</p>
              </li>
            ))
          }
        </ul>

        <div class="wrap wifi rv" data-wifi>
          <button role="switch" aria-checked="true" aria-label="Wi-Fi" data-switch><i></i></button>
          <p>
            <b>Try it. Turn Wi-Fi off.</b>
            <span data-on>Wisp and Perch aren't using it anyway.</span>
            <span data-off hidden>Wisp is still typing. Perch is still routing. Nothing was waiting on the internet.</span>
          </p>
        </div>
      </div>
    </section>

    <section id="apps" class="block days">
      <div class="wrap center">
        <h2 class="h2 rv">Built for your kind of day.</h2>
        <p class="lede rv" style="--d:80ms">Email, Slack, code review, deploys, and the train home.</p>
      </div>
      <div class="marquee rv" style="--d:140ms">
        <ul>
          {
            [0, 1].map((copy) =>
              days.map((d) => {
                const a = app(d.slug);
                return (
                  <li aria-hidden={copy === 1 ? "true" : undefined}>
                    <a href={`/apps/${d.slug}`} tabindex={copy === 1 ? -1 : undefined} style={`--c1:${a.grad[0]};--c2:${a.grad[1]}`}>
                      <span class="tile">
                        <svg viewBox="0 0 24 24">
                          <path d={glyphs[d.glyph]} />
                        </svg>
                        <em>{a.name}</em>
                      </span>
                      <b>{d.label}</b>
                    </a>
                  </li>
                );
              }),
            )
          }
        </ul>
      </div>
      <div class="winners wrap">
        {
          winners.map((w, i) => (
            <div class="rv" style={`--d:${i * 90}ms`}>
              <WinnerCard app={w.app} hook={w.hook} us={[...w.us]} them={w.them} risk={w.risk} cta={w.cta} />
            </div>
          ))
        }
      </div>

      <ul class="soon-row wrap" aria-label="Coming soon">
        {
          soon.map((a, i) => (
            <li class="rv" style={`--d:${180 + i * 70}ms`}>
              <a href={`/apps/${a.slug}`}>
                <AppIcon app={a} size={48} />
                <span>
                  <b>{a.name}</b>
                  <span>{a.pitch}</span>
                </span>
                <em>Coming soon</em>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section id="pricing" class="block breakup">
      <div class="wrap">
        <div class="nope rv">
          <h2 class="fck" aria-label="F*CK Subscriptions.">F<span>*</span>CK<br />Subscriptions.</h2>
          <ul>
            {nopes.map((n) => <li>{n}</li>)}
          </ul>
          <p class="lede">Most apps want a monthly fee, an account and your data. Ours want one payment, once. Every paid plan here is lifetime.</p>
        </div>
        <div class="deal rv" style="--d:120ms">
          <p class="price">
            <b>{wispLife.price}</b>
            <span>once</span>
          </p>
          <p class="deal-sub">Wisp Lifetime. Yours for life.</p>
          <a class="pill-btn light" href="/apps/wisp#get">{wispLife.cta}</a>
          <div class="ticker" aria-label="Included">
            <ul>
              {[0, 1].map((c) => included.map((it) => <li aria-hidden={c === 1 ? "true" : undefined}>{it}</li>))}
            </ul>
          </div>
          <p class="deal-fine">
            Perch is free forever, or {perchLife.price} once for Lifetime. No monthly plans, ever.
            <a href="/apps/perch#get">See Perch pricing</a>
          </p>
        </div>
      </div>
    </section>

    <section class="block router" data-cycle>
      <div class="wrap center">
        <p class="pre rv">Questions from every agent,<br />answered from one place.</p>
        <h2 class="h2 rv" style="--d:80ms">Perch routes it all.</h2>
      </div>
      <div class="wrap rv" style="--d:140ms">
        <div class="opts" role="radiogroup" aria-label="Things you can say to Perch">
          {
            routes.map((r, i) => (
              <button role="radio" aria-checked={i === 0 ? "true" : "false"} tabindex={i === 0 ? 0 : -1} data-opt={i}>
                {r.ask}
              </button>
            ))
          }
        </div>
        <div class="console">
          <p class="hint">
            <kbd>⌥</kbd><kbd>⌥</kbd> double-tap Option, then say it
          </p>
          {
            routes.map((r, i) => (
              <div class:list={["panel", { on: i === 0 }]} data-panel={i} hidden={i !== 0}>
                <p class="said">“{/[?!.]$/.test(r.ask) ? r.ask : `${r.ask}.`}”</p>
                <p class="routed">
                  <AppIcon app={perch} size={28} />
                  <span>
                    Sent to <b>{r.to}</b> <em>{r.where}</em>
                  </span>
                </p>
                <p class="reply">{r.reply}</p>
              </div>
            ))
          }
        </div>
      </div>
    </section>

    <section class="block starts">
      <div class="wrap">
        <h2 class="h2 center rv">Two ways to start.</h2>
        <ol>
          {
            starts.map((s, i) => (
              <li class="rv" style={`--d:${i * 100}ms`}>
                <a href={s.href}>
                  <span class="n">{s.n}</span>
                  <span class="mono">{s.kicker}</span>
                  <h3>{s.title}</h3>
                  <p>{s.body}</p>
                </a>
                {i === 0 && <span class="or">or</span>}
              </li>
            ))
          }
        </ol>
      </div>
    </section>

    <section class="block works">
      <div class="wrap">
        <h2 class="h2 rv">Works with what you have.</h2>
        <p class="lede rv" style="--d:80ms">Your Mac, your phone, and the servers you already run.</p>
        <ul>
          {
            works.map((w, i) => (
              <li class="rv" style={`--d:${i * 90}ms`}>
                <div>
                  <h3>{w.title}</h3>
                  <p>{w.body}</p>
                  <span class="mono">{w.meta}</span>
                </div>
                <Glyph name={w.glyph} id={`works-${i}`} grad={w.grad} size={120} class="art" />
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <section id="faqs" class="block faqs">
      <div class="wrap faq-grid">
        <div class="faq-side rv">
          <h2 class="h2">FAQs</h2>
          <p class="ask-label">Ask AI for more info</p>
          <div class="ask">
            <a href={`https://chatgpt.com/?q=${askPrompt}`} target="_blank" rel="noopener">Ask <b>ChatGPT</b></a>
            <a href={`https://claude.ai/new?q=${askPrompt}`} target="_blank" rel="noopener">Ask <b>Claude</b></a>
          </div>
          <p class="mail">
            Or email a person.<br /><a href={`mailto:${site.email}`}>{site.email}</a>
          </p>
        </div>
        <div class="faq-list rv" style="--d:100ms">
          {
            faqs.map((f) => (
              <details>
                <summary>{f.q}</summary>
                <p>{f.a}</p>
              </details>
            ))
          }
        </div>
      </div>
    </section>

    <section id="about" class="block riley">
      <div class="wrap riley-grid">
        <figure class="rv">
          <Picture
            src={portrait}
            formats={["avif", "webp"]}
            widths={[480, 800, 1200]}
            sizes="(min-width: 960px) 520px, calc(100vw - 40px)"
            alt="Riley at her desk in a knit sweater, with the water and a bridge through the window behind her."
          />
        </figure>
        <div class="rv" style="--d:100ms">
          <p class="mono">made in vancouver</p>
          <h2 class="h2">Hi, I'm Riley.</h2>
          <p class="lede">
            I build AI prototypes at a startup in Gastown by day, and these apps the rest of the time. Every one started as something I wanted and
            couldn't find without a subscription, an account, or a server I didn't ask for.
          </p>
          <a class="pill-btn ghost" href={`mailto:${site.email}`}>Say hello</a>
        </div>
      </div>
    </section>

    <section class="finale">
      <HeroSky banner={`Wisp ${wispLife.price} · Perch ${perchLife.price}`} uid="end" seed={23} />
      <div class="finale-copy rv">
        <div class="icons">
          {apps.map((a) => <AppIcon app={a} size={56} />)}
        </div>
        <h2>Try Wisp tonight.</h2>
        <p>Seven days free. Then {wispLife.price} once, for life.</p>
        <div class="finale-ctas">
          <a class="glass" href="/apps/wisp#get">Download for Mac <Fragment set:html={arrow} /></a>
          <a class="glass ghost" href="/apps/perch">See Perch</a>
        </div>
      </div>
    </section>
  </main>

  <footer class="foot">
    <div class="wrap foot-top">
      <div class="foot-lead">
        <p class="foot-say">Small apps, made slowly,<br />in Vancouver.</p>
        <a class="foot-mail" href={`mailto:${site.email}`}>{site.email}<span aria-hidden="true">↗</span></a>
        <p class="foot-clock"><i></i>Vancouver · <time data-clock>Pacific time</time></p>
      </div>
      <nav class="foot-cols" aria-label="Footer">
        <div>
          <h3>Apps</h3>
          <ul>
            {
              apps.map((a) => (
                <li>
                  <a href={`/apps/${a.slug}`}>
                    <i class:list={{ live: a.kind === "ready" }} />
                    {a.name}
                    {a.kind === "soon" && <small>Soon</small>}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div>
          <h3>Studio</h3>
          <ul>
            <li><a href="#about">About Riley</a></li>
            <li><a href="#privacy">Privacy</a></li>
            <li><a href="#pricing">Pricing</a></li>
            <li><a href="#faqs">FAQs</a></li>
          </ul>
        </div>
        <div>
          <h3>Help</h3>
          <ul>
            <li><a href={`mailto:${site.support}`}>Support</a></li>
            <li><a href={`mailto:${site.support}?subject=Refund`}>Refunds</a></li>
            <li><a href="/">Classic site</a></li>
          </ul>
        </div>
        <div>
          <h3>Elsewhere</h3>
          <ul>
            {
              site.links.map((l) => (
                <li>
                  <a href={l.href} rel="me noopener" target="_blank">
                    {l.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
      </nav>
    </div>

    <p class="wordmark" aria-hidden="true">{site.studio}</p>

    <div class="wrap foot-legal">
      <p>© {new Date().getFullYear()} {site.studio}. Designed in Vancouver, Canada.</p>
      <a class="top" href="#main">Back to top <span aria-hidden="true">↑</span></a>
    </div>
  </footer>
</Warm>

<script>
  const still = matchMedia("(prefers-reduced-motion: reduce)").matches;

  document.querySelector("[data-dismiss]")?.addEventListener("click", () => {
    document.querySelector<HTMLElement>("[data-announce]")?.remove();
  });

  document.querySelectorAll<HTMLElement>("[data-wifi]").forEach((root) => {
    const sw = root.querySelector<HTMLButtonElement>("[data-switch]")!;
    sw.addEventListener("click", () => {
      const on = sw.getAttribute("aria-checked") !== "true";
      sw.setAttribute("aria-checked", String(on));
      root.classList.toggle("off", !on);
      root.querySelector<HTMLElement>("[data-on]")!.hidden = !on;
      root.querySelector<HTMLElement>("[data-off]")!.hidden = on;
    });
  });

  const clock = document.querySelector<HTMLElement>("[data-clock]");
  if (clock) {
    const fmt = new Intl.DateTimeFormat("en-US", { timeZone: "America/Vancouver", hour: "numeric", minute: "2-digit" });
    const tick = () => (clock.textContent = fmt.format(new Date()));
    tick();
    setInterval(tick, 20000);
  }

  const float = document.querySelector<HTMLElement>("[data-float]")!;
  const hero = document.querySelector<HTMLElement>("[data-hero]")!;
  new IntersectionObserver(([e]) => float.classList.toggle("show", !e.isIntersecting), { rootMargin: "-120px 0px 0px 0px" }).observe(hero);

  const words = [...document.querySelectorAll<HTMLElement>(".rot span")];
  if (!still && words.length > 1) {
    let w = 0;
    setInterval(() => {
      words[w].classList.remove("on");
      w = (w + 1) % words.length;
      words[w].classList.add("on");
    }, 2400);
  }

  document.querySelectorAll<HTMLElement>("[data-cycle]").forEach((root) => {
    const opts = [...root.querySelectorAll<HTMLButtonElement>("[data-opt]")];
    const panels = [...root.querySelectorAll<HTMLElement>("[data-panel]")];
    let cur = 0;
    let pausedUntil = 0;
    let visible = false;

    const show = (i: number, focus = false) => {
      cur = (i + opts.length) % opts.length;
      opts.forEach((o, j) => {
        o.setAttribute("aria-checked", String(j === cur));
        o.tabIndex = j === cur ? 0 : -1;
      });
      if (focus) opts[cur].focus();
      panels.forEach((p, j) => {
        p.classList.remove("on");
        p.hidden = j !== cur;
      });
      requestAnimationFrame(() => requestAnimationFrame(() => panels[cur].classList.add("on")));
    };

    opts.forEach((o, i) =>
      o.addEventListener("click", () => {
        pausedUntil = Date.now() + 14000;
        show(i);
      }),
    );

    root.querySelector('[role="radiogroup"]')?.addEventListener("keydown", (e) => {
      const k = (e as KeyboardEvent).key;
      const step = k === "ArrowRight" || k === "ArrowDown" ? 1 : k === "ArrowLeft" || k === "ArrowUp" ? -1 : 0;
      if (!step) return;
      e.preventDefault();
      pausedUntil = Date.now() + 14000;
      show(cur + step, true);
    });

    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
    }).observe(root);

    if (!still) {
      setInterval(() => {
        if (visible && Date.now() > pausedUntil) show(cur + 1);
      }, 3600);
    }
  });
</script>

