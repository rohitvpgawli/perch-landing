---
import Store from '../../layouts/Store.astro';
import Mark from './Mark.astro';
import { products, contactLink, offerPath, productPagePath, sourceIncluded, type ProductKey, type OfferVariant } from '../../data/store';
const { product, variant = 'app' } = Astro.props as { product: ProductKey; variant?: OfferVariant };
const item = products[product];
const source = variant === 'source';
const price = source ? item.sourcePrice : item.price;
const available = source ? item.sourceAvailable : item.appAvailable;
const links = {
  wisp: { app: import.meta.env.STRIPE_WISP_PAYMENT_LINK, source: import.meta.env.STRIPE_WISP_SOURCE_PAYMENT_LINK },
  perch: { app: import.meta.env.STRIPE_PERCH_PAYMENT_LINK, source: import.meta.env.STRIPE_PERCH_SOURCE_PAYMENT_LINK },
};
const configured = links[product][variant];
let paymentLink = '';
if (configured) {
  const url = new URL(configured);
  if (url.protocol !== 'https:' || url.hostname !== 'buy.stripe.com' || url.username || url.password) throw new Error(`Use a verified Stripe Payment Link for ${product} ${variant}.`);
  if (available) paymentLink = url.href;
}
---
<Store title={`${item.name} ${source ? '+ source' : 'app'} — $${price} once`} description={`${item.name}. ${source ? 'The app and full editable source.' : item.short} $${price} USD, one time. ${item.status}.`} siteKind="product" productSlug={product}>
  <section class="shell order-page"><a class="text-link" href={productPagePath(product)}>← Back to {item.name}</a>
    <div class="order-layout"><div class="order-intro"><Mark product={product} size={95}/><p class="eyebrow">{source ? 'A head start for your next idea' : 'A little more room to build'}</p><h1>{source ? <>Make it<br/><span class="serif">your own.</span></> : <>Pay once.<br/><span class="serif">Get on with it.</span></>}</h1><p>{item.description}</p><p class="fine">{item.requirements}</p><div class="variant-choice" aria-label="Choose a package"><a href={offerPath(product)} aria-current={!source ? 'page' : undefined}>App · ${item.price}</a><a href={offerPath(product,'source')} aria-current={source ? 'page' : undefined}>App + source · ${item.sourcePrice}</a></div></div>
      <div class="order-card"><div class="order-heading"><h2>{item.name}{source ? ' + source' : ''}</h2><span class="badge">Lifetime use</span></div><p class="order-price">${price}<span>USD · one time</span></p><p class="fine">{source ? 'Total package price. The app is included.' : 'No recurring charge. No subscription.'}</p><ul>{(source ? sourceIncluded : item.included).map(text => <li><span aria-hidden="true">✓</span>{text}</li>)}</ul>
      {paymentLink ? <><a class="button" href={paymentLink}>Continue to Stripe <span aria-hidden="true">↗</span></a><p class="fine order-fine">Applicable taxes are shown at checkout.</p></> : <><div class="availability"><span class="status-label">{item.status}</span><h3>This one’s still being built.</h3><p>${price} is the planned lifetime price. {source ? 'The source package is being prepared.' : 'Ask Riley about the current build.'} No payment is collected.</p></div><a class="button" href={contactLink(product,variant)}>{source ? 'Ask about the source' : 'Request access'} <span aria-hidden="true">↗</span></a><p class="fine order-fine">Opens your email app. A real person on the other end.</p></>}
      <p class="fine terms-note">{source ? 'Modification is the intent of this package. Commercial use and redistribution rights will be specified before sale. ' : ''}Update coverage, device limits, support, and refund terms will be published before purchases open.</p></div>
    </div>
  </section>
</Store>
<style>
.order-page{padding-block:35px 90px;min-height:80vh}.order-layout{display:grid;grid-template-columns:1fr 1fr;gap:90px;align-items:center;max-width:960px;margin:40px auto 0}.order-intro>.eyebrow{margin-top:22px;font-size:9px}.order-intro h1{font-size:64px;margin:22px 0}.order-intro h1 .serif{color:#75876b}.order-intro>p:not(.eyebrow){font-size:16px;color:var(--muted);max-width:370px}.order-intro>p.fine{font-size:11px;margin-top:22px}.variant-choice{display:flex;flex-wrap:wrap;gap:7px;margin-top:28px}.variant-choice>a{padding:12px 14px;border:1px solid var(--line);border-radius:7px;font-size:12px}.variant-choice>a[aria-current]{background:#eaf0e2;border-color:#a9b99a;color:#3c5733}.order-card{padding:30px;border:1px solid var(--line);border-radius:16px;background:#fff;box-shadow:0 10px 35px #33402506}.order-heading{display:flex;justify-content:space-between;align-items:center;gap:10px}.order-heading h2{font-size:25px}.order-price{font-size:64px;letter-spacing:-3px;margin:18px 0 0;line-height:1.3}.order-price span{font-size:12px;color:var(--muted);letter-spacing:0;margin-left:13px}.order-card>ul{padding:0;list-style:none;display:grid;gap:13px;margin:25px 0;font-size:13px}.order-card li{display:flex;gap:10px}.order-card li>span{color:#718665}.availability{padding:18px;background:#f4f5ee;border:1px solid #e4e6da;border-radius:8px;margin-bottom:20px}.availability h3{font-size:18px;margin-top:9px;letter-spacing:-.5px}.availability p{font-size:12px;color:var(--muted);margin-top:7px}.order-card .button{width:100%}.order-fine{text-align:center;margin-top:12px;font-size:10px}.terms-note{padding-top:18px;margin-top:18px;border-top:1px solid var(--line);font-size:10px}
@media(max-width:760px){.order-layout{grid-template-columns:1fr;gap:30px;margin-top:30px}.order-intro h1{font-size:54px}.order-card{padding:24px}.order-page{padding-bottom:50px}}
</style>
