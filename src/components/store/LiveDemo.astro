.pd-row.needs{background:rgba(250,201,97,.07)!important}
.pd-rt{flex:1;min-width:0}
.pd-rt b{display:block;font-size:15px;font-weight:650;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.pd-rt small{display:block;font-size:13px;color:var(--t2)}
.pd-rt small.amber{color:var(--amber)}
.pd-when{font-size:13px;color:var(--t3)}
.pd-row>svg{width:13px;height:13px;color:var(--t3)}
.pd-copy{display:inline-flex!important;align-items:center;gap:6px;height:28px;padding:0 10px!important;border-radius:999px;background:var(--raised)!important;font-size:13px!important;color:rgba(255,255,255,.85)!important}
.pd-copy svg{width:13px;height:13px}
.pd-paper{position:relative;min-height:190px;border-radius:18px;background:#F6E2A0;color:#2b2617;padding:12px 18px 18px;box-shadow:inset 0 -1px 0 rgba(0,0,0,.08)}
.pd-paper small{display:block;text-align:center;font-size:11.5px;font-weight:550;color:rgba(0,0,0,.34);margin-bottom:8px}
.pd-paper [data-note-text]{font-size:16px;line-height:1.45;white-space:pre-wrap;display:inline}
.pd-paper .pd-caret{display:inline-block;width:1.5px;height:18px;background:#b8860b;vertical-align:-3px;margin-left:1px;animation:pd-blink 1s steps(1) infinite}
.pd-swatches{display:flex;align-items:center;gap:12px;margin-top:14px}
