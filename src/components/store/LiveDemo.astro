.pd-primary{position:relative;width:100%;display:flex;align-items:center;gap:12px;height:48px;padding:0 10px;border-radius:16px;background:rgba(97,204,140,.13)!important;box-shadow:inset 0 0 0 1.5px rgba(97,204,140,.4);font-size:16px!important;font-weight:650;overflow:hidden;transition:transform .12s ease,background .2s ease}
.pd-primary:hover{background:rgba(97,204,140,.2)!important}
.pd-pi{width:28px;height:28px;border-radius:8px;background:#6fd497;color:#10301d;display:grid;place-items:center;box-shadow:inset 0 -2px 0 rgba(0,0,0,.18)}
.pd-pi svg{width:16px;height:16px}
.pd-pl{flex:1;text-align:left}
.pd-primary kbd{width:30px;height:24px;border-radius:6px;display:grid;place-items:center;background:rgba(97,204,140,.25);box-shadow:inset 0 0 0 1px rgba(97,204,140,.5),inset 0 -2px 0 rgba(0,0,0,.25);color:#9fe3b9}
.pd-primary kbd svg{width:14px;height:14px}
.pd-drain{position:absolute;left:0;bottom:0;height:2px;width:100%;background:var(--green);transform-origin:0 0;transform:scaleX(0)}
.pd-card.sending .pd-drain{animation:pd-drain 2s linear forwards}
.pd-card.sending .pd-primary,.pd-card.sending .pd-opt.chosen{opacity:.85}
.pd-card.sending .pd-acts,.pd-card.sending .pd-opt:not(.chosen){opacity:.35;transition:opacity .2s ease}
.pd-acts{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}
.pd-sec{display:inline-flex;align-items:center;gap:8px;height:36px;padding:0 13px 0 8px;border-radius:999px;background:var(--raised)!important;font-size:14px!important;color:rgba(255,255,255,.82)!important;transition:background .2s ease,transform .12s ease}
.pd-sec:hover{background:rgba(255,255,255,.09)!important}
.pd-sec kbd,.pd-opt kbd{min-width:22px;height:22px;border-radius:6px;display:grid;place-items:center;font-size:12px;font-weight:650;background:rgba(255,255,255,.09);box-shadow:inset 0 -2px 0 rgba(0,0,0,.35);color:var(--t2)}
.pressed{transform:scale(.97)}
.pd-chip-l{margin:0 0 4px;font-size:12px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:var(--amber)}
.pd-opts{display:flex;flex-direction:column;gap:8px;margin:12px 0}
.pd-opt{display:flex!important;align-items:center;gap:14px;width:100%;min-height:50px;padding:9px 14px!important;border-radius:16px;background:var(--raised)!important;text-align:left;transition:background .2s ease,box-shadow .2s ease,transform .12s ease}
.pd-opt:hover{background:rgba(255,255,255,.09)!important}
.pd-opt b{display:block;font-size:15px;font-weight:600}
.pd-opt small{display:block;font-size:12.5px;color:var(--t2);margin-top:1px}
