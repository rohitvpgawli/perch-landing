.pd-toast i{position:absolute;left:0;bottom:0;height:2px;width:100%;background:var(--amber);transform-origin:0 0;animation:pd-drain 2s linear forwards}

.pd-hud{position:absolute;left:50%;bottom:92px;z-index:30;display:flex;align-items:center;gap:12px;padding:9px 18px 9px 9px;border-radius:18px;background:rgba(18,18,20,.82);box-shadow:inset 0 0 0 1px rgba(255,255,255,.12),0 20px 40px rgba(0,0,0,.4);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);font-size:15px;font-weight:600;opacity:0;transform:translate(-50%,10px) scale(.95);pointer-events:none}
.pd-hud.show{animation:pd-hud 1.5s cubic-bezier(.3,1.2,.5,1) both}
.pd-hud kbd{min-width:44px;height:42px;padding:0 10px;border-radius:10px;display:grid;place-items:center;font-size:19px;font-weight:600;background:linear-gradient(#45454b,#2d2d32);box-shadow:inset 0 1px 0 rgba(255,255,255,.15),0 4px 0 #111,0 5px 10px rgba(0,0,0,.4);animation:pd-key 1.5s ease both}
.pd-hud kbd svg{width:20px;height:20px}
.pd-mouse{position:absolute;left:0;top:0;width:24px;height:24px;z-index:40;pointer-events:none;opacity:0;transform:translate(640px,460px);transition-property:transform,opacity;transition-timing-function:cubic-bezier(.45,.05,.2,1),ease;transition-duration:.8s,.3s;filter:drop-shadow(0 2px 3px rgba(0,0,0,.35))}
