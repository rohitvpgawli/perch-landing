.pd-head{display:flex;align-items:center;gap:6px;margin-bottom:14px}
.pd-head h4{flex:1;min-width:0;margin:0;font-size:20px;font-weight:650;letter-spacing:-.02em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
