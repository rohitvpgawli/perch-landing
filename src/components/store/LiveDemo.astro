.pd-hint kbd{display:inline-block;min-width:22px;padding:1px 6px;border-radius:5px;background:rgba(255,255,255,.08);box-shadow:inset 0 -1px 0 rgba(0,0,0,.4),inset 0 0 0 1px rgba(255,255,255,.08);font:500 12px var(--sys);color:rgba(255,255,255,.75)}

@keyframes pd-in{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
@keyframes pd-spin{to{transform:rotate(360deg)}}
@keyframes pd-pulse{50%{transform:scale(1.35);box-shadow:0 0 18px rgba(250,201,97,.9)}}
@keyframes pd-draw{from{stroke-dashoffset:20}to{stroke-dashoffset:0}}
@keyframes pd-shim{to{background-position:-200% 0}}
@keyframes pd-blink{50%{opacity:0}}
