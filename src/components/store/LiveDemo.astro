.pd-swatches .on{box-shadow:0 0 0 2px rgb(38,38,41),0 0 0 3.5px rgba(255,255,255,.85)}
.pd-swatches .butter{background:#FAE39E}.pd-swatches .rose{background:#F5C4C4}.pd-swatches .sage{background:#C4DEBD}.pd-swatches .sky{background:#BDD9F2}
.pd-swatches span{margin-left:auto;font-size:12.5px;color:var(--t2)}
.pd-toast{display:flex;align-items:center;gap:10px;height:40px;padding:0 8px 0 16px;border-radius:999px;font-size:14px;font-weight:550;background:rgba(30,30,33,.92);box-shadow:inset 0 0 0 1px rgba(255,255,255,.1),0 10px 24px rgba(0,0,0,.35);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);position:relative;overflow:hidden;opacity:0;transform:translateY(-8px) scale(.96);transition:opacity .25s ease,transform .4s cubic-bezier(.3,1.3,.5,1);pointer-events:auto;white-space:nowrap}
