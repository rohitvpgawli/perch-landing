.amber{color:var(--amber)}.blue{color:var(--blue)}.green{color:var(--green)}
.pd-t3{color:var(--t3)}
.pd-av{position:relative;width:36px;height:36px;flex:none}
.pd-av svg{width:100%;height:100%;display:block}
.pd-av.big{width:44px;height:44px}
.pd-badge{position:absolute;right:-3px;bottom:-3px;width:12px;height:12px;border-radius:50%;box-shadow:0 0 0 2.5px rgb(38,38,41)}
.pd-av.big .pd-badge{width:13px;height:13px}
.pd-badge.amber{background:var(--amber)}.pd-badge.blue{background:var(--blue)}.pd-badge.green{background:var(--green)}
.pd-cbody2 h5{margin:0 0 4px;font-size:17px;font-weight:650;letter-spacing:-.015em;line-height:1.3}
.pd-sub{margin:0 0 10px;font-size:13.5px;color:var(--t2)}
