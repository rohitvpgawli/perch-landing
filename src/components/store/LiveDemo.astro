.pd-sect{display:flex;justify-content:space-between;margin:12px 0 6px;font-size:14px;font-weight:650;color:var(--t2)}
.pd-row{display:flex!important;align-items:center;gap:12px;width:calc(100% + 16px);margin:0 -8px;padding:9px 8px!important;border-radius:14px;text-align:left;transition:background .2s ease,transform .12s ease}
