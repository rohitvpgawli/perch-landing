    }
    const openShelf = () => stage.classList.add('shelf-open');
    const closeShelf = () => { stage.classList.remove('shelf-open'); hidePill(); };
    const head = (k: Key, status: string, cls: string) => {
      const s = sessions[k], dot = keys.indexOf(k);
      return `<div class="pd-head"><span class="pd-btn">${ic.back}</span><h4>${s.name}</h4><span class="pd-dots">${keys.map((_, i) => `<i class="${i === dot ? `on ${cls}` : ''}"></i>`).join('')}</span><span class="pd-btn">${ic.pencil}</span><span class="pd-btn">${ic.close}</span></div>
      <div class="pd-who"><span class="pd-av big">${s.icon}<b class="pd-badge ${cls}"></b></span><div><strong>${s.provider} · ${s.folder}</strong><span class="${cls}">${status}</span> <span class="pd-t3">· now</span></div></div>`;
    };
    const primary = (act: string, label: string) => `<button class="pd-primary" type="button" data-act="${act}"><span class="pd-pi">${ic.check}</span><span class="pd-pl">${label}</span><kbd>${ic.enter}<span class="esc">esc</span></kbd></button>`;
    const sec = (act: string, n: number, label: string) => `<button class="pd-sec" type="button" data-act="${act}"><kbd>${n}</kbd>${label}</button>`;
    const row = (k: Key) => {
      const s = sessions[k], cls = tone(s.state);
      const sub = s.state === 'needs' ? s.ask : s.state === 'done' ? 'Finished in 6m' : `${s.status} · 4m`;
      return `<button class="pd-row ${s.state === 'needs' ? 'needs' : ''}" type="button" data-act="row-${k}"><span class="pd-av">${s.icon}<b class="pd-badge ${cls}"></b></span><span class="pd-rt"><b>${s.name}</b><small class="${s.state === 'needs' ? 'amber' : ''}">${s.provider} · ${sub}</small></span><span class="pd-when">${s.state === 'done' ? '6m' : 'now'}</span>${ic.chev}</button>`;
    };
    const views = {
      inbox() {
        const by = (st: State) => keys.filter(k => sessions[k].state === st);
        const [n, w, d] = [by('needs'), by('work'), by('done')];
        return `<div class="pd-head"><h4 class="big">Agents</h4><span class="pd-btn">${ic.gear}</span><span class="pd-btn">${ic.close}</span></div>
          <div class="pd-chips">${n.length ? `<span class="pd-chip amber">${n.length} need${n.length === 1 ? 's' : ''} you</span>` : ''}${w.length ? `<span class="pd-chip blue">${w.length} working</span>` : ''}</div>
          ${n.length ? `<p class="pd-sect">Needs you</p>${n.map(row).join('')}` : ''}
          ${w.length ? `<p class="pd-sect">Working</p>${w.map(row).join('')}` : ''}
          ${d.length ? `<p class="pd-sect">Recent <span>Clear</span></p>${d.map(row).join('')}` : ''}`;
      },
      permission: () => `${head('codex', 'Waiting for you', 'amber')}<h5>Codex wants to run a command</h5><p class="pd-sub">Install the Stripe SDK</p>
        <div class="pd-code"><span>$</span> pnpm add stripe</div>
        ${primary('allow', 'Allow')}<div class="pd-acts">${sec('deny', 2, 'Deny')}${sec('term', 3, 'Answer in Terminal')}</div>`,
      question: () => `${head('claude', 'Waiting for you', 'amber')}<p class="pd-chip-l">Billing</p><h5>Which billing periods should the toggle offer?</h5>
        <div class="pd-opts">${options.map(([t, d], i) => `<button class="pd-opt" type="button" data-act="opt${i + 1}"><kbd>${i + 1}</kbd><span><b>${t}</b>${d ? `<small>${d}</small>` : ''}</span></button>`).join('')}</div>
        <div class="pd-field"><input data-input placeholder="Or answer in your own words…" aria-label="Answer in your own words" maxlength="60"/><button class="pd-send" type="button" data-act="own" aria-label="Send">${ic.up}</button></div>`,
      reply: () => `${head('claude', 'Waiting for your reply', 'amber')}<h5>Your move</h5>
        <div class="pd-said"><small>Claude Code said</small>${lastWords}</div>
        <div class="pd-field"><input data-input placeholder="Reply to Claude Code…" aria-label="Reply to Claude Code" maxlength="60"/><button class="pd-send" type="button" data-act="send" aria-label="Send">${ic.up}</button></div>
        <div class="pd-acts">${sec('done', 2, 'Done for now')}${sec('term', 3, 'Answer in Terminal')}</div>`,
      note: () => `<div class="pd-head"><span class="pd-btn">${ic.back}</span><h4>Note</h4><button class="pd-copy" type="button" data-act="copy">${ic.copy}Copy</button><span class="pd-btn">${ic.pin}</span><span class="pd-btn">${ic.trash}</span><span class="pd-btn">${ic.close}</span></div>
        <div class="pd-paper"><small>Today at ${now()}</small><div data-note-text></div><i class="pd-caret"></i></div>
        <div class="pd-swatches"><i class="butter on"></i><i class="rose"></i><i class="sage"></i><i class="sky"></i><span data-count>0/1000 · Saved</span></div>`,
    };

    // ---------- The pill under the card ----------
    let pillTimer = 0;
    function setPill(cls: string, html: string, ttl = 0) {
      clearTimeout(pillTimer);
      pill.className = `pd-pill ${cls}`;
      pill.innerHTML = html;
      void pill.offsetWidth; pill.classList.add('show');
      if (ttl) pillTimer = window.setTimeout(hidePill, ttl);
    }
    function hidePill() { clearTimeout(pillTimer); pill.classList.remove('show'); }
    const hint = (keysHtml: string, rest: string) => setPill('', `<span class="mute">Press</span>${keysHtml}<span class="mute">${rest}</span>`);
    const kbd = (k: string, label = k) => `<kbd data-k="${k}">${label}</kbd>`;
    function hitKey(k: string) {
      const el = pill.querySelector(`[data-k="${k}"]`);
      el?.classList.add('hit');
      window.setTimeout(() => el?.classList.remove('hit'), 260);
    }

    // ---------- Clock, waiting and cancellation ----------
    let token = 0, time = 0, last = 0, paused = reduced, visible = false, started = false;
    let pendingAct: string | null = null, chapter = 0, chapterTime = 0;
    const waiters = new Set<() => void>();
    const durations = [8000, 17000, 11000, 11500];
    function tick(t: number) {
      const dt = last ? Math.min(t - last, 250) : 0;
      last = t;
      if (visible && !paused && !document.hidden) { time += dt; chapterTime += dt; }
      waiters.forEach(w => w());
      chapterButtons.forEach((b, i) => {
        const p = i < chapter ? 1 : i > chapter ? 0 : Math.min(chapterTime / durations[i], .985);
        (b.firstElementChild as HTMLElement).style.transform = `scaleX(${p})`;
      });
    }
    const frameLoop = (t: number) => { tick(t); requestAnimationFrame(frameLoop); };
    requestAnimationFrame(frameLoop);
    // Keep the clock moving if a visible page stops getting animation frames.
    setInterval(() => { const t = performance.now(); if (t - last > 200) tick(t); }, 100);

    function sleep(ms: number) {
      const mine = token, end = time + ms;
      return new Promise<void>((resolve, reject) => {
        const w = () => {
          if (mine !== token) { waiters.delete(w); reject(CANCEL); }
          else if (time >= end) { waiters.delete(w); resolve(); }
        };
        waiters.add(w);
      });
    }
    // Resolves with the visitor's action, or null when the scripted pause runs out.
    function waitAct(acts: string[], ms: number) {
      const mine = token, end = time + ms;
      if (pendingAct && !acts.includes(pendingAct)) pendingAct = null;
      return new Promise<string | null>((resolve, reject) => {
        const w = () => {
          if (mine !== token) { waiters.delete(w); reject(CANCEL); }
          else if (pendingAct && acts.includes(pendingAct)) { const a = pendingAct; pendingAct = null; waiters.delete(w); resolve(a); }
          else if (time >= end) { waiters.delete(w); resolve(null); }
        };
        waiters.add(w);
      });
    }

    // ---------- Pointer and keys ----------
    function point(el: Element) {
      const s = parseFloat(stage.style.getPropertyValue('--s')) || 1;
      const r = el.getBoundingClientRect(), sr = stage.getBoundingClientRect();
      return [(r.left - sr.left + r.width / 2) / s, (r.top - sr.top + r.height / 2) / s];
    }
    function glide(x: number, y: number, ms: number) {
      mouse.style.transitionDuration = `${ms}ms, .3s`;
      mouse.style.transform = `translate(${x}px, ${y}px)`;
      mouse.classList.add('on');
    }
    async function moveTo(el: Element, ms = 800) {
      const [x, y] = point(el);
      glide(x - 4, y - 3, ms);
      await sleep(ms);
    }
    async function click(el: Element, ms = 800) {
      await moveTo(el, ms);
      mouse.classList.add('down'); el.classList.add('pressed');
      await sleep(160);
      mouse.classList.remove('down'); el.classList.remove('pressed');
    }
    // Like macOS, the pointer hides while you use the keyboard.
    async function press(k: string, el?: Element | null) {
      mouse.classList.remove('on');
      hitKey(k);
      el?.classList.add('pressed');
      await sleep(200);
      el?.classList.remove('pressed');
    }
    const hover = (on: boolean) => stage.classList.toggle('hover', on);

    // Shows "Sending…" for the two-second undo window. Returns false if taken back.
    async function send(sending: string, receipt: string) {
      card.classList.add('sending');
      const label = body.querySelector('.pd-pl');
      const before = label?.textContent;
      if (label) label.textContent = 'Sending…';
      setPill('undo', `<span>${sending}</span><button type="button" data-act="undo">Undo</button><i></i>`);
      const a = await waitAct(['undo'], 2000);
      card.classList.remove('sending');
      if (label && before) label.textContent = before;
      if (a === 'undo') { setPill('', '<span class="mute">Taken back. Nothing was sent.</span>', 1600); await sleep(900); return false; }
      setPill('ok', `${ic.tick}<span>${receipt}</span>`);
      return true;
    }
    async function typeInto(input: HTMLInputElement, text: string) {
      for (const ch of text) {
        if (document.activeElement === input) return;
        input.value += ch;
        input.nextElementSibling?.classList.toggle('ready', !!input.value.trim());
        await sleep(34);
      }
    }

    // ---------- Chapters ----------
    async function agentsWork() {
      working('claude', false); working('codex', false);
      await sleep(400);
      await typePrompt('claude', claudeIntro[0][1]);
      working('claude', true);
      await sleep(300);
      await typePrompt('codex', codexIntro[0][1], 20);
      working('codex', true);
      put('claude', claudeIntro[1]);
      await sleep(500); put('codex', codexIntro[1]);
      await moveTo(tab, 1000);
      hover(true);
      await sleep(700); put('claude', claudeIntro[2]);
      await sleep(700); put('codex', codexIntro[2]); put('claude', claudeIntro[3]);
      await sleep(500);
      setS('cursor', 'done');
      stage.classList.add('finish');
      await sleep(1600);
      stage.classList.remove('finish'); hover(false);
      glide(560, 600, 900);
      await sleep(500);
    }
    async function theyAsk() {
      // Two agents ask within a second of each other.
      await sleep(500);
      working('codex', false);
      put('codex', ['x', 'Running pnpm add stripe']);
      put('codex', ['xy', 'Waiting for your answer in Perch']);
      setS('codex', 'needs', { ask: 'Run pnpm add stripe?' });
      stage.classList.add('nudge');
      await sleep(900);
      working('claude', false);
      put('claude', ['c', 'AskUserQuestion']);
      question.forEach(l => put('claude', l));
      setS('claude', 'needs', { ask: 'Asks: Which billing periods?' });
      await sleep(900);
      stage.classList.remove('nudge');
      await click(tab, 800);
      openShelf(); show('inbox', views.inbox(), PY.inbox, 'inbox');
      await sleep(1300);
      await click(body.querySelector('[data-act="row-codex"]')!, 700);
      glide(860, 560, 900);
      show('permission', views.permission(), PY.codex, 'codex');
      hint(kbd('Enter', ic.enter), 'to allow');
      for (;;) {
        let a = await waitAct(['allow', 'deny'], 2400);
        if (!a) { await press('Enter', body.querySelector('.pd-primary')); a = 'allow'; }
        const ok = a === 'deny'
          ? await send('Denying', 'Denied · Codex will try another way')
          : await send('Allowing · pnpm add stripe', 'Allowed · Codex is back at work');
        if (ok) { put('codex', a === 'deny' ? ['xy', 'Denied in Perch'] : ['xok', 'Allowed in Perch · added stripe 18.4.0']); break; }
        hint(kbd('Enter', ic.enter), 'to allow');
      }
      flashAnswered('codex');
      setS('codex', 'work', { status: 'Editing files' }); working('codex', true);
      await sleep(1100);
      // Perch moves straight on to the next agent that is waiting.
      show('question', views.question(), PY.claude, 'claude');
      hint(`${kbd('1')}${kbd('2')}${kbd('3')}`, 'to answer');
      let b = await waitAct(['opt1', 'opt2', 'opt3', 'own'], 2600);
      const optEls = body.querySelectorAll('.pd-opt');
      if (!b) { await press('1', optEls[0]); b = 'opt1'; }
      const input = body.querySelector<HTMLInputElement>('[data-input]')!;
      const chosen = b === 'own' ? (input.value.trim() || options[0][0]) : options[Number(b.slice(3)) - 1][0];
      if (b !== 'own') optEls[Number(b.slice(3)) - 1].classList.add('chosen');
      if (await send(`Answering · ${chosen}`, `Answered · ${chosen}`)) {
        put('claude', ['ok', `${chosen} · answered in Perch`]);
      } else optEls.forEach(o => o.classList.remove('chosen'));
      flashAnswered('claude');
      setS('claude', 'work', { status: 'Editing files' }); working('claude', true);
      await sleep(1500);
      hidePill();
      show('inbox', views.inbox(), PY.inbox, 'inbox');
      await sleep(1500);
    }
    async function replyWhenDone() {
      openShelf();
      if (route !== 'inbox') show('inbox', views.inbox(), PY.inbox, 'inbox');
      put('claude', ['c', 'Update(src/components/PricingToggle.tsx)']);
      await sleep(900);
      working('claude', false);
      put('claude', ['s', lastWords]);
      setS('claude', 'needs', { ask: 'Finished · reply from here' });
      show('reply', views.reply(), PY.claude, 'claude');
      hint(kbd('Enter', ic.enter), 'to send a reply');
      const field = body.querySelector<HTMLInputElement>('[data-input]')!;
      let b = await waitAct(['send', 'done'], 1200);
      if (!b) {
        await typeInto(field, reply);
        b = await waitAct(['send', 'done'], document.activeElement === field ? 12000 : 600);
        if (!b) { await press('Enter', body.querySelector('.pd-send')); b = 'send'; }
      }
      if (b === 'done') {
        setPill('ok', `${ic.tick}<span>Done for now · the turn ends as usual</span>`);
        setS('claude', 'done');
      } else {
        const text = field.value.trim() || reply;
        if (await send('Sending reply', 'Sent · Claude is on it')) {
          put('claude', ['p', text]);
          flashAnswered('claude');
          setS('claude', 'work', { status: 'Editing files' }); working('claude', true);
        }
      }
      await sleep(1300);
      put('claude', ['c', 'Write(src/components/CompareTable.tsx)']);
      await sleep(1100);
    }
    async function notes() {
      openShelf();
      hidePill();
      await click(q('[data-plus]'), 800);
      show('note', views.note(), PY.note, 'note');
      glide(620, 600, 900);
      const text = body.querySelector('[data-note-text]')!, count = body.querySelector('[data-count]')!;
      const note = 'Next: comparison table\nThree columns, monthly by default.';
      await sleep(300);
      for (const ch of note) { text.textContent += ch; count.textContent = `${text.textContent!.length}/1000`; await sleep(36); }
      count.textContent = `${note.length}/1000 · Saved`;
      const a = await waitAct(['copy'], 900);
      if (!a) await click(body.querySelector('[data-act="copy"]')!, 700);
      setPill('ok', `${ic.tick}<span>Copied · paste it into any agent</span>`);
      await sleep(1900);
      closeShelf();
      glide(560, 640, 900);
      await sleep(900);
      put('claude', ['s', 'Done. The comparison table is in and the tests pass.']);
      working('claude', false); working('codex', false);
      put('codex', ['xok', 'Checkout works end to end · worked for 6m 02s']);
      setS('claude', 'done'); setS('codex', 'done');
      digest.innerHTML = `${ic.tick}2 sessions finished <em>· Pricing page, Stripe checkout</em>`;
      stage.classList.add('digest', 'finish');
      await sleep(3400);
      stage.classList.remove('digest', 'finish');
      mouse.classList.remove('on');
      await sleep(600);
    }
    const scripts = [agentsWork, theyAsk, replyWhenDone, notes];

    function setChapter(i: number) {
      chapter = i; chapterTime = 0;
      chapterButtons.forEach((b, n) => b.setAttribute('aria-current', String(n === i)));
      const strip = chapterButtons[i].parentElement!, current = chapterButtons[i];
      strip.scrollTo({ left: current.offsetLeft - (strip.clientWidth - current.offsetWidth) / 2, behavior: reduced ? 'auto' : 'smooth' });
    }
    function reset(i: number) {
      closeShelf(); hover(false);
      stage.classList.remove('nudge', 'digest', 'finish');
      card.classList.remove('sending');
      pendingAct = null;
      baseline(i);
    }
    async function play(from: number) {
      const mine = ++token;
      for (let i = from; ; i = (i + 1) % scripts.length) {
        if (mine !== token) return;
        setChapter(i); reset(i);
        try { await scripts[i](); }
        catch (error) { if (error === CANCEL) return; throw error; }
      }
    }
    function setPaused(value: boolean) {
      paused = value;
      playBtn.setAttribute('aria-label', paused ? 'Play demo' : 'Pause demo');
      q('[data-play-icon]').innerHTML = paused ? '<path d="M5 3.2v9.6L12.5 8Z" fill="currentColor"/>' : '<path d="M5 3.5v9M11 3.5v9"/>';
    }

    // ---------- Visitor input ----------
    function act(name: string) {
      if (name === 'term') { setPill('', '<span class="mute">In Perch, this brings the session’s terminal forward.</span>', 2000); return; }
      pendingAct = name;
      if (!started) { started = true; play(chapter); }
      setPaused(false);
    }
    stage.addEventListener('click', event => {
      const target = (event.target as Element).closest<HTMLElement>('[data-act]');
      if (target) act(target.dataset.act!);
    });
    stage.addEventListener('input', event => {
      const input = event.target as HTMLInputElement;
      input.nextElementSibling?.classList.toggle('ready', !!input.value.trim());
    });
    const keymap: Record<string, Record<string, string>> = {
      permission: { Enter: 'allow', '1': 'allow', '2': 'deny', '3': 'term' },
      question: { '1': 'opt1', '2': 'opt2', '3': 'opt3' },
      reply: { Enter: 'focus', '2': 'done', '3': 'term' },
    };
    frame.addEventListener('keydown', event => {
      const inInput = event.target instanceof HTMLInputElement;
      if (event.key === 'Escape') {
        if (card.classList.contains('sending')) { event.preventDefault(); act('undo'); }
        else if (inInput) (event.target as HTMLInputElement).blur();
        return;
      }
      if (inInput) {
        if (event.key === 'Enter') { event.preventDefault(); hitKey('Enter'); act(route === 'question' ? 'own' : 'send'); }
        return;
      }
      const name = keymap[route]?.[event.key];
      if (!name || !stage.classList.contains('shelf-open') || card.classList.contains('sending')) return;
      event.preventDefault();
      mouse.classList.remove('on');
      hitKey(event.key);
      if (name === 'focus') body.querySelector<HTMLInputElement>('[data-input]')?.focus();
      else act(name);
    });
    stage.addEventListener('pointerdown', event => {
      if (!(event.target as Element).closest('input')) frame.focus({ preventScroll: true });
    });
    playBtn.addEventListener('click', () => {
      if (!started) { started = true; setPaused(false); play(chapter); return; }
      setPaused(!paused);
    });
    chapterButtons.forEach((button, i) => button.addEventListener('click', () => {
      started = true; setPaused(false); play(i);
    }));

    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      if (visible && !started && !reduced) { started = true; play(0); }
    }, { threshold: .3 }).observe(frame);

    // Reduced motion: a still frame of the approval card until the visitor presses play.
    reset(1);
    if (reduced) {
      setChapter(1);
      setS('codex', 'needs', { ask: 'Run pnpm add stripe?' });
      openShelf(); show('permission', views.permission(), PY.codex, 'codex');
      hint(kbd('Enter', ic.enter), 'to allow');
      setPaused(true);
    } else {
      setChapter(0);
      reset(0);
    }
  }
</script>
