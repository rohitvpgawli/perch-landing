---
import { providerIcons as P } from './icons';
const chapters = ['Agents work', 'They ask, you answer', 'Reply when it’s done', 'Notes at the edge'];
---
<div class="pd" data-demo>
  <div class="pd-frame" data-frame tabindex="0" aria-label="Interactive Perch demo. Use Return, number keys and Escape on the card.">
    <div class="pd-stage" data-stage>
      <div class="pd-wall" aria-hidden="true"></div>

      <div class="pd-menubar" aria-hidden="true">
        <svg class="pd-apple" viewBox="0 0 14 17"><path fill="currentColor" d="M11.6 9c0-2 1.7-3 1.8-3.1-1-1.4-2.5-1.6-3-1.7-1.3-.1-2.5.8-3.1.8-.7 0-1.7-.8-2.7-.7C3.2 4.3 2 5.1 1.3 6.3c-1.5 2.5-.4 6.3 1 8.4.7 1 1.5 2.1 2.6 2.1 1-.1 1.4-.7 2.7-.7 1.2 0 1.6.7 2.7.6 1.1 0 1.8-1 2.5-2 .8-1.1 1.1-2.2 1.1-2.3 0 0-2.3-.9-2.3-3.4ZM9.5 2.9c.6-.7 1-1.7.9-2.7-.9 0-1.9.6-2.5 1.3-.6.6-1 1.6-.9 2.6 1 .1 1.9-.5 2.5-1.2Z"/></svg>
        <b>Terminal</b><span class="pd-mi">Shell</span><span class="pd-mi">Edit</span><span class="pd-mi">View</span><span class="pd-mi">Window</span><span class="pd-mi">Help</span>
        <span class="pd-mb-right">
          <svg class="pd-mbperch" viewBox="0 0 18 14"><rect x="1" y="1" width="16" height="12" rx="3.2" fill="none" stroke="currentColor" stroke-width="1.4"/><path d="M17 3.6h-4.4a1.8 1.8 0 0 0-1.8 1.8v3.2a1.8 1.8 0 0 0 1.8 1.8H17Z" fill="currentColor"/><circle class="pd-mblight" cx="13.6" cy="7" r="1.5"/></svg>
          <svg viewBox="0 0 18 13" class="pd-mi"><path fill="currentColor" d="M9 12.4 6.6 9.9a3.4 3.4 0 0 1 4.8 0Zm-4-4.1L3.6 6.8a7.6 7.6 0 0 1 10.8 0L13 8.3a5.6 5.6 0 0 0-8 0ZM1.5 4.8 0 3.3a12.7 12.7 0 0 1 18 0l-1.5 1.5a10.6 10.6 0 0 0-15 0Z"/></svg>
          <svg viewBox="0 0 26 12" class="pd-mi"><rect x=".6" y=".6" width="22" height="10.8" rx="3" fill="none" stroke="currentColor" stroke-opacity=".55" stroke-width="1.1"/><rect x="2.3" y="2.3" width="15" height="7.4" rx="1.6" fill="currentColor"/><path d="M24.2 4v4" stroke="currentColor" stroke-opacity=".55" stroke-width="1.4" stroke-linecap="round"/></svg>
          <span data-clock>Tue 9:41 AM</span>
        </span>
      </div>

      <div class="pd-win pd-term pd-claude" data-win="claude" aria-hidden="true">
        <div class="pd-winbar"><span class="pd-traffic"><i></i><i></i><i></i></span><span class="pd-wt"><span class="pd-wicon" set:html={P.claude}></span>claude · ~/shop/pricing-page<i class="pd-wdot"></i></span></div>
        <div class="pd-tbody">
          <div class="pd-banner"><span><span class="o">✻</span> Welcome to <b>Claude Code</b></span><small>~/shop/pricing-page</small></div>
          <div data-term="claude"></div>
          <div class="pd-working" data-working="claude"><span class="o">✻</span> <span class="pd-shimmer">Working…</span> <span class="g">(esc to interrupt)</span></div>
          <div class="pd-input"><span class="g">›</span> <span data-input-text="claude"></span><i class="pd-caret-t"></i></div>
        </div>
      </div>

      <div class="pd-win pd-term pd-codex" data-win="codex" aria-hidden="true">
        <div class="pd-winbar"><span class="pd-traffic"><i></i><i></i><i></i></span><span class="pd-wt"><span class="pd-wicon" set:html={P.codex}></span>codex · ~/shop/checkout<i class="pd-wdot"></i></span></div>
        <div class="pd-tbody">
          <div class="pd-cbanner"><b>&gt;_ OpenAI Codex</b> <span class="g">· ~/shop/checkout</span></div>
          <div data-term="codex"></div>
          <div class="pd-working" data-working="codex"><span class="pd-shimmer b">• Working</span> <span class="g">(esc to interrupt)</span></div>
          <div class="pd-input"><span class="g">›</span> <span data-input-text="codex"></span><i class="pd-caret-t"></i></div>
        </div>
      </div>

      <div class="pd-dock" aria-hidden="true">
        <span set:html={P.finder}></span><span class="on" set:html={P.terminal}></span><span class="on" set:html={P.claude}></span><span class="on" set:html={P.codex}></span><span class="on" set:html={P.cursor}></span><i class="pd-dsep"></i><span class="on"><img src="/products/perch-icon-512.webp" alt="" width="46" height="46"/></span>
      </div>

      <div class="pd-tab" data-tab aria-hidden="true"><i class="pd-mk" data-mark="claude"></i><i class="pd-mk" data-mark="codex"></i><i class="pd-mk" data-mark="cursor"></i></div>
      <div class="pd-labels" aria-hidden="true"><span data-label="claude"></span><span data-label="codex"></span><span data-label="cursor"></span></div>
      <div class="pd-digest" data-digest aria-hidden="true"></div>

      <div class="pd-shelf">
        <div class="pd-rail" aria-hidden="true">
          <span class="pd-rinbox" data-r="inbox"><svg class="pd-i" viewBox="0 0 20 20"><path d="M3 11.5 5 5h10l2 6.5V15a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1Z"/><path d="M3 11.5h4l1 2h4l1-2h4"/></svg><b data-badge>1</b></span>
          <span class="pd-rsess"><span data-r="claude"><i class="pd-mk" data-rmark="claude"></i></span><span data-r="codex"><i class="pd-mk" data-rmark="codex"></i></span><span data-r="cursor"><i class="pd-mk" data-rmark="cursor"></i></span></span>
          <span class="pd-rnotes"><span data-r="notes"><svg class="pd-i" viewBox="0 0 20 20"><rect x="3.5" y="4" width="13" height="12" rx="2"/><path d="M3.5 7.5h13M6.5 10.5h7M6.5 13h5"/></svg></span><i class="pd-rdiv"></i><span data-r="note"><i class="pd-minote"></i></span><span data-r="plus" data-plus><svg class="pd-i" viewBox="0 0 20 20"><path d="M10 4.5v11M4.5 10h11"/></svg></span></span>
          <span class="pd-rmore"><i></i><i></i><i></i></span>
        </div>
        <div class="pd-col" data-col>
          <div class="pd-card" data-card><i class="pd-ptr"></i><div class="pd-cbody2" data-card-body></div></div>
          <div class="pd-pill" data-pill role="status"></div>
        </div>
      </div>

      <svg class="pd-mouse" data-mouse viewBox="0 0 24 24" aria-hidden="true"><path d="M5 2.5v17.2l4.3-4.1 2.9 6.6 2.9-1.3-2.9-6.5h6Z" fill="#111" stroke="#fff" stroke-width="1.4" stroke-linejoin="round"/></svg>
    </div>
  </div>

  <div class="pd-story">
    <button class="pd-play" type="button" data-play aria-label="Pause demo"><svg viewBox="0 0 16 16" data-play-icon><path d="M5 3.5v9M11 3.5v9"/></svg></button>
    <div class="pd-chapters" role="group" aria-label="Demo chapters">
      {chapters.map((label, index) => <button type="button" data-chapter={index}><i></i><span>{label}</span></button>)}
    </div>
  </div>
</div>

<style is:global>
.pd{--amber:#FAC961;--blue:#5E8FFA;--green:#61CC8C;--red:#FF736B;--t1:rgba(255,255,255,.94);--t2:rgba(255,255,255,.56);--t3:rgba(255,255,255,.34);--raised:rgba(255,255,255,.055);--sys:-apple-system,BlinkMacSystemFont,'SF Pro Text','Inter Tight',system-ui,sans-serif;--mono:ui-monospace,'SF Mono',SFMono-Regular,Menlo,monospace;--ease:cubic-bezier(.3,1.2,.5,1);width:100%}
.pd-frame{position:relative;width:100%;height:700px;border-radius:22px;overflow:hidden;outline:none;background:#0d0e10;box-shadow:0 0 0 1px rgba(255,255,255,.12),0 0 0 7px #0a0a0c,0 0 0 8px rgba(255,255,255,.07),0 70px 140px -50px rgba(0,0,0,.95),0 0 160px -40px rgba(244,169,135,.25)}
.pd-frame:focus-visible{box-shadow:0 0 0 1px rgba(255,255,255,.1),0 0 0 7px #0a0a0c,0 0 0 9px var(--amber),0 70px 140px -50px rgba(0,0,0,.95)}
.pd-stage{position:absolute;left:0;top:0;width:1120px;height:700px;transform:scale(var(--s,1));transform-origin:0 0;overflow:hidden;font-family:var(--sys);color:var(--t1);-webkit-font-smoothing:antialiased;user-select:none;letter-spacing:-.003em;text-align:left;line-height:normal}
:where(.pd-stage button){font:inherit;color:inherit;border:0;background:none;padding:0;cursor:pointer;-webkit-tap-highlight-color:transparent}
.pd-stage kbd{font-family:var(--sys)}
.pd-wall{position:absolute;inset:0;background:url(/products/dusk.webp) center 62%/cover no-repeat}
.pd-wall:after{content:'';position:absolute;inset:0;background:linear-gradient(180deg,rgba(10,12,24,.18),transparent 30%,transparent 70%,rgba(10,8,14,.25))}

.pd-menubar{position:absolute;left:0;right:0;top:0;height:26px;display:flex;align-items:center;gap:18px;padding:0 14px;font-size:13px;background:rgba(14,16,28,.3);backdrop-filter:blur(24px) saturate(170%);-webkit-backdrop-filter:blur(24px) saturate(170%);z-index:20;color:rgba(255,255,255,.94)}
.pd-apple{width:13px;height:16px}
.pd-menubar b{font-weight:650}
.pd-mb-right{margin-left:auto;display:flex;align-items:center;gap:16px}
.pd-mb-right svg{height:13px;width:auto}
.pd-mb-right .pd-mbperch{width:18px;height:14px}
.pd-mblight{fill:#2a2a30;transition:fill .4s ease}
.pd-stage.alert .pd-mblight{fill:var(--amber)}

.pd-win{position:absolute;border-radius:12px;background:rgba(20,20,23,.9);box-shadow:0 0 0 .5px rgba(0,0,0,.7),inset 0 0 0 1px rgba(255,255,255,.1),0 40px 80px -22px rgba(0,0,0,.65);overflow:hidden;backdrop-filter:blur(40px) saturate(150%);-webkit-backdrop-filter:blur(40px) saturate(150%);transition:box-shadow .5s ease}
.pd-win.waiting{box-shadow:0 0 0 .5px rgba(0,0,0,.7),inset 0 0 0 1px rgba(250,201,97,.55),0 0 0 4px rgba(250,201,97,.12),0 40px 80px -22px rgba(0,0,0,.65),0 0 60px -10px rgba(250,201,97,.35)}
.pd-win.answered{box-shadow:0 0 0 .5px rgba(0,0,0,.7),inset 0 0 0 1px rgba(97,204,140,.55),0 0 0 4px rgba(97,204,140,.12),0 40px 80px -22px rgba(0,0,0,.65),0 0 60px -10px rgba(97,204,140,.35)}
.pd-winbar{position:relative;height:32px;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:550;color:rgba(255,255,255,.55);border-bottom:1px solid rgba(255,255,255,.06);background:rgba(255,255,255,.03)}
.pd-wt{display:flex;align-items:center;gap:7px}
.pd-wicon{width:15px;height:15px;display:block}
.pd-wicon svg{width:100%;height:100%;display:block}
.pd-wdot{width:7px;height:7px;border-radius:50%;background:var(--amber);box-shadow:0 0 8px var(--amber);transform:scale(0);transition:transform .35s var(--ease)}
.pd-win.waiting .pd-wdot{transform:scale(1)}
.pd-traffic{position:absolute;left:13px;top:10px;display:flex;gap:8px}
.pd-traffic i{width:12px;height:12px;border-radius:50%;background:#ff5f57;box-shadow:inset 0 0 0 .5px rgba(0,0,0,.25)}
.pd-traffic i:nth-child(2){background:#febc2e}.pd-traffic i:nth-child(3){background:#28c840}
.pd-claude{left:44px;top:50px;width:576px;height:334px;z-index:3}
.pd-codex{left:156px;top:400px;width:500px;height:214px;z-index:4}
.pd-tbody{padding:12px 16px 12px;font:12.5px/1.65 var(--mono);color:rgba(236,236,236,.86);height:calc(100% - 32px);display:flex;flex-direction:column;overflow:hidden}
.pd-tbody>[data-term]{flex:1 1 0;display:flex;flex-direction:column;min-height:0;overflow:hidden}
.pd-tbody>[data-term]>:first-child{margin-top:auto}
.pd-banner{align-self:flex-start;border:1px solid rgba(229,135,106,.5);border-radius:8px;padding:6px 14px;display:flex;flex-direction:column;font-size:12px;flex:none}
.pd-banner b{font-weight:600;color:#fff}
.pd-banner small{color:var(--t3);font-size:11.5px}
.pd-cbanner{flex:none}
.pd-tbody .o{color:#E5876A}.pd-tbody .g,.pd-l .g{color:rgba(255,255,255,.36)}.pd-l .ok{color:var(--green)}.pd-l b{color:#fff;font-weight:600}.pd-l .y,.pd-l.q{color:var(--amber)}.pd-l .b{color:#8fb0ff}
.pd-l{white-space:pre-wrap;animation:pd-in .35s ease both}
.pd-l.p{color:#fff;margin-top:6px}
.pd-l.s{color:#fff;margin-top:4px}
.pd-l.q{margin-top:4px}
.pd-l.opt{color:rgba(255,255,255,.75)}
.pd-working{display:none;margin-top:4px;flex:none}
.pd-working.on{display:block}
.pd-input{flex:none;margin-top:8px;padding:5px 10px;border-radius:7px;border:1px solid rgba(255,255,255,.14);color:#fff;min-height:30px}
.pd-shimmer{background:linear-gradient(90deg,#E5876A 0,#ffd0bc 50%,#E5876A 100%) 0 0/200% 100%;-webkit-background-clip:text;background-clip:text;color:transparent;animation:pd-shim 1.6s linear infinite}
.pd-shimmer.b{background-image:linear-gradient(90deg,#8fb0ff 0,#e2eaff 50%,#8fb0ff 100%)}
.pd-caret-t{display:inline-block;width:7px;height:14px;background:rgba(255,255,255,.7);vertical-align:-2px;animation:pd-blink 1s steps(1) infinite}

.pd-dock{position:absolute;left:50%;bottom:8px;transform:translateX(-50%);display:flex;align-items:flex-end;gap:7px;padding:6px 8px 8px;border-radius:20px;background:rgba(255,255,255,.16);box-shadow:inset 0 0 0 1px rgba(255,255,255,.24),0 10px 30px rgba(0,0,0,.25);backdrop-filter:blur(24px) saturate(170%);-webkit-backdrop-filter:blur(24px) saturate(170%);z-index:6}
.pd-dock>span{position:relative;width:46px;height:46px;display:block}
.pd-dock>span>svg,.pd-dock img{width:46px;height:46px;display:block;filter:drop-shadow(0 3px 5px rgba(0,0,0,.25))}
.pd-dock>span.on:after{content:'';position:absolute;left:50%;bottom:-6px;width:4px;height:4px;margin-left:-2px;border-radius:50%;background:rgba(255,255,255,.75)}
.pd-dsep{width:1px;height:40px;align-self:center;background:rgba(255,255,255,.3)}

/* Perch marks */
.pd-mk{position:relative;display:block;width:20px;height:20px;flex:none}
.pd-mk.work:before{content:'';position:absolute;inset:1px;border-radius:50%;border:2.6px solid rgba(255,255,255,.16);border-top-color:var(--blue);border-right-color:var(--blue);animation:pd-spin .9s linear infinite}
.pd-mk.needs:before{content:'';position:absolute;inset:3.5px;border-radius:50%;background:radial-gradient(circle at 38% 32%,#ffe6a6,var(--amber) 64%);box-shadow:0 0 0 .5px rgba(0,0,0,.25),0 0 7px rgba(250,201,97,.4);animation:pd-pulse 1.2s ease-in-out 4}
.pd-mk.done svg{position:absolute;inset:2px;width:16px;height:16px;fill:none;stroke:var(--green);stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round;stroke-dasharray:20;animation:pd-draw .5s ease both}

.pd-tab{position:absolute;right:0;top:250px;width:30px;padding:14px 0;display:flex;flex-direction:column;align-items:center;gap:12px;background:#000;border-radius:13px 0 0 13px;z-index:12;transition:transform .45s var(--ease),width .3s ease,gap .3s ease,filter .4s ease}
.pd-tab:before,.pd-tab:after{content:'';position:absolute;right:0;width:13px;height:13px}
.pd-tab:before{top:-13px;background:radial-gradient(circle at 0 0,transparent 12.5px,#000 13px)}
.pd-tab:after{bottom:-13px;background:radial-gradient(circle at 0 100%,transparent 12.5px,#000 13px)}
.pd-stage.hover .pd-tab{width:34px;gap:20px}
.pd-stage.nudge .pd-tab{transform:translateX(-8px);filter:drop-shadow(0 0 14px rgba(250,201,97,.7))}
.pd-stage.finish .pd-tab{filter:drop-shadow(0 0 14px rgba(97,204,140,.65))}
.pd-stage.shelf-open .pd-tab{transform:translateX(110%)}
.pd-labels{position:absolute;right:46px;top:264px;z-index:11;display:flex;flex-direction:column;align-items:flex-end;gap:8px;pointer-events:none}
.pd-labels span{--c:255,255,255;display:flex;gap:8px;align-items:center;height:32px;padding:0 13px;border-radius:999px;font-size:13.5px;font-weight:650;white-space:nowrap;background:linear-gradient(rgba(var(--c),.14),rgba(var(--c),.14)),rgba(30,30,32,.86);box-shadow:inset 0 0 0 1px rgba(var(--c),.38),0 6px 16px rgba(0,0,0,.25);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);opacity:0;transform:translateX(12px);transition:opacity .3s ease,transform .4s var(--ease)}
.pd-labels span:nth-child(2){transition-delay:.04s}.pd-labels span:nth-child(3){transition-delay:.08s}
.pd-labels span em{font-style:normal;font-weight:550;color:rgb(var(--c))}
.pd-labels .needs{--c:250,201,97}.pd-labels .work{--c:94,143,250}.pd-labels .done{--c:97,204,140}
.pd-stage.hover .pd-labels span{opacity:1;transform:none}
.pd-digest{position:absolute;right:46px;top:290px;z-index:11;display:flex;align-items:center;gap:8px;height:34px;padding:0 15px;border-radius:999px;font-size:14px;font-weight:650;background:linear-gradient(rgba(97,204,140,.16),rgba(97,204,140,.16)),rgba(30,30,32,.88);box-shadow:inset 0 0 0 1px rgba(97,204,140,.4),0 8px 20px rgba(0,0,0,.3);backdrop-filter:blur(16px);-webkit-backdrop-filter:blur(16px);opacity:0;transform:translateX(14px);transition:opacity .35s ease,transform .45s var(--ease)}
.pd-digest em{font-style:normal;color:var(--green);font-weight:550}
.pd-digest svg{width:14px;height:14px;fill:none;stroke:var(--green);stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round}
.pd-stage.digest .pd-digest{opacity:1;transform:none}

/* Shelf: rail + card */
.pd-shelf{position:absolute;inset:0;z-index:14;pointer-events:none}
.pd-rail{position:absolute;right:12px;top:48px;width:48px;display:flex;flex-direction:column;gap:10px;align-items:center}
.pd-rail>span{display:flex;flex-direction:column;align-items:center;background:rgba(30,30,33,.9);box-shadow:inset 0 0 0 1px rgba(255,255,255,.1),0 8px 20px rgba(0,0,0,.35);backdrop-filter:blur(24px);-webkit-backdrop-filter:blur(24px);opacity:0;transform:translateX(30px);transition:opacity .3s ease,transform .45s var(--ease)}
.pd-rail>span:nth-child(2){transition-delay:.035s}.pd-rail>span:nth-child(3){transition-delay:.07s}.pd-rail>span:nth-child(4){transition-delay:.105s}
.pd-stage.shelf-open .pd-rail>span{opacity:1;transform:none}
.pd-rinbox{position:relative;width:48px;height:48px;border-radius:50%;justify-content:center}
.pd-rinbox.sel{box-shadow:inset 0 0 0 2px rgba(255,255,255,.55),0 8px 20px rgba(0,0,0,.35)}
.pd-rinbox svg{width:22px;height:22px}
.pd-rinbox b{position:absolute;top:-5px;right:-5px;min-width:20px;height:20px;border-radius:10px;background:var(--amber);color:#1c1406;font-size:12px;font-weight:700;display:grid;place-items:center;box-shadow:0 0 0 2px #1f1f22,0 0 8px rgba(250,201,97,.4);transition:transform .3s cubic-bezier(.3,1.5,.5,1)}
.pd-rinbox b.zero{transform:scale(0)}
.pd-rsess,.pd-rnotes{border-radius:24px;padding:6px 0;gap:4px}
.pd-rsess>span,.pd-rnotes>span{width:36px;height:36px;border-radius:50%;display:grid;place-items:center;transition:background .25s ease}
.pd-rsess>span.sel,.pd-rnotes>span.sel{background:rgba(255,255,255,.09);box-shadow:inset 0 0 0 .5px rgba(255,255,255,.14)}
.pd-rnotes svg{width:19px;height:19px}
.pd-rdiv{width:22px;height:1px;background:rgba(255,255,255,.1);margin:4px 0}
.pd-minote{width:17px;height:19px;border-radius:3.5px;background:#FAE39E;position:relative}
.pd-minote:before,.pd-minote:after{content:'';position:absolute;left:4px;height:1.6px;border-radius:1px;background:rgba(0,0,0,.18)}
.pd-minote:before{top:6px;width:9px}.pd-minote:after{top:10px;width:7px}
.pd-rail>.pd-rmore{width:48px;height:48px;border-radius:50%;flex-direction:row;justify-content:center;gap:4px}
.pd-rmore i{width:4px;height:4px;border-radius:50%;background:rgba(255,255,255,.85)}
.pd-i{fill:none;stroke:currentColor;stroke-width:1.6;stroke-linecap:round;stroke-linejoin:round}

.pd-col{position:absolute;right:70px;top:48px;width:364px;display:flex;flex-direction:column;align-items:center;gap:12px;transition:transform .45s var(--ease)}
.pd-card{--py:24px;position:relative;width:100%;border-radius:24px;background:rgba(34,34,37,.88);box-shadow:inset 0 1px 0 rgba(255,255,255,.09),inset 0 0 0 1px rgba(255,255,255,.1),0 40px 70px -16px rgba(0,0,0,.6);backdrop-filter:blur(36px) saturate(150%);-webkit-backdrop-filter:blur(36px) saturate(150%);opacity:0;transform:scale(.9);transform-origin:100% var(--py);transition:opacity .28s ease,transform .45s var(--ease);pointer-events:auto}
.pd-stage.shelf-open .pd-card{opacity:1;transform:none}
.pd-stage:not(.shelf-open) .pd-card,.pd-stage:not(.shelf-open) .pd-pill{pointer-events:none}
.pd-ptr{position:absolute;right:-7px;top:calc(var(--py) - 7px);width:14px;height:14px;border-radius:3px;background:rgb(36,36,39);box-shadow:inset -1px 1px 0 rgba(255,255,255,.1);transform:rotate(45deg);transition:top .45s var(--ease)}
.pd-cbody2{position:relative;padding:18px;overflow:hidden;box-sizing:border-box;transition:height .42s cubic-bezier(.32,.72,.24,1)}
.pd-enter{animation:pd-in .38s cubic-bezier(.2,.8,.2,1) both}
.pd-head{display:flex;align-items:center;gap:4px;margin-bottom:14px}
.pd-head h4{flex:1;min-width:0;margin:0;font-size:19px;font-weight:650;letter-spacing:-.02em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.pd-head h4.big{font-size:23px}
.pd-btn{width:28px;height:28px;display:grid;place-items:center;color:var(--t2);flex:none}
.pd-btn svg{width:16px;height:16px}
.pd-dots{display:flex;gap:4px;align-items:center;margin-right:4px}
.pd-dots i{width:5px;height:5px;border-radius:3px;background:rgba(255,255,255,.28);transition:width .3s ease}
.pd-dots i.on{width:18px}
.pd-dots i.amber{background:var(--amber)}.pd-dots i.green{background:var(--green)}
.pd-who{display:flex;gap:12px;align-items:center;margin-bottom:14px}
.pd-who strong{display:block;font-size:14.5px;font-weight:650;letter-spacing:-.01em}
.pd-who span{font-size:13px}
.pd .amber{color:var(--amber)}.pd .blue{color:var(--blue)}.pd .green{color:var(--green)}
.pd-t3{color:var(--t3)}
.pd-av{position:relative;width:36px;height:36px;flex:none}
.pd-av svg{width:100%;height:100%;display:block}
.pd-av.big{width:42px;height:42px}
.pd-badge{position:absolute;right:-3px;bottom:-3px;width:12px;height:12px;border-radius:50%;box-shadow:0 0 0 2.5px rgb(36,36,39)}
.pd-badge.amber{background:var(--amber)}.pd-badge.blue{background:var(--blue)}.pd-badge.green{background:var(--green)}
.pd-cbody2 h5{margin:0 0 4px;font-size:16.5px;font-weight:650;letter-spacing:-.015em;line-height:1.3}
.pd-sub{margin:0 0 10px;font-size:13.5px;color:var(--t2)}
.pd-code{font:12.5px/1.5 var(--mono);background:rgba(0,0,0,.32);border:1px solid rgba(255,255,255,.06);border-radius:12px;padding:9px 12px;margin-bottom:14px}
.pd-code span{color:var(--t3)}
.pd-primary{position:relative;isolation:isolate;width:100%;display:flex;align-items:center;gap:12px;height:50px;padding:0 9px;border-radius:16px;background:linear-gradient(180deg,rgba(97,204,140,.2),rgba(97,204,140,.1));box-shadow:inset 0 0 0 1px rgba(97,204,140,.42),inset 0 1px 0 rgba(255,255,255,.07);font-size:15.5px;font-weight:600;letter-spacing:-.01em;overflow:hidden;transition:transform .16s cubic-bezier(.3,.7,.4,1),background .2s ease,box-shadow .2s ease}
.pd-primary:hover{background:linear-gradient(180deg,rgba(97,204,140,.26),rgba(97,204,140,.14))}
.pd-primary:before{content:'';position:absolute;inset:0;z-index:-1;border-radius:inherit;background:linear-gradient(90deg,rgba(97,204,140,.08),rgba(97,204,140,.24));transform-origin:0 50%;transform:scaleX(0)}
.pd-pi{flex:none;width:32px;height:32px;border-radius:9px;display:grid;place-items:center;background:linear-gradient(180deg,#8be3ae,#5cc78b);color:#0d2c1a;box-shadow:inset 0 1px 0 rgba(255,255,255,.45),inset 0 -1px 0 rgba(0,0,0,.12),0 1px 2px rgba(0,0,0,.25)}
.pd-pi svg{width:17px;height:17px}
.pd-pl{flex:1;text-align:left;transition:opacity .2s ease}
.pd-primary kbd{flex:none;min-width:30px;height:26px;padding:0 6px;border-radius:8px;display:grid;place-items:center;font-size:11.5px;font-weight:600;letter-spacing:.01em;background:rgba(97,204,140,.16);box-shadow:inset 0 0 0 1px rgba(97,204,140,.38),inset 0 -1.5px 0 rgba(0,0,0,.22);color:#a8e8c1;transition:background .2s ease}
.pd-primary kbd svg{width:14px;height:14px}
.pd-primary kbd .esc{display:none}
/* Sending: a soft fill sweeps across the button for the two-second undo window,
   and the keycap turns into the key that takes it back. */
.pd-card.sending .pd-primary:before{animation:pd-fill 2s linear forwards}
.pd-card.sending .pd-primary kbd svg{display:none}
.pd-card.sending .pd-primary kbd .esc{display:inline}
.pd-card.sending .pd-acts,.pd-card.sending .pd-opt:not(.chosen),.pd-card.sending .pd-field{opacity:.45;transition:opacity .3s ease}
.pd-acts{display:flex;flex-wrap:wrap;gap:8px;margin-top:10px}
.pd-sec{display:inline-flex;align-items:center;gap:8px;height:32px;padding:0 13px 0 5px;border-radius:999px;background:rgba(255,255,255,.06);box-shadow:inset 0 0 0 1px rgba(255,255,255,.05);font-size:13.5px;font-weight:500;color:rgba(255,255,255,.84);transition:background .2s ease,transform .16s cubic-bezier(.3,.7,.4,1)}
.pd-sec:hover{background:rgba(255,255,255,.1)}
.pd-sec kbd,.pd-opt kbd{flex:none;min-width:22px;height:22px;border-radius:7px;display:grid;place-items:center;font-size:12px;font-weight:600;font-variant-numeric:tabular-nums;background:rgba(255,255,255,.09);box-shadow:inset 0 0 0 .5px rgba(255,255,255,.08),inset 0 -1.5px 0 rgba(0,0,0,.35);color:rgba(255,255,255,.6);transition:background .2s ease,color .2s ease}
.pressed{transform:scale(.975)}
.pd-chip-l{margin:0 0 4px;font-size:11.5px;font-weight:700;letter-spacing:.09em;text-transform:uppercase;color:var(--amber)}
.pd-opts{display:flex;flex-direction:column;gap:7px;margin:12px 0}
.pd-opt{display:flex;align-items:center;gap:13px;width:100%;min-height:46px;padding:8px 13px;border-radius:14px;background:var(--raised);text-align:left;transition:background .2s ease,box-shadow .2s ease,transform .12s ease}
.pd-opt:hover{background:rgba(255,255,255,.09)}
.pd-opt b{display:block;font-size:14.5px;font-weight:600}
.pd-opt small{display:block;font-size:12.5px;color:var(--t2);margin-top:1px}
.pd-opt.chosen{background:rgba(97,204,140,.13);box-shadow:inset 0 0 0 1.5px rgba(97,204,140,.45)}
.pd-opt.chosen kbd{background:#6fd497;color:#10301d;font-size:0}
.pd-opt.chosen kbd:before{content:'';width:10px;height:6px;border:solid #10301d;border-width:0 0 2.2px 2.2px;transform:translateY(-1px) rotate(-45deg)}
.pd-field{display:flex;gap:8px;align-items:center;margin-top:4px}
.pd-field input{flex:1;min-width:0;height:40px;border-radius:12px;border:1px solid rgba(255,255,255,.14);background:rgba(255,255,255,.04);color:var(--t1);font:14px var(--sys);padding:0 13px;outline:none;user-select:text;transition:border-color .2s ease}
.pd-field input:focus{border-color:rgba(250,201,97,.6)}
.pd-field input::placeholder{color:var(--t2)}
.pd-send{width:36px;height:36px;border-radius:50%;background:rgba(255,255,255,.08);color:var(--t2);display:grid;place-items:center;flex:none;transition:background .2s ease,color .2s ease}
.pd-send.ready{background:var(--amber);color:#2a1d05}
.pd-send svg{width:16px;height:16px}
.pd-said{background:rgba(0,0,0,.28);border-radius:14px;padding:11px 13px;margin:8px 0 12px;font-size:14px;line-height:1.45}
.pd-said small{display:block;font-size:12px;font-weight:650;color:var(--t3);margin-bottom:4px}
.pd-chips{display:flex;gap:6px;margin:-6px 0 12px}
.pd-chip{height:27px;padding:0 11px;border-radius:999px;display:inline-flex;align-items:center;font-size:13.5px;font-weight:550}
.pd-chip.amber{background:rgba(250,201,97,.14)}.pd-chip.blue{background:rgba(94,143,250,.16)}
.pd-sect{display:flex;justify-content:space-between;margin:12px 0 6px;font-size:13.5px;font-weight:650;color:var(--t2)}
.pd-row{display:flex;align-items:center;gap:12px;width:calc(100% + 16px);margin:0 -8px 2px;padding:8px;border-radius:14px;text-align:left;transition:background .2s ease,transform .12s ease}
.pd-row:hover{background:var(--raised)}
.pd-row.needs{background:rgba(250,201,97,.07)}
.pd-rt{flex:1;min-width:0}
.pd-rt b{display:block;font-size:14.5px;font-weight:650;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.pd-rt small{display:block;font-size:12.5px;color:var(--t2);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.pd-rt small.amber{color:var(--amber)}
.pd-when{font-size:12.5px;color:var(--t3)}
.pd-row>svg{width:13px;height:13px;color:var(--t3)}
.pd-copy{display:inline-flex;align-items:center;gap:6px;height:28px;padding:0 10px;border-radius:999px;background:var(--raised);font-size:13px;color:rgba(255,255,255,.85);margin-right:4px}
.pd-copy svg{width:13px;height:13px}
.pd-paper{position:relative;min-height:170px;border-radius:18px;background:#F6E2A0;color:#2b2617;padding:12px 18px 18px;box-shadow:inset 0 -1px 0 rgba(0,0,0,.08)}
.pd-paper small{display:block;text-align:center;font-size:11.5px;font-weight:550;color:rgba(0,0,0,.34);margin-bottom:8px}
.pd-paper [data-note-text]{font-size:16px;line-height:1.45;white-space:pre-wrap;display:inline}
.pd-paper .pd-caret{display:inline-block;width:1.5px;height:18px;background:#b8860b;vertical-align:-3px;margin-left:1px;animation:pd-blink 1s steps(1) infinite}
.pd-swatches{display:flex;align-items:center;gap:12px;margin-top:14px}
.pd-swatches i{width:22px;height:22px;border-radius:50%}
.pd-swatches .on{box-shadow:0 0 0 2px rgb(36,36,39),0 0 0 3.5px rgba(255,255,255,.85)}
.pd-swatches .butter{background:#FAE39E}.pd-swatches .rose{background:#F5C4C4}.pd-swatches .sage{background:#C4DEBD}.pd-swatches .sky{background:#BDD9F2}
.pd-swatches span{margin-left:auto;font-size:12.5px;color:var(--t2)}

/* The pill under the card: a key hint, then Sending + Undo, then a receipt. */
.pd-pill{position:relative;display:flex;align-items:center;gap:8px;height:38px;padding:0 15px;border-radius:999px;font-size:13.5px;font-weight:550;color:rgba(255,255,255,.88);background:rgba(26,26,29,.88);box-shadow:inset 0 0 0 1px rgba(255,255,255,.1),0 12px 26px rgba(0,0,0,.35);backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);overflow:hidden;white-space:nowrap;opacity:0;transform:translateY(-8px) scale(.96);transition:opacity .25s ease,transform .4s var(--ease);pointer-events:auto}
.pd-pill.show{opacity:1;transform:none}
.pd-pill kbd{min-width:22px;height:22px;padding:0 5px;border-radius:6px;display:grid;place-items:center;font-size:12px;font-weight:650;background:linear-gradient(#45454b,#2f2f34);box-shadow:inset 0 1px 0 rgba(255,255,255,.14),0 2px 0 #111;color:#fff;transition:transform .12s ease,background .15s ease,box-shadow .12s ease}
.pd-pill kbd svg{width:13px;height:13px}
.pd-pill kbd.hit{transform:translateY(2px);background:var(--amber);color:#2a1d05;box-shadow:0 0 0 #111,0 0 14px rgba(250,201,97,.7)}
.pd-pill .mute{color:var(--t2);font-weight:500}
.pd-pill.ok{background:linear-gradient(rgba(97,204,140,.15),rgba(97,204,140,.15)),rgba(26,26,29,.9);box-shadow:inset 0 0 0 1px rgba(97,204,140,.4),0 12px 26px rgba(0,0,0,.35)}
.pd-pill.ok svg{width:15px;height:15px;fill:none;stroke:var(--green);stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round}
.pd-pill.undo{padding-right:5px}
.pd-pill button{height:28px;padding:0 12px;border-radius:999px;background:rgba(255,255,255,.12);font-size:13px;font-weight:650}
.pd-pill button:hover{background:rgba(255,255,255,.2)}
.pd-pill>i{position:absolute;left:0;bottom:0;height:2px;width:100%;background:var(--amber);transform-origin:0 0;animation:pd-drain 2s linear forwards}

.pd-mouse{position:absolute;left:0;top:0;width:24px;height:24px;z-index:40;pointer-events:none;opacity:0;transform:translate(560px,520px);transition-property:transform,opacity;transition-timing-function:cubic-bezier(.45,.05,.2,1),ease;transition-duration:.8s,.3s;filter:drop-shadow(0 2px 3px rgba(0,0,0,.35))}
.pd-mouse.on{opacity:1}
.pd-mouse.down path{transform:scale(.86);transform-origin:5px 3px}

/* Compact (phone) scene */
.pd-stage.compact{width:460px;height:640px}
.pd-stage.compact .pd-mi{display:none}
.pd-stage.compact .pd-claude{left:12px;top:42px;width:404px;height:330px}
.pd-stage.compact .pd-codex{left:12px;top:390px;width:404px;height:170px}
.pd-stage.compact .pd-dock>span:nth-child(1){display:none}
.pd-stage.compact .pd-tab{top:200px}
.pd-stage.compact .pd-labels{top:214px;right:44px}
.pd-stage.compact .pd-digest{top:236px}

/* Story player */
.pd-story{display:flex;align-items:center;justify-content:center;gap:10px;margin:30px auto 0;max-width:100%}
.pd-play{flex:none;width:44px;height:44px;border-radius:50%;border:0;display:grid;place-items:center;background:rgba(255,255,255,.08);box-shadow:inset 0 0 0 1px rgba(255,255,255,.1);color:#fff;transition:background .2s ease}
.pd-play:hover{background:rgba(255,255,255,.14)}
.pd-play svg{width:16px;height:16px;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
.pd-chapters{position:relative;display:flex;gap:4px;padding:4px;border-radius:999px;background:rgba(255,255,255,.06);box-shadow:inset 0 0 0 1px rgba(255,255,255,.08);overflow-x:auto;scrollbar-width:none}
.pd-chapters::-webkit-scrollbar{display:none}
.pd-chapters button{position:relative;flex:none;overflow:hidden;border:0;border-radius:999px;height:36px;padding:0 17px;background:transparent;color:rgba(255,255,255,.55);font-size:14px;font-weight:500;letter-spacing:-.01em;transition:color .25s ease,background .25s ease;white-space:nowrap}
.pd-chapters button:hover{color:#fff}
.pd-chapters button span{position:relative}
.pd-chapters button i{position:absolute;left:0;top:0;bottom:0;width:100%;transform-origin:0 0;transform:scaleX(0);background:rgba(255,255,255,.1)}
.pd-chapters button[aria-current=true]{color:#fff;background:rgba(255,255,255,.08)}

@keyframes pd-in{from{opacity:0;transform:translateY(6px)}to{opacity:1;transform:none}}
@keyframes pd-spin{to{transform:rotate(360deg)}}
@keyframes pd-pulse{50%{transform:scale(1.18);box-shadow:0 0 0 .5px rgba(0,0,0,.25),0 0 12px rgba(250,201,97,.7)}}
@keyframes pd-fill{from{transform:scaleX(0)}to{transform:scaleX(1)}}
@keyframes pd-draw{from{stroke-dashoffset:20}to{stroke-dashoffset:0}}
@keyframes pd-shim{to{background-position:-200% 0}}
@keyframes pd-blink{50%{opacity:0}}
@keyframes pd-drain{from{transform:scaleX(1)}to{transform:scaleX(0)}}
@media(max-width:760px){
  .pd-frame{border-radius:16px;box-shadow:0 0 0 1px rgba(255,255,255,.1),0 40px 80px -30px rgba(0,0,0,.9)}
  .pd-story{justify-content:flex-start}
  .pd-chapters button{padding:0 13px;font-size:13px}
}
</style>

<script>
  import { providerIcons as P } from './icons';

  type State = 'work' | 'needs' | 'done';
  type Key = 'claude' | 'codex' | 'cursor';
  type Term = 'claude' | 'codex';
  type Line = [kind: string, text: string];

  const CANCEL = Symbol('cancel');
  const ic = {
    back: '<svg class="pd-i" viewBox="0 0 16 16"><path d="M10 3 5 8l5 5"/></svg>',
    close: '<svg class="pd-i" viewBox="0 0 16 16"><path d="M4 4l8 8M12 4l-8 8"/></svg>',
    pencil: '<svg class="pd-i" viewBox="0 0 16 16"><path d="M3 13l.8-3L11 2.8 13.2 5 6 12.2Z"/></svg>',
    gear: '<svg class="pd-i" viewBox="0 0 16 16"><circle cx="8" cy="8" r="2.2"/><path d="M8 1.8v1.6M8 12.6v1.6M1.8 8h1.6M12.6 8h1.6M3.6 3.6l1.1 1.1M11.3 11.3l1.1 1.1M3.6 12.4l1.1-1.1M11.3 4.7l1.1-1.1"/></svg>',
    check: '<svg class="pd-i" viewBox="0 0 16 16" style="stroke-width:2.4"><path d="M3.5 8.5l3 3 6-7"/></svg>',
    enter: '<svg class="pd-i" viewBox="0 0 16 16" style="stroke-width:1.8"><path d="M12.5 3.5v4a2 2 0 0 1-2 2h-7M6 6.5l-3 3 3 3"/></svg>',
    up: '<svg class="pd-i" viewBox="0 0 16 16" style="stroke-width:2"><path d="M8 13V3M4 7l4-4 4 4"/></svg>',
    chev: '<svg class="pd-i" viewBox="0 0 16 16" style="stroke-width:2"><path d="M6 3l5 5-5 5"/></svg>',
    pin: '<svg class="pd-i" viewBox="0 0 16 16"><path d="M6 2h4l-.6 4 2.6 2.5H4L6.6 6Z M8 8.5V14"/></svg>',
    trash: '<svg class="pd-i" viewBox="0 0 16 16"><path d="M3 4.5h10M6.5 4.5V3h3v1.5M4.5 4.5l.7 9h5.6l.7-9"/></svg>',
    copy: '<svg class="pd-i" viewBox="0 0 16 16"><rect x="5" y="5" width="8.5" height="8.5" rx="2"/><path d="M11 5V3.5A1.5 1.5 0 0 0 9.5 2h-6A1.5 1.5 0 0 0 2 3.5v6A1.5 1.5 0 0 0 3.5 11H5"/></svg>',
    tick: '<svg viewBox="0 0 16 16"><path d="M3.5 8.5l3 3 6-7"/></svg>',
  };

  const root = document.querySelector<HTMLElement>('[data-demo]');
  if (root) init(root);

  function init(root: HTMLElement) {
    const q = <T extends Element = HTMLElement>(s: string) => root.querySelector<T>(s) as T;
    const frame = q('[data-frame]'), stage = q('[data-stage]');
    const card = q('[data-card]'), body = q('[data-card-body]'), pill = q('[data-pill]'), col = q('[data-col]');
    const mouse = q('[data-mouse]'), digest = q('[data-digest]'), tab = q('[data-tab]');
    const playBtn = q<HTMLButtonElement>('[data-play]');
    const chapterButtons = [...root.querySelectorAll<HTMLButtonElement>('[data-chapter]')];
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Scale the fixed-size scene to the frame; phones get a tighter scene around the shelf.
    const fit = () => {
      const width = frame.clientWidth, compact = width < 760;
      stage.classList.toggle('compact', compact);
      const [w, h] = compact ? [460, 640] : [1120, 700];
      const scale = width / w;
      stage.style.setProperty('--s', String(scale));
      frame.style.height = `${h * scale}px`;
    };
    new ResizeObserver(fit).observe(frame);
    fit();

    // Real local time in the menu bar and on the note.
    const clock = q('[data-clock]');
    const now = () => new Date().toLocaleTimeString([], { hour: 'numeric', minute: '2-digit' });
    const tickClock = () => { clock.textContent = `${new Date().toLocaleDateString([], { weekday: 'short' })} ${now()}`; };
    tickClock(); setInterval(tickClock, 20000);

    // ---------- Sessions ----------
    const sessions: Record<Key, { name: string; provider: string; folder: string; icon: string; state: State; status: string; ask: string }> = {
      claude: { name: 'Pricing page', provider: 'Claude Code', folder: 'pricing-page', icon: P.claude, state: 'work', status: 'Editing files', ask: '' },
      codex: { name: 'Stripe checkout', provider: 'Codex', folder: 'checkout', icon: P.codex, state: 'work', status: 'Editing files', ask: '' },
      cursor: { name: 'Research notes', provider: 'Cursor', folder: 'research-notes', icon: P.cursor, state: 'work', status: 'Thinking', ask: '' },
    };
    const keys: Key[] = ['claude', 'codex', 'cursor'];
    const tone = (s: State) => (s === 'needs' ? 'amber' : s === 'work' ? 'blue' : 'green');
    const said = (k: Key) => { const s = sessions[k]; return s.state === 'needs' ? 'Waiting for you' : s.state === 'done' ? 'Turn finished' : s.status; };

    function setMark(el: HTMLElement, state: State) {
      if (el.dataset.state === state) return;
      el.dataset.state = state;
      el.className = `pd-mk ${state}`;
      el.innerHTML = state === 'done' ? ic.tick : '';
    }
    function setS(k: Key, state: State, extra: { status?: string; ask?: string } = {}) {
      Object.assign(sessions[k], { state }, extra);
      if (k !== 'cursor') {
        const win = q(`[data-win=${k}]`);
        win.classList.toggle('waiting', state === 'needs');
        if (state !== 'needs') win.classList.remove('answered');
      }
      paint();
    }
    function paint() {
      for (const k of keys) {
        setMark(q(`[data-mark=${k}]`), sessions[k].state);
        setMark(q(`[data-rmark=${k}]`), sessions[k].state);
        const label = q(`[data-label=${k}]`);
        label.className = sessions[k].state;
        label.innerHTML = `${sessions[k].name} <em>${said(k)}</em>`;
      }
      const waiting = keys.filter(k => sessions[k].state === 'needs').length;
      stage.classList.toggle('alert', waiting > 0);
      const badge = q('[data-badge]');
      if (waiting) badge.textContent = String(waiting);
      badge.classList.toggle('zero', !waiting);
    }
    function flashAnswered(k: Term) {
      const win = q(`[data-win=${k}]`);
      win.classList.remove('waiting'); win.classList.add('answered');
      window.setTimeout(() => win.classList.remove('answered'), 1400);
    }

    // ---------- Terminals ----------
    const term = (k: Term) => q(`[data-term=${k}]`);
    const esc = (t: string) => t.replace(/[&<>]/g, c => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]!));
    function lineHTML([kind, text]: Line) {
      const t = esc(text);
      switch (kind) {
        case 'p': return `<span class="g">›</span> ${t}`;
        case 'c': { const i = t.indexOf('('); return `<span class="o">⏺</span> ${i > 0 ? `<b>${t.slice(0, i)}</b>${t.slice(i)}` : `<b>${t}</b>`}`; }
        case 's': return `<span style="color:#fff">⏺</span> ${t}`;
        case 'r': return `<span class="g">  ⎿  </span>${t}`;
        case 'y': return `<span class="g">  ⎿  </span><span class="y">${t}</span>`;
        case 'ok': return `<span class="g">  ⎿  </span><span class="ok">✓ ${t}</span>`;
        case 'q': return `? ${t}`;
        case 'opt': return `   ${t}`;
        case 'x': return `<span class="g">• </span>${t}`;
        case 'xb': return `<span class="b">• </span>${t}`;
        case 'xy': return `<span class="y">• ${t}</span>`;
        case 'xok': return `<span class="ok">✓ ${t}</span>`;
        default: return t;
      }
    }
    function put(k: Term, line: Line) {
      const el = document.createElement('div');
      el.className = `pd-l ${line[0]}`;
      el.innerHTML = lineHTML(line);
      term(k).append(el);
      fitTerm(k);
      return el;
    }
    // Drop the oldest lines that no longer fit. Sums layout heights, since the
    // lines' slide-in transform would inflate scrollHeight; the first line's
    // auto top margin is the free space, so it is left out.
    function fitTerm(k: Term) {
      const box = term(k);
      const used = () => [...box.children].reduce((sum, child, i) => sum + (child as HTMLElement).offsetHeight + (i ? parseFloat(getComputedStyle(child).marginTop) : 0), 0);
      while (box.children.length > 1 && used() > box.clientHeight + 1) box.firstElementChild!.remove();
    }
    const working = (k: Term, on: boolean) => { q(`[data-working=${k}]`).classList.toggle('on', on); fitTerm(k); };
    async function typePrompt(k: Term, text: string, speed = 24) {
      const field = q(`[data-input-text=${k}]`);
      field.textContent = '';
      for (const ch of text) { field.textContent += ch; await sleep(speed); }
      await sleep(220);
      field.textContent = '';
      put(k, ['p', text]);
    }

    const claudeIntro: Line[] = [['p', 'Add a monthly / yearly toggle to the pricing page'], ['c', 'Read(src/pages/pricing.tsx)'], ['c', 'Update(src/components/PricingToggle.tsx)'], ['r', 'Updated with 24 additions and 3 removals']];
    const codexIntro: Line[] = [['p', 'Add Stripe checkout to the pricing page'], ['x', 'Explored routes/checkout.ts'], ['xb', 'Edited routes/checkout.ts (+38 −4)']];
    const question: Line[] = [['q', 'Which billing periods should the toggle offer?'], ['opt', '1. Monthly and yearly'], ['opt', '2. Yearly only'], ['opt', '3. Monthly only'], ['y', 'Running PermissionRequest hook…']];
    const options: [string, string][] = [['Monthly and yearly', 'Yearly shows the 20% saving'], ['Yearly only', ''], ['Monthly only', '']];
    const lastWords = 'The pricing page now has a yearly toggle, and all 42 tests pass. Want me to add the comparison table next?';
    const reply = 'Yes, three columns. Monthly by default.';

    function baseline(i: number) {
      term('claude').innerHTML = ''; term('codex').innerHTML = '';
      q('[data-input-text=claude]').textContent = ''; q('[data-input-text=codex]').textContent = '';
      if (i >= 1) { claudeIntro.forEach(l => put('claude', l)); codexIntro.forEach(l => put('codex', l)); }
      if (i >= 2) { put('claude', ['c', 'AskUserQuestion(Which billing periods?)']); put('claude', ['ok', 'Monthly and yearly · answered in Perch']); put('codex', ['xok', 'Allowed in Perch · pnpm add stripe']); }
      working('claude', i >= 1); working('codex', i >= 1);
      setS('claude', 'work', { status: 'Editing files' });
      setS('codex', 'work', { status: 'Editing files' });
      setS('cursor', i >= 1 ? 'done' : 'work', { status: 'Thinking' });
    }

    // ---------- Card ----------
    const PY: Record<string, number> = { inbox: 24, claude: 82, codex: 122, cursor: 162, note: 264 };
    let route = '', resizeTimer = 0;
    function show(name: string, html: string, py: number, sel: string) {
      route = name;
      card.classList.remove('sending');
      // Like the app, the card's height eases to fit its new content.
      const from = body.offsetHeight;
      body.style.height = '';
      body.innerHTML = html;
      const to = body.offsetHeight;
      if (stage.classList.contains('shelf-open') && from && Math.abs(from - to) > 2) {
        clearTimeout(resizeTimer);
        body.style.height = `${from}px`; void body.offsetHeight;
        body.style.height = `${to}px`;
        resizeTimer = window.setTimeout(() => { body.style.height = ''; }, 460);
      }
      body.classList.remove('pd-enter'); void body.offsetWidth; body.classList.add('pd-enter');
