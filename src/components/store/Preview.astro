<div class="perch-demo" data-perch-demo>
  <div class="window">
    <div class="window-bar">
      <span class="traffic" aria-hidden="true"><i></i><i></i><i></i></span>
      <span class="window-title">Perch</span>
      <span class="local-label"><span aria-hidden="true"></span>Local activity</span>
    </div>
    <div class="window-body">
      <img src="/products/perch-agents.webp" width="972" height="970" alt="Perch’s native shelf groups sample agent sessions by Needs you, Working, and Recent." data-perch-image/>
    </div>
  </div>
  <div class="demo-controls">
    <div class="segmented" role="group" aria-label="Choose a Perch preview">
      <button type="button" data-view="agents" aria-pressed="true">Agent activity</button>
      <button type="button" data-view="notes" aria-pressed="false">Sticky notes</button>
    </div>
    <p class="demo-caption" data-perch-caption aria-live="polite">Native app capture · sample activity, not live agent verification</p>
  </div>
</div>
<script>
  document.querySelectorAll<HTMLElement>('[data-perch-demo]').forEach(root => {
    root.querySelectorAll<HTMLButtonElement>('[data-view]').forEach(button => {
      button.addEventListener('click', () => {
        const notes = button.dataset.view === 'notes';
        const picture = root.querySelector<HTMLImageElement>('[data-perch-image]')!;
        picture.src = `/products/perch-${notes ? 'notes' : 'agents'}.webp`;
        picture.alt = notes ? 'Perch’s native sticky notes shelf with colored notes and a pinned note.' : 'Perch’s native shelf groups sample agent sessions by Needs you, Working, and Recent.';
        root.querySelector('[data-perch-caption]')!.textContent = notes ? 'Native app capture · example notes' : 'Native app capture · sample activity, not live agent verification';
        root.querySelectorAll('[data-view]').forEach(option => option.setAttribute('aria-pressed', String(option === button)));
      });
    });
  });
</script>
<style>
.perch-demo{width:100%}
.window{max-width:760px;margin:0 auto;border-radius:20px;overflow:hidden;background:#131415;border:1px solid rgba(255,255,255,.1);box-shadow:0 70px 120px -40px rgba(0,0,0,.75),0 0 0 1px rgba(0,0,0,.5)}
.window-bar{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;height:46px;padding:0 18px;background:linear-gradient(#2a2c2e,#202224);border-bottom:1px solid rgba(255,255,255,.07);font-size:13px}
.traffic{display:flex;gap:8px}
.traffic i{display:block;width:12px;height:12px;border-radius:50%}
.traffic i:nth-child(1){background:#ff5f57}
.traffic i:nth-child(2){background:#febc2e}
.traffic i:nth-child(3){background:#28c840}
.window-title{font-weight:550;color:rgba(245,245,242,.82);letter-spacing:-.01em}
.local-label{justify-self:end;display:flex;align-items:center;gap:7px;font-size:12px;color:rgba(245,245,242,.6)}
.local-label span{width:6px;height:6px;border-radius:50%;background:#7fb08f}
.window-body{background:#000}
.window-body img{width:100%;height:auto}
.demo-controls{display:flex;flex-direction:column;align-items:center;gap:16px;margin-top:30px}
.segmented{display:inline-flex;padding:4px;border-radius:999px;background:rgba(255,255,255,.07);border:1px solid var(--on-dark-line)}
.segmented button{border:0;border-radius:999px;padding:9px 20px;min-height:40px;background:transparent;color:var(--on-dark-muted);font-size:14px;transition:background .2s ease,color .2s ease}
.segmented button:hover{color:var(--on-dark)}
.segmented button[aria-pressed=true]{background:var(--on-dark);color:#0b0c0c}
.demo-caption{font-size:13px;color:var(--on-dark-muted);text-align:center}
@media(max-width:760px){
  .window{border-radius:16px}
  .window-bar{padding:0 12px;height:40px}
  .local-label{font-size:11px}
  .segmented button{padding:8px 14px;font-size:13px}
}
</style>
