justify-content:space-between;gap:12px;padding:12px 17px;background:#fbfafc;border-top:1px solid #ede9ef;font-size:9px;color:#756c7c}.editor-foot .green-dot{margin-right:5px}.demo-options{display:flex;justify-content:center;gap:5px;margin:22px auto 0}.demo-options button{border:1px solid transparent;border-radius:6px;padding:8px 12px;min-height:40px;background:transparent;color:#766980;font-size:11px}.demo-options button[aria-pressed=true]{background:#fff;border-color:#dfd8e5;color:#493c57;box-shadow:0 2px 4px #35204005}.demo-options button:hover{background:#ffffff80}.demo-caption{font-size:9px;color:#746c7a;text-align:center;margin-top:13px}.perch-demo{border-color:#e7e0d1;background:radial-gradient(ellipse at 50% 40%,#fffdf6,#efe9dc)}.perch-demo .demo-top{margin-bottom:16px}.perch-demo .demo-label,.perch-demo .local-label{color:#726957}.perch-capture{max-width:400px;margin:auto;border-radius:12px;overflow:hidden;box-shadow:0 12px 28px #40332116}.perch-capture img{width:100%;height:auto;aspect-ratio:1;object-fit:cover;object-position:top}.perch-demo .demo-options{margin-top:15px}.perch-demo .demo-caption{color:#726957}
@media(max-width:760px){.wisp-demo,.perch-demo{padding:16px}.demo-top{margin-bottom:25px}.editor-body{padding:22px 18px;min-height:250px}.dictation-pill{padding:10px;gap:9px;font-size:11px}.dictation-pill kbd{font-size:9px;padding-left:0}.wave{gap:2px}.spoken{font-size:15px}.output{font-size:18px}.editor-type{display:none}.editor-foot>span:last-child{display:none}.demo-options{gap:0}.demo-options button{font-size:10px;padding:8px 10px}.demo-label{font-size:8px}.local-label{font-size:9px}.demo-caption{font-size:9px}}
</style>
