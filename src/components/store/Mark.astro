---
const { product = 'studio', size = 40 } = Astro.props;
---
<span class:list={['app-mark', product]} style={`--size:${size}px`} aria-hidden="true">
  {product === 'studio' ? <svg viewBox="0 0 32 32" fill="none"><path d="M6 24V11a3.5 3.5 0 0 1 7 0v9a3.5 3.5 0 0 0 7 0v-9a3 3 0 0 1 6 0v13" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/></svg> : <img src={`/products/${product}-icon.webp`} width={size} height={size} alt=""/>}
</span>
<style>
.app-mark{display:inline-flex;width:var(--size);height:var(--size);flex:none;align-items:center;justify-content:center}.app-mark img{width:100%;height:100%;object-fit:contain}.app-mark svg{width:100%;height:100%}.studio{color:var(--green)}
</style>
