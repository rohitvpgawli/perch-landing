---
import { testimonials, type Testimonial } from '../../data/testimonials';
const featured = testimonials.find(t => t.featured);
const rest = testimonials.filter(t => t !== featured);
const initials = (name: string) => name.split(/\s+/).filter(Boolean).slice(0, 2).map(part => part[0]!.toUpperCase()).join('');
const credit = (t: Testimonial) => [t.role, t.company].filter(Boolean).join(', ');
---
{testimonials.length > 0 && (
  <div class="quotes">
    <header class="quotes-head reveal">
      <p class="eyebrow">From the beta</p>
      <h2>Fewer interruptions.<br/><span class="soft">In their words.</span></h2>
    </header>
    {featured && (
      <figure class="featured reveal">
        <blockquote>{featured.quote}</blockquote>
        <figcaption>
          {featured.avatar ? <img src={featured.avatar} alt="" width="44" height="44"/> : <span class="initials">{initials(featured.name)}</span>}
          <span>{featured.link ? <a href={featured.link} rel="noopener">{featured.name}</a> : <b>{featured.name}</b>}{credit(featured) && <small>{credit(featured)}</small>}</span>
        </figcaption>
      </figure>
    )}
    {rest.length > 0 && (
      <div class:list={['grid', `n${Math.min(rest.length, 3)}`]}>
        {rest.map((t, index) => (
          <figure class="card reveal" style={`transition-delay:${(index % 3) * 70}ms`}>
            <blockquote>{t.quote}</blockquote>
            <figcaption>
              {t.avatar ? <img src={t.avatar} alt="" width="36" height="36"/> : <span class="initials">{initials(t.name)}</span>}
              <span>{t.link ? <a href={t.link} rel="noopener">{t.name}</a> : <b>{t.name}</b>}{credit(t) && <small>{credit(t)}</small>}</span>
            </figcaption>
          </figure>
        ))}
      </div>
    )}
  </div>
)}

<style>
.quotes{margin-top:56px}
.quotes-head{text-align:center}
.quotes-head .eyebrow{margin-bottom:16px;color:#FAC961;opacity:.85}
.soft{background:linear-gradient(180deg,rgba(255,255,255,.72),rgba(255,255,255,.38));-webkit-background-clip:text;background-clip:text;color:transparent}
.quotes-head h2{font-size:clamp(34px,4.4vw,52px)}
.featured{max-width:860px;margin:52px auto 0;text-align:center}
.featured blockquote{margin:0;font-size:clamp(24px,2.8vw,34px);line-height:1.3;letter-spacing:-.025em;font-weight:500;text-wrap:balance;color:#fff}
.featured blockquote:before{content:'“';color:#FAC961}
.featured blockquote:after{content:'”';color:#FAC961}
.featured figcaption{display:inline-flex;align-items:center;gap:12px;margin-top:28px;text-align:left}
.featured img,.featured .initials{width:44px;height:44px}
.grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:52px}
.grid.n1{grid-template-columns:minmax(0,560px);justify-content:center}
.grid.n2{grid-template-columns:repeat(2,1fr)}
.card{display:flex;flex-direction:column;justify-content:space-between;gap:26px;margin:0;padding:26px 26px 22px;border-radius:24px;background:linear-gradient(180deg,rgba(255,255,255,.05),rgba(255,255,255,.02));box-shadow:inset 0 0 0 1px rgba(255,255,255,.08)}
.card blockquote{margin:0;font-size:16.5px;line-height:1.6;color:rgba(255,255,255,.86)}
.card blockquote:before{content:'“';color:#FAC961}
.card blockquote:after{content:'”';color:#FAC961}
figcaption{display:flex;align-items:center;gap:11px}
figcaption img,.initials{flex:none;width:36px;height:36px;border-radius:50%;object-fit:cover;box-shadow:0 0 0 1px rgba(255,255,255,.12)}
.initials{display:grid;place-items:center;font-size:13px;font-weight:650;color:#2a1d05;background:linear-gradient(180deg,#ffe3a3,#f1bf5c)}
figcaption b,figcaption a{display:block;font-size:14.5px;font-weight:600;color:#fff}
figcaption a{text-decoration:underline;text-decoration-color:rgba(255,255,255,.25);text-underline-offset:3px}
figcaption small{display:block;margin-top:2px;font-size:13px;color:rgba(255,255,255,.5)}
@media(max-width:900px){.grid,.grid.n2{grid-template-columns:1fr;max-width:560px;margin-inline:auto}}
</style>
