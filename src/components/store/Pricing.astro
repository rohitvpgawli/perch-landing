---
import { perch, checkoutReady, purchaseHref } from '../../data/perch';
---
<div class="perch-pricing">
  <div class="pricing-copy"><span class="eyebrow">One small tool. Yours to keep.</span><h3>Your agents, a glance away.</h3><p>Let Perch hold the little details while you give the big ones your attention.</p><ul><li>Native Mac app and screen-edge shelf</li><li>Local agent activity and session shortcuts</li><li>Pinned sticky notes in four colors</li><li>Keyboard shortcuts and local storage</li><li>No account or subscription</li></ul></div>
  <div class="pricing-offer"><span class="badge">Perch for Mac</span><p class="price">${perch.price}<span>USD · one time</span></p><p class="fine">App license · Source code not included<br/>Applicable taxes shown at checkout.</p><a class="button" href={purchaseHref}>{checkoutReady ? 'Get Perch' : 'View purchase details'} <span aria-hidden="true">↗</span></a><p class="fine">{checkoutReady ? 'No recurring charges.' : 'Purchases closed until delivery is ready.'}</p></div>
</div>
<style>
.perch-pricing{display:grid;grid-template-columns:1.2fr 1fr;border:1px solid var(--line);border-radius:16px;overflow:hidden;background:#fff}.pricing-copy,.pricing-offer{padding:38px}.pricing-copy{background:#f3f0e7}.pricing-copy h3{font-size:29px;margin:16px 0}.pricing-copy>p{max-width:380px;color:var(--muted);font-size:15px}.pricing-copy ul{list-style:none;padding:0;margin:25px 0 0;display:grid;gap:13px;font-size:14px}.pricing-copy li:before{content:'✓';margin-right:10px;color:#667b5d}.pricing-offer{display:flex;flex-direction:column;align-items:flex-start;justify-content:center}.price{font-size:72px;letter-spacing:-3px;line-height:1.3;margin:15px 0}.price span{font-size:13px;letter-spacing:0;color:var(--muted);margin-left:12px}.pricing-offer .button{width:100%;margin:26px 0 12px}.pricing-offer>.fine:last-child{align-self:center;font-size:11px}@media(max-width:760px){.perch-pricing{grid-template-columns:1fr}.pricing-copy,.pricing-offer{padding:26px}.price{font-size:64px}}
</style>
