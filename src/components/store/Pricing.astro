---
import { products, offerPath, type ProductKey } from '../../data/store';
const { product } = Astro.props as { product: ProductKey };
const item = products[product];
---
<div class="comparison" aria-label={`${item.name} build versus buy`}>
  <div class="build-option"><span class="option-label">The scenic route</span><h3>Build it yourself</h3><p class="build-price">~{item.buildDays}</p><p class="build-spend">+ ~${item.buildCost} in AI tokens</p><p class="option-copy">An empty project, a few late nights,<br class="desktop-break"/> and something entirely your own.</p><details><summary>What’s involved?</summary><p>{product === 'wisp' ? 'Audio capture, speech models, pause detection, text insertion, permissions, vocabulary, and testing.' : 'Provider hooks, event handling, session states, a native shelf, sticky notes, and testing.'}</p></details></div>
  <div class="buy-option"><span class="option-label">Take the shortcut</span><h3>Just the app</h3><p class="offer-price">${item.price}<span>USD · once</span></p><p class="option-copy">The tool, ready to use.<br/>Keep your time for your own project.</p><a class="button" href={offerPath(product)}>Explore the ${item.price} app <span aria-hidden="true">↗</span></a><span class="offer-foot">Lifetime use · {item.appAvailable ? 'Available' : 'Planned price'}</span></div>
  <div class="source-option"><span class="option-label">Make it your own <span aria-hidden="true">↗</span></span><h3>App + full source</h3><p class="offer-price">${item.sourcePrice}<span>USD · once</span></p><p class="option-copy">Everything in the app, plus the code.<br/>Read it. Tweak it. Build on it.</p><a class="button light" href={offerPath(product, 'source')}>Explore the ${item.sourcePrice} source <span aria-hidden="true">↗</span></a><span class="offer-foot">App included · {item.sourceAvailable ? 'Available' : 'Planned price'}</span></div>
</div>
<p class="estimate-note">DIY figures are rough build-from-scratch estimates, not a benchmark. Your time and token spend will vary. {(!item.appAvailable || !item.sourceAvailable) && 'In development; purchases are not open yet.'}</p>
<style>
.comparison{display:grid;grid-template-columns:1fr 1fr 1fr;border:1px solid var(--line);border-radius:16px;overflow:hidden;background:#fff}.comparison>div{padding:28px;display:flex;align-items:start;flex-direction:column}.comparison>div+div{border-left:1px solid var(--line)}.build-option{background:#f3f5ef}.source-option{background:#f7f8f3}.option-label{font:10px var(--mono);text-transform:uppercase;letter-spacing:1px;color:var(--muted);margin-bottom:18px}.source-option .option-label{color:#53694a}.comparison h3{font-size:20px;letter-spacing:-.5px}.offer-price{font-size:48px;letter-spacing:-2px;line-height:1.3;margin:16px 0}.offer-price span{font-size:11px;color:var(--muted);letter-spacing:0;margin-left:9px}.build-price{font-size:29px;letter-spacing:-1px;margin:17px 0 0;line-height:1.2}.build-spend{font-size:13px;color:var(--muted);margin-top:6px}.option-copy{font-size:13px;color:var(--muted);margin-bottom:24px}.build-option .option-copy{margin-top:18px}.button{width:100%;font-size:12px;gap:8px;margin-top:auto}.offer-foot{font-size:10px;color:var(--muted);margin-top:12px;align-self:center}.estimate-note{font-size:11px;color:var(--muted);margin-top:15px;max-width:850px}.comparison details{margin-top:auto;font-size:12px;color:var(--muted)}.comparison summary{cursor:pointer;text-decoration:underline;text-underline-offset:4px}.comparison details p{margin-top:12px}.comparison details[open]{margin-top:0}
@media(max-width:760px){.comparison{grid-template-columns:1fr}.comparison>div{padding:25px}.comparison>div+div{border-left:0;border-top:1px solid var(--line)}.build-option .option-copy{margin-bottom:15px}.offer-price{margin:12px 0}.desktop-break{display:none}.option-copy{margin-bottom:20px}.option-label{margin-bottom:12px}}
</style>
