---
import { apps } from "../data/apps";
import { site } from "../data/site";

const links = [
  ...apps.map((a) => ({ label: a.name, href: `/apps/${a.slug}`, soon: a.kind === "soon" })),
  { label: "About", href: "/#about", soon: false },
  { label: "Support", href: `mailto:${site.support}`, soon: false },
];
const path = Astro.url.pathname.replace(/\/$/, "");
---

<header class="gn" data-gn>
  <nav class="gn-in" aria-label="Global">
    <a class="mark" href="/" aria-label={`${site.studio}, home`}>
      <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true">
        <rect x="3" y="3" width="8" height="8" rx="2.4" fill="currentColor" />
        <rect x="13" y="3" width="8" height="8" rx="2.4" fill="currentColor" />
        <rect x="3" y="13" width="8" height="8" rx="2.4" fill="currentColor" opacity=".35" />
        <rect x="13" y="13" width="8" height="8" rx="2.4" fill="currentColor" opacity=".35" />
      </svg>
      <span>{site.short}</span>
    </a>
    <ul class="links" id="gn-links">
      {
        links.map((l, i) => (
          <li style={`--i:${i}`}>
            <a href={l.href} aria-current={path === l.href ? "page" : undefined}>
              {l.label}
              {l.soon && <sup aria-label="coming soon" />}
            </a>
          </li>
        ))
      }
    </ul>
    <button class="burger" type="button" aria-expanded="false" aria-controls="gn-links" aria-label="Menu" data-burger>
      <span></span><span></span>
    </button>
  </nav>
</header>

<script>
  const root = document.documentElement;
  const btn = document.querySelector<HTMLButtonElement>("[data-burger]")!;
  const set = (open: boolean) => {
    root.classList.toggle("nav-open", open);
    btn.setAttribute("aria-expanded", String(open));
    btn.setAttribute("aria-label", open ? "Close menu" : "Menu");
  };
  btn.addEventListener("click", () => set(!root.classList.contains("nav-open")));
  document.querySelectorAll("#gn-links a").forEach((a) => a.addEventListener("click", () => set(false)));
  addEventListener("keydown", (e) => e.key === "Escape" && set(false));
  matchMedia("(min-width: 834px)").addEventListener("change", () => set(false));
</script>

<style>
  .gn {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--nav);
    font-size: 12px;
    letter-spacing: -0.01em;
  }

  .gn::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgb(250 250 252 / 0.8);
    backdrop-filter: saturate(180%) blur(20px);
    -webkit-backdrop-filter: saturate(180%) blur(20px);
    border-bottom: 1px solid rgb(0 0 0 / 0.06);
  }

  :global(.theme-dark) .gn::before {
    background: rgb(22 22 23 / 0.8);
    border-bottom-color: rgb(255 255 255 / 0.08);
  }

  :global(.theme-dark) .gn {
    color: #f5f5f7;
  }

  .gn-in {
    height: 100%;
    max-width: 1024px;
    margin-inline: auto;
    padding-inline: 16px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .mark {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: 0.02em;
    padding: 8px 4px;
  }

  .links {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .links a {
    position: relative;
    color: rgb(0 0 0 / 0.8);
    transition: color 0.2s;
  }

  :global(.theme-dark) .links a {
    color: rgb(255 255 255 / 0.8);
  }

  .links a:hover,
  .links a[aria-current] {
    color: #000;
  }

  :global(.theme-dark) .links a:hover,
  :global(.theme-dark) .links a[aria-current] {
    color: #fff;
  }

  .links sup {
    position: absolute;
    top: -1px;
    right: -7px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--orange);
  }

  .burger {
    position: relative;
    width: 44px;
    height: 44px;
    margin-right: -10px;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .burger span {
    position: absolute;
    left: 14px;
    right: 14px;
    height: 1.5px;
    border-radius: 1px;
    background: currentColor;
    transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .burger span:first-child {
    transform: translateY(-3.5px);
  }

  .burger span:last-child {
    transform: translateY(3.5px);
  }

  :global(.nav-open) .burger span:first-child {
    transform: rotate(45deg);
  }

  :global(.nav-open) .burger span:last-child {
    transform: rotate(-45deg);
  }

  @media (max-width: 833px) {
    .links {
      position: fixed;
      inset: var(--nav) 0 0;
      padding: 18px 48px;
      background: rgb(250 250 252 / 0.98);
      visibility: hidden;
      opacity: 0;
      transition: opacity 0.3s, visibility 0s 0.3s;
    }

    :global(.theme-dark) .links {
      background: rgb(22 22 23 / 0.98);
    }

    .links li {
      opacity: 0;
      transform: translateY(-8px);
      transition: opacity 0.3s, transform 0.4s cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    .links a {
      display: block;
      padding: 7px 0;
      font-size: 28px;
      font-weight: 600;
      letter-spacing: 0.007em;
      color: var(--ink);
    }

    :global(.theme-dark) .links a {
      color: #f5f5f7;
    }

    .links sup {
      position: static;
      display: inline-block;
      margin-left: 8px;
      vertical-align: super;
    }

    :global(.nav-open) .links {
      visibility: visible;
      opacity: 1;
      transition-delay: 0s;
    }

    :global(.nav-open) .links li {
      opacity: 1;
      transform: none;
      transition-delay: calc(0.05s + var(--i) * 0.03s);
    }
  }

  @media (min-width: 834px) {
    .links {
      display: flex;
      gap: 34px;
    }

    .burger {
      display: none;
    }
  }
</style>
