---
import Store from '../layouts/Store.astro';
import Mark from './store/Mark.astro';
import Preview from './store/Preview.astro';
import Pricing from './store/Pricing.astro';
import { product } from '../data/product';
import { perch, checkoutReady, purchaseHref } from '../data/perch';
const steps = [
  ['Connect your agents.', 'Review and install the local hooks for each provider in Settings.'],
  ['Let the tab keep watch.', 'A small mark shows activity. Open the shelf for session details and pinned notes.'],
  ['Pick up the thread.', 'Open the provider or supported session and respond there. Perch never replies for you.'],
];
const providers = [
  ['Claude Code', 'CLI activity verified'],
  ['Cursor', 'Local Agent activity verified'],
  ['Codex', 'Adapter built · live checks pending'],
];
const faq = [...product.faq,
  { q: 'How much does Perch cost?', a: '$29 USD, paid once. No subscription. Applicable taxes will be shown at checkout. Purchases are closed until the app is ready to deliver.' },
  { q: 'What is included?', a: 'The native Mac app, agent-activity shelf, pinned sticky notes, keyboard shortcuts, and local storage. This is the app license; source code is not included.' },
  { q: 'What does one-time purchase mean?', a: 'A single payment for a non-expiring license to the purchased version. Update coverage, device limits, support, and refund details will be published before sales open.' },
];
const schema = { '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: 'Perch', applicationCategory: 'DeveloperApplication', operatingSystem: 'macOS 14+', description: perch.description, url: perch.origin, image: `${perch.origin}/products/perch-icon.webp`, offers: { '@type': 'Offer', price: perch.price, priceCurrency: perch.currency, availability: checkoutReady ? 'https://schema.org/InStock' : 'https://schema.org/OutOfStock', url: `${perch.origin}/checkout/`, description: checkoutReady ? 'One-time app license' : 'Purchases closed until delivery is ready' } };
---
<Store>
  <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')}/>
  <div class="perch">
    <section class="dark hero" id="overview">
      <div class="aurora" aria-hidden="true"></div>
      <div class="shell hero-inner">
        <p class="eyebrow hero-eyebrow">Perch for Mac · macOS 14+</p>
        <h1>Stop checking<br/><span class="dim">on your agents.</span></h1>
        <p class="lead hero-lead">Perch sits at the edge of your Mac and shows which Claude Code, Cursor, and Codex sessions are working, finished, or waiting for you. Stop tab-hopping. Get back to building.</p>
        <div class="actions hero-actions">
          <a class="button big" href={purchaseHref}>Get Perch · ${perch.price} <span aria-hidden="true">↗</span></a>
          <a class="button big glass" href="#demo">See it in action <span aria-hidden="true">↓</span></a>
        </div>
        <p class="status-label hero-status">{checkoutReady ? 'One-time purchase · No subscription' : '$29 USD, one time · No subscription · Purchases open when delivery is ready'}</p>
        <div class="works" aria-label="Works with">
          <span>Works with</span>
          {providers.map(([name]) => <span class="chip">{name}</span>)}
        </div>
        <div class="hero-stage" id="demo"><Preview/></div>
      </div>
    </section>

    <div class="shell benefits">
      {['Local agent activity', 'Sticky notes within reach', 'No account or server', 'One payment. Yours to keep.'].map(text => <span><span aria-hidden="true">✓</span>{text}</span>)}
    </div>

    <section class="shell section" id="how">
      <header class="intro reveal">
        <p class="eyebrow">How it works</p>
        <h2>Set up once.<br/><span class="dim">Then stop checking.</span></h2>
        <p class="lead">A small, independent utility for the agents you already use. No new coding environment to move into.</p>
      </header>
      <div class="steps">
        {steps.map(([title, body], index) => <article class="reveal"><span class="step-number">0{index + 1}</span><h3>{title}</h3><p>{body}</p></article>)}
      </div>
    </section>

    <section class="shell section" id="features">
      <header class="intro reveal">
        <p class="eyebrow">Everything in view</p>
        <h2>Know what needs you.<br/><span class="dim">Ignore the rest.</span></h2>
        <p class="lead">Small details that add up to fewer interruptions and more time on the work itself.</p>
      </header>
      <div class="feature-grid">
        {product.features.map((feature, index) => <article class="reveal" style={`transition-delay:${index * 60}ms`}><div class="feature-art" aria-hidden="true"><span class="feature-glyph">{feature.icon}</span></div><div class="feature-copy"><h3>{feature.title}</h3><p>{feature.body}</p></div></article>)}
      </div>
    </section>

    <section class="dark band" id="coverage">
      <div class="shell integrations">
        <div class="reveal">
          <p class="eyebrow">The connections, honestly</p>
          <h2>Your agents.<br/><span class="dim">Their own apps.</span></h2>
          <p class="lead">Perch reads local events. It doesn’t read your prompts or send replies. Your agent plans and API costs stay separate.</p>
        </div>
        <div class="provider-list reveal">
          {providers.map(([name, status]) => <div><b>{name}</b><span>{status}</span></div>)}
          <p class="fine">Cursor’s passive hooks don’t expose permission-waiting status. Session-opening behavior varies by provider.</p>
        </div>
      </div>
    </section>

    <section class="shell section" id="pricing">
      <header class="intro reveal">
        <p class="eyebrow">Pricing</p>
        <h2>One payment.<br/><span class="dim">Yours to keep.</span></h2>
        <p class="lead">No monthly bill. No annual plan. Just a useful tool, on your terms.</p>
      </header>
      <Pricing/>
    </section>

    <section class="shell section faq-layout" id="questions">
      <div class="reveal">
        <p class="eyebrow">Before you buy</p>
        <h2>A few good<br/><span class="dim">questions.</span></h2>
        <a class="text-link" href={perch.support}>Ask us something else ↗</a>
      </div>
      <div class="faq reveal">{faq.map(entry => <details><summary>{entry.q}</summary><p>{entry.a}</p></details>)}</div>
    </section>

    <section class="dark closing">
      <div class="shell closing-inner reveal">
        <Mark product="perch" size={72}/>
        <h2>Get back to the work<br/><span class="dim">that matters.</span></h2>
        <p class="lead">Let Perch keep watch on your agents. $29, once.</p>
        <a class="button big" href={purchaseHref}>Get Perch · ${perch.price} <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </div>
</Store>

<style>
.hero{position:relative;isolation:isolate;overflow:hidden;background:#07090a;padding:170px 0 0;text-align:center}
.aurora{position:absolute;inset:-25% -10%;z-index:-2;background:radial-gradient(38% 34% at 22% 30%,rgba(111,154,130,.5),transparent 70%),radial-gradient(34% 30% at 78% 24%,rgba(176,140,90,.42),transparent 70%),radial-gradient(46% 38% at 52% 78%,rgba(78,118,164,.4),transparent 72%);filter:blur(30px);animation:drift 22s ease-in-out infinite alternate}
.hero:after{content:'';position:absolute;left:0;right:0;bottom:0;height:260px;z-index:-1;background:linear-gradient(to bottom,rgba(7,9,10,0),var(--paper));pointer-events:none}
@keyframes drift{from{transform:translate3d(-3%,0,0) scale(1)}to{transform:translate3d(3%,-2%,0) scale(1.08)}}
.hero-inner{display:flex;flex-direction:column;align-items:center}
.hero-eyebrow{color:var(--on-dark-muted)}
.hero h1{margin-top:26px;font-size:clamp(52px,8.4vw,110px);letter-spacing:-.055em;line-height:.96}
.hero-lead{margin:30px auto 0;max-width:600px;font-size:clamp(18px,2vw,22px)}
.hero-actions{justify-content:center;margin-top:40px}
.hero-status{display:block;margin-top:22px;color:var(--on-dark-muted);text-align:center;line-height:1.7}
.hero-status:before{display:none}
.works{display:flex;justify-content:center;align-items:center;flex-wrap:wrap;gap:10px;margin-top:48px;font-size:13px;color:var(--on-dark-muted)}
.works .chip{padding:7px 14px;border-radius:999px;border:1px solid var(--on-dark-line);background:rgba(255,255,255,.04);color:var(--on-dark)}
.hero-stage{width:min(860px,100%);margin:90px auto 0;padding-bottom:200px;position:relative;z-index:1}

.benefits{display:flex;justify-content:center;flex-wrap:wrap;gap:16px 44px;padding-block:44px 8px;font-size:15px;color:var(--muted)}
.benefits>span>span{color:var(--green);margin-right:8px}

.intro{text-align:center;max-width:760px;margin:0 auto}
.intro .eyebrow{margin-bottom:20px}
.intro .lead{margin:24px auto 0}
#pricing .intro{margin-bottom:64px}

.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:64px}
.steps article{background:var(--surface);border-radius:28px;padding:38px 34px;box-shadow:0 1px 0 rgba(0,0,0,.03),0 24px 60px -34px rgba(0,0,0,.28)}
.step-number{display:inline-grid;place-items:center;width:42px;height:42px;border-radius:50%;background:#e6eee9;color:var(--green);font:500 13px var(--mono)}
.steps h3{font-size:25px;margin:36px 0 12px}
.steps p{font-size:16px;color:var(--muted)}

.feature-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px;margin-top:64px}
.feature-grid article{display:flex;flex-direction:column;background:var(--surface);border-radius:28px;overflow:hidden;box-shadow:0 1px 0 rgba(0,0,0,.03),0 24px 60px -34px rgba(0,0,0,.28)}
.feature-art{height:176px;display:grid;place-items:center;background:radial-gradient(120% 90% at 50% 0%,#eaf2ed 0,#dce8e0 100%)}
.feature-grid article:nth-child(3n+2) .feature-art{background:radial-gradient(120% 90% at 50% 0%,#f4eee2 0,#e9dfcb 100%)}
.feature-grid article:nth-child(3n) .feature-art{background:radial-gradient(120% 90% at 50% 0%,#e9edf5 0,#d6deeb 100%)}
.feature-glyph{font:300 58px var(--mono);color:var(--green)}
.feature-copy{padding:28px 30px 34px}
.feature-copy h3{font-size:23px;margin-bottom:12px}
.feature-copy p{font-size:15px;color:var(--muted)}

.band{padding-block:120px}
.integrations{display:grid;grid-template-columns:1fr 1fr;gap:80px;align-items:center}
.integrations h2{margin:20px 0 24px}
.integrations .lead{font-size:18px}
.provider-list{border-top:1px solid var(--line)}
.provider-list>div{display:flex;align-items:center;justify-content:space-between;gap:16px;padding:24px 0;border-bottom:1px solid var(--line);font-size:17px}
.provider-list>div>span{font-size:13px;color:var(--muted);text-align:right}
.provider-list .fine{margin-top:20px}

.closing{padding-block:140px;text-align:center}
.closing-inner{display:flex;flex-direction:column;align-items:center;gap:0}
.closing h2{margin:34px 0 20px;font-size:clamp(40px,6vw,76px)}
.closing .lead{margin-bottom:40px}

@media(max-width:960px){
  .feature-grid{grid-template-columns:1fr 1fr}
  .integrations{gap:50px}
}
@media(max-width:760px){
  .hero{padding-top:128px}
  .hero-stage{margin-top:64px;padding-bottom:150px}
  .hero-actions{flex-direction:column;width:100%}
  .hero-actions .button{width:100%}
  .works{margin-top:36px}
  .benefits{display:grid;grid-template-columns:1fr 1fr;gap:16px 14px;text-align:left;font-size:13px;padding-inline:4px}
  .steps{grid-template-columns:1fr;gap:16px;margin-top:44px}
  .steps article{padding:28px 24px}
  .steps h3{margin:26px 0 8px;font-size:22px}
  .feature-grid{grid-template-columns:1fr;gap:16px;margin-top:44px}
  .feature-art{height:160px}
  .feature-copy{padding:24px}
  .integrations{grid-template-columns:1fr;gap:36px}
  .band{padding-block:80px}
  .closing{padding-block:100px}
  .closing .button{width:100%}
}
</style>

<script>
  const reveal = document.querySelectorAll<HTMLElement>('.reveal');
  if ('IntersectionObserver' in window) {
    const observer = new IntersectionObserver(entries => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.classList.add('in');
          observer.unobserve(entry.target);
        }
      });
    }, { rootMargin: '0px 0px -8% 0px', threshold: 0.08 });
    reveal.forEach(element => observer.observe(element));
  } else {
    reveal.forEach(element => element.classList.add('in'));
  }
</script>
