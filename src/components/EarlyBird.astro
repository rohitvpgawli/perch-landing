---
import { earlyBird, type ReadyApp } from "../data/apps";

interface Props {
  app: ReadyApp;
  tone?: "light" | "dark";
  class?: string;
}

const { app, tone = "light", class: cls } = Astro.props;
const eb = earlyBird(app);
---

{
  eb && (
    <div class:list={["eb", tone, cls]}>
      <p class="top">
        <b>
          <i class="live" />
          Early-bird
        </b>
        <span>
          {eb.left} of {eb.spots} spots left
        </span>
      </p>
      <div
        class="bar"
        role="progressbar"
        aria-label="Early-bird spots claimed"
        aria-valuemin={0}
        aria-valuemax={eb.spots}
        aria-valuenow={eb.claimed}
      >
        <i style={`width:${eb.pct}%`} />
      </div>
      <p class="fine">
        The first {eb.spots} people pay {eb.price} for life. After that, it's {eb.regular}.
      </p>
    </div>
  )
}

<style>
  .eb {
    display: grid;
    gap: 10px;
    width: 100%;
    max-width: 420px;
    text-align: left;
  }

  .top {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    margin: 0;
    font-size: 14px;
  }

  .top b {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 600;
  }

  .top span {
    font-weight: 600;
    color: #e5484d;
    font-variant-numeric: tabular-nums;
  }

  .live {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: #e5484d;
    box-shadow: 0 0 0 0 rgb(229 72 77 / 0.5);
    animation: live 1.8s ease-out infinite;
  }

  @keyframes live {
    to {
      box-shadow: 0 0 0 8px rgb(229 72 77 / 0);
    }
  }

  .bar {
    height: 8px;
    border-radius: 999px;
    overflow: hidden;
    background: rgb(0 0 0 / 0.08);
  }

  .bar i {
    display: block;
    height: 100%;
    border-radius: inherit;
    background:
      repeating-linear-gradient(-45deg, rgb(255 255 255 / 0.22) 0 6px, transparent 6px 12px) 0 0 / 34px 100%,
      linear-gradient(90deg, #ff9f0a, #e5484d);
    animation: stripes 1.2s linear infinite;
  }

  @keyframes stripes {
    to {
      background-position:
        34px 0,
        0 0;
    }
  }

  .fine {
    margin: 0;
    font-size: 13px;
    opacity: 0.65;
  }

  .dark .top b {
    color: #fff;
  }

  .dark .top span {
    color: #ff6369;
  }

  .dark .bar {
    background: rgb(255 255 255 / 0.12);
  }

  .dark .fine {
    color: #d1d1d6;
  }
</style>
