---
import Mark from './store/Mark.astro';
import { perch, purchaseHref, checkoutReady } from '../data/perch';
const useCases = [
  ['developers', 'Developers', 'Keep implementation and review moving'],
  ['parallel-agents', 'Parallel agents', 'See which session needs you'],
  ['founders', 'Founders', 'Keep building between decisions'],
  ['agencies', 'Agencies', 'Keep client projects in context'],
  ['claude-code', 'Claude Code', 'Tools, questions, plans and replies'],
  ['codex', 'Codex CLI', 'Activity, approvals and replies'],
  ['cursor', 'Cursor', 'Local Agent activity and replies'],
];
const resources = [
  ['/guides/', 'Guides', 'Setup, shortcuts and quick answers'],
  ['/alternatives/', 'Compare', 'Find the right workflow for you'],
  ['/blog/', 'Blog', 'Notes on working with agents'],
  ['/glossary/', 'Glossary', 'The words, plainly defined'],
  ['/privacy/', 'Privacy', 'What stays on your Mac'],
];
const productLinks = [['/#demo', 'Demo'], ['/#inside', 'Features'], ['/#privacy', 'Privacy'], ['/#pricing', 'Pricing'], ['/#questions', 'FAQ']];
---
<header class="header">
  <nav class="shell nav" aria-label="Main navigation">
    <a href="/" class="brand"><Mark product="perch" size={32}/>Perch.</a>
    <div class="nav-links">
      {productLinks.map(([href, label]) => <a href={href}>{label}</a>)}
      <details class="nav-dropdown">
        <summary>Use cases <svg class="nav-chevron" viewBox="0 0 12 12" aria-hidden="true"><path d="m3 4.5 3 3 3-3"/></svg></summary>
        <div class="nav-panel use-case-panel">
          {useCases.map(([slug, title, detail]) => <a href={`/use-cases/${slug}/`}><b>{title}</b><small>{detail}</small></a>)}
          <a class="panel-all" href="/use-cases/">All use cases <span aria-hidden="true">↗</span></a>
        </div>
      </details>
      <details class="nav-dropdown">
        <summary>Resources <svg class="nav-chevron" viewBox="0 0 12 12" aria-hidden="true"><path d="m3 4.5 3 3 3-3"/></svg></summary>
        <div class="nav-panel resource-panel">
          {resources.map(([href, title, detail]) => <a href={href}><b>{title}</b><small>{detail}</small></a>)}
          <a class="panel-all" href="/resources/">All resources <span aria-hidden="true">↗</span></a>
        </div>
      </details>
    </div>
    <details class="mobile-menu nav-dropdown">
      <summary>Menu <svg class="nav-chevron" viewBox="0 0 12 12" aria-hidden="true"><path d="m3 4.5 3 3 3-3"/></svg></summary>
      <div class="nav-panel mobile-panel">
        <div><p class="eyebrow">Product</p>{productLinks.map(([href, label]) => <a href={href}>{label}</a>)}</div>
        <div><p class="eyebrow">Explore</p><a href="/use-cases/">Use cases</a>{resources.map(([href, title]) => <a href={href}>{title}</a>)}<a href="/resources/">All resources</a></div>
      </div>
    </details>
    <a class="button small nav-cta" href={purchaseHref}>{checkoutReady ? `Get Perch · $${perch.price}` : 'Get early access'}</a>
  </nav>
</header>
<style>
  .nav-links{gap:18px;font-size:14px}
  .nav-links>a{line-height:20px}
  .nav-dropdown{position:relative}
  summary{display:flex;align-items:center;gap:6px;min-height:42px;cursor:pointer;color:var(--on-dark-muted);list-style:none;padding:0;font:inherit;line-height:20px;white-space:nowrap;transition:color .18s ease}
  summary::-webkit-details-marker{display:none}
  summary:hover,details[open]>summary{color:var(--on-dark)}
  .nav-chevron{width:12px;height:12px;flex:none;fill:none;stroke:currentColor;stroke-width:1.5;stroke-linecap:round;stroke-linejoin:round;transition:transform .28s cubic-bezier(.22,1,.36,1)}
  details[open]>summary .nav-chevron{transform:rotate(180deg)}
  details[data-state='closing']>summary .nav-chevron{transform:rotate(0)}
  .nav-panel{position:absolute;top:calc(100% + 14px);padding:12px;background:#0b0c0e;border:1px solid var(--on-dark-line);border-radius:24px;box-shadow:0 24px 60px -20px rgba(0,0,0,.65);transform-origin:50% 0}
  .nav-panel a{display:block;padding:13px 16px;border-radius:14px;color:var(--on-dark);transition:background .18s ease}
  .nav-panel a:hover,.nav-panel a:focus-visible{background:rgba(255,255,255,.06)}
  .nav-panel b{display:block;font-size:15px;font-weight:550}
  .nav-panel small{display:block;margin-top:4px;color:var(--on-dark-muted);font-size:13px;line-height:1.45}
  .use-case-panel{right:-110px;width:590px;display:grid;grid-template-columns:1fr 1fr;gap:4px}
  .resource-panel{right:-100px;width:330px}
  .nav-panel .panel-all{grid-column:1/-1;border-top:1px solid var(--on-dark-line);border-radius:0 0 14px 14px;margin-top:8px;display:flex;justify-content:space-between;font-size:14px}
  .mobile-menu{display:none;margin-left:auto}
  .mobile-menu summary{font-size:13px}
  .mobile-panel{position:fixed;left:12px;right:12px;top:82px;max-height:calc(100dvh - 100px);overflow:auto;display:grid;grid-template-columns:1fr 1fr;gap:12px}
  .mobile-panel .eyebrow{padding:12px 16px 5px}
  .mobile-panel a{font-size:14px;padding-block:10px}
  @media(max-width:1040px){.nav-links{display:none}.mobile-menu{display:block}.nav{gap:16px}.nav-cta{flex:none}}
  @media(max-width:400px){.nav{gap:10px;padding-left:12px}.nav .brand{font-size:14px;gap:6px}.nav .button.small{padding:9px 10px;font-size:12px}.mobile-menu summary{font-size:12px}}
</style>
<script>
  import { animateDisclosure } from '../scripts/disclosure';
  const menus = [...document.querySelectorAll<HTMLDetailsElement>('.nav-dropdown')];
  const controls = new Map<HTMLDetailsElement, ReturnType<typeof animateDisclosure>>();
  menus.forEach(menu => {
    const panel = menu.querySelector<HTMLElement>('.nav-panel')!;
    const summary = menu.querySelector('summary')!;
    const control = animateDisclosure(menu, panel, 'popup', () => {
      controls.forEach((other, element) => { if (element !== menu) other.setOpen(false); });
    });
    controls.set(menu, control);
    // Escape closes; Tab follows native document order and closes after leaving.
    menu.addEventListener('focusout', () => requestAnimationFrame(() => {
      if (!menu.contains(document.activeElement)) control.setOpen(false);
    }));
    menu.addEventListener('keydown', event => {
      const links = [...panel.querySelectorAll<HTMLAnchorElement>('a[href]')];
      if (!['ArrowDown', 'ArrowUp', 'Home', 'End'].includes(event.key)) return;
      if (!control.isOpen && document.activeElement !== summary) return;
      event.preventDefault();
      control.setOpen(true);
      const current = links.indexOf(document.activeElement as HTMLAnchorElement);
      const next = event.key === 'Home' ? 0 : event.key === 'End' ? links.length - 1 : event.key === 'ArrowDown' ? (current + 1) % links.length : (current < 0 ? links.length - 1 : (current - 1 + links.length) % links.length);
      links[next]?.focus({ preventScroll: true });
    });
    menu.addEventListener('click', event => {
      const link = (event.target as Element).closest('a');
      if (!link) return;
      const next = new URL(link.href);
      // Close before leaving so a restored history entry has no open popup.
      const leaving = next.pathname !== location.pathname || next.search !== location.search;
      control.setOpen(false, { instant: leaving });
    });
  });
  document.addEventListener('pointerdown', event => {
    controls.forEach((control, menu) => { if (!menu.contains(event.target as Node)) control.setOpen(false); });
  });
  document.addEventListener('keydown', event => {
    if (event.key !== 'Escape') return;
    controls.forEach((control, menu) => {
      if (control.isOpen) { control.setOpen(false); menu.querySelector('summary')?.focus({ preventScroll: true }); }
    });
  });
  // Restored history entries should return with a quiet, closed navigation.
  window.addEventListener('pagehide', () => controls.forEach(control => control.setOpen(false, { instant: true })));
  window.matchMedia('(max-width: 1040px)').addEventListener('change', () => controls.forEach(control => control.setOpen(false, { instant: true })));
</script>
