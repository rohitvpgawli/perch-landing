---
import Store from '../layouts/Store.astro';
import Mark from './store/Mark.astro';
import Preview from './store/Preview.astro';
import Pricing from './store/Pricing.astro';
import SourceSection from './store/SourceSection.astro';
import { products, ownershipFaq, type ProductKey } from '../data/store';
import { site } from '../data/site';

interface Props {
  product: ProductKey;
  /** @deprecated Prefer `product`. Kept so legacy `/apps/*` wrappers keep working. */
  app?: { slug: string };
}

const props = Astro.props as Props;
const key = (props.product ?? props.app?.slug) as ProductKey;
const item = products[key];
const isWisp = key === 'wisp';
const steps = isWisp ? [
  ['Press your shortcut.', 'Control–Option–Space by default. Your cursor stays where you’re working.'],
  ['Say the next thought.', 'Watch your words appear live in the notch. Pause and the sentence is inserted.'],
  ['Keep going. Or don’t.', 'Wisp keeps listening. Press again to finish, or hold the shortcut for push-to-talk.'],
] : [
  ['Connect your agents.', 'Review and install the local hooks for each provider in Settings.'],
  ['Let the tab keep watch.', 'A small mark shows activity. Open the shelf for session details and pinned notes.'],
  ['Pick up the thread.', 'Open the provider or supported session and respond there. Perch never replies for you.'],
];
---
<Store title={`${item.name} — ${item.short}`} description={item.description} siteKind="product" productSlug={key}>
  <div class:list={['product-page',key]}>
    <div class="shell product-subnav"><a href="#overview"><Mark product={key} size={30}/>{item.name}</a><div><a href="#how">How it works</a><a href="#pricing">Build or buy</a><a href="#questions">FAQ</a></div></div>
    <section class="shell product-hero" id="overview">
      <div class="hero-icon"><Mark product={key} size={90}/></div><p class="eyebrow">{isWisp ? 'Your voice. Your Mac. Your next good idea.' : 'Your agents. Your notes. A place at the edge.'}</p>
      <h1>{isWisp ? <>Your next thought.<br/><span class="serif">Already typed.</span></> : <>Keep an eye on the work.<br/><span class="serif">Keep your head in yours.</span></>}</h1>
      <p class="lead">{isWisp ? 'Talk through a prompt. Explain a bug. Catch an idea before it disappears. Wisp turns your voice into text, right where you’re working.' : item.description}</p>
      <div class="actions"><a class="button" href="#pricing">Explore {item.name} · ${item.price} <span aria-hidden="true">↓</span></a><a class="button light" href="#source">App + source · ${item.sourcePrice} <span aria-hidden="true">↗</span></a></div>
      <p class="fine">{item.requirements}</p><p class="status-label">{item.status} · Planned lifetime prices</p>
    </section>
    <section class="shell hero-demo" aria-label={`${item.name} product demonstration`}><Preview product={key}/></section>
    <div class="shell benefit-strip">{(isWisp ? ['On-device speech', 'No account or API key', 'Native SwiftUI + AppKit', 'One payment. Yours for life.'] : ['Local agent activity', 'Sticky notes within reach', 'No account or server', 'One payment. Yours for life.']).map(text => <span><span aria-hidden="true">✓</span>{text}</span>)}</div>
    <section class="shell section" id="how"><div class="section-heading"><div><p class="eyebrow">Fits around the way you work</p><h2>{isWisp ? <>One shortcut.<br/><span class="serif">A little more room to think.</span></> : <>From checking everything<br/><span class="serif">to knowing where to look.</span></>}</h2></div><p>{isWisp ? 'For the moments when explaining it out loud is easier than getting it onto the page.' : 'A small, independent utility for your existing agents. No new coding environment to move into.'}</p></div><div class="steps">{steps.map(([title,body],index) => <article><span class="step-number">0{index + 1}</span><h3>{title}</h3><p>{body}</p></article>)}</div></section>
    <section class="features-section"><div class="shell section"><div class="section-heading"><div><p class="eyebrow">Little details. Everyday differences.</p><h2>{isWisp ? <>Built for the things<br/><span class="serif">you actually say.</span></> : <>A smaller footprint.<br/><span class="serif">A clearer picture.</span></>}</h2></div></div><div class="feature-grid">{item.features.map((feature,index) => <article><div class="feature-art" aria-hidden="true">
      {isWisp && index === 0 ? <div class="sentence-flow"><span>Talk.</span><i>↓</i><span>Pause. Insert.</span><i>↳</i><span>Keep talking.</span></div> : isWisp && index === 1 ? <div class="vocabulary"><span>get hub <b>→ GitHub</b></span><span>kubernetis <b>→ Kubernetes</b></span><span>next js <b>→ Next.js</b></span></div> : isWisp && index === 2 ? <div class="local-diagram"><span>Your voice</span><b>→</b><span>Your Mac</span><small>No round trip to a server.</small></div> : isWisp && index === 3 ? <div class="cleanup-art"><p><del>Um,</del> let’s ship <del>uh,</del><br/>the next thing.</p><span>Same thought. A little tidier.</span></div> : isWisp && index === 4 ? <div class="shortcut-art"><kbd>⌃</kbd><kbd>⌥</kbd><kbd>Space</kbd></div> : isWisp ? <div class="history-art"><span>Today</span><p>A new idea for the onboarding.</p><p>Three things to fix before launch.</p><small>Stored right here on your Mac.</small></div> : <span class="feature-glyph">{feature.icon}</span>}
      </div><div class="feature-copy"><h3>{feature.title}</h3><p>{feature.body}</p></div></article>)}</div></div></section>
    {!isWisp && <section class="shell integrations section"><div><p class="eyebrow">The connections, honestly</p><h2>Your agents.<br/><span class="serif">Their own apps.</span></h2><p>Perch reads local events. It doesn’t read your prompts or send replies. Your agent plans and API costs stay separate.</p></div><div class="provider-list"><div><b>Claude Code</b><span>CLI activity verified</span></div><div><b>Cursor</b><span>Local Agent activity verified</span></div><div><b>Codex</b><span>Adapter built · live checks pending</span></div><p class="fine">Cursor’s passive hooks don’t expose permission-waiting status. Session-opening behavior varies by provider.</p></div></section>}
    <section class="shell section" id="pricing"><div class="section-heading"><div><p class="eyebrow">Your time has better things to do</p><h2>Build it. Buy it.<br/><span class="serif">Or build on it.</span></h2></div><p>No monthly bill. No annual plan.<br/>Just a useful tool, on your terms.</p></div><Pricing product={key}/></section>
    <SourceSection/>
    <section class="shell section faq-layout" id="questions"><div><p class="eyebrow">Before you make it yours</p><h2>A few good<br/><span class="serif">questions.</span></h2><a class="text-link" href={`mailto:${site.email}?subject=${encodeURIComponent(item.name)}`}>Ask Quiet Machines something else ↗</a></div><div class="faq">{[...item.faq,...ownershipFaq.slice(0,3)].map(entry => <details><summary>{entry.q}</summary><p>{entry.a}</p></details>)}</div></section>
    <section class="shell product-close"><Mark product={key} size={68}/><div><p class="eyebrow">Small tools. More room to build.</p><h2>{isWisp ? 'Give the thought somewhere to go.' : 'Keep the little things in view.'}</h2></div><a class="button" href="#pricing">Explore {item.name} <span aria-hidden="true">↑</span></a></section>
  </div>
</Store>
<style>
.product-page{--accent:#7c6697;--tint:#f1edf7}.product-page.perch{--accent:#8b7750;--tint:#f3eee4}.product-subnav{display:flex;justify-content:space-between;align-items:center;padding-block:14px;border-bottom:1px solid var(--line)}.product-subnav>a{display:flex;gap:8px;align-items:center;font-size:15px;font-weight:600}.product-subnav>div{display:flex;gap:25px;font-size:12px;color:var(--muted)}.product-hero{text-align:center;padding:45px 0 42px}.hero-icon{display:flex;justify-content:center;margin-bottom:14px}.product-hero>.eyebrow{font-size:10px;letter-spacing:1.5px}.product-hero h1{margin:22px 0 23px;font-size:clamp(44px,6vw,78px)}.product-hero .serif{color:var(--accent)}.product-hero .lead{margin:auto;max-width:525px;font-size:17px}.product-hero .actions{justify-content:center;margin:27px 0 17px}.product-hero .fine{font-size:11px}.product-hero .status-label{margin-top:13px}.hero-demo{max-width:940px}.hero-demo :global(.wisp-demo){padding:25px 55px}.hero-demo :global(.demo-top){margin-bottom:18px}.hero-demo :global(.editor-body){min-height:210px}.hero-demo :global(.editor){max-width:700px}.hero-demo :global(.perch-capture){max-width:530px}.benefit-strip{display:flex;justify-content:center;flex-wrap:wrap;gap:38px;padding-block:26px;border-bottom:1px solid var(--line);font-size:11px;color:var(--muted)}.benefit-strip>span>span{color:#758965;margin-right:7px}.steps{display:grid;grid-template-columns:repeat(3,1fr);gap:45px;margin-top:45px}.step-number{font:12px var(--mono);color:var(--accent);border:1px solid #ddd5e6;background:var(--tint);border-radius:50%;display:grid;place-items:center;width:38px;height:38px}.steps h3{font-size:22px;margin:20px 0 12px}.steps p{font-size:14px;color:var(--muted)}.features-section{background:#f5f5f0;border-block:1px solid var(--line)}.feature-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:20px}.feature-grid article{background:#fff;border:1px solid #e4e3de;border-radius:14px;padding:9px}.feature-art{border-radius:8px;background:var(--tint);height:182px;display:flex;align-items:center;justify-content:center;padding:20px;color:#6c587f}.feature-copy{padding:21px 17px 23px}.feature-copy h3{font-size:20px;letter-spacing:-.5px;margin-bottom:11px}.feature-copy p{font-size:13px;color:var(--muted)}.sentence-flow{display:flex;flex-wrap:wrap;align-items:center;justify-content:center;gap:9px;max-width:210px}.sentence-flow span{font-size:12px;background:#ffffffcf;border:1px solid #e2d9eb;padding:10px 13px;border-radius:7px}.sentence-flow i{font-style:normal;color:#9c88b0}.vocabulary{display:grid;gap:13px;width:100%;font:10px var(--mono)}.vocabulary>span{display:flex;justify-content:space-between;color:#85778f}.vocabulary b{font-weight:500;color:#5b4174;background:#ffffffa8;border:1px solid #e0d5ea;padding:5px 7px;border-radius:5px}.local-diagram{display:flex;gap:11px;align-items:center;justify-content:center;flex-wrap:wrap}.local-diagram>span{border:1px solid #ddcfea;background:#ffffffa8;padding:13px;border-radius:8px;font-size:12px}.local-diagram>b{font-weight:400}.local-diagram small{width:100%;text-align:center;font-size:10px;margin-top:5px}.cleanup-art p{font-size:20px;letter-spacing:-.5px}.cleanup-art del{color:#ad8c9c;text-decoration-color:#c59aaf}.cleanup-art>span{font-size:10px;display:block;margin-top:12px;color:#87738e}.shortcut-art{display:flex;gap:8px}.shortcut-art kbd{background:#fff;border:1px solid #ddd3e9;border-bottom-width:4px;border-radius:9px;padding:15px 13px;font:18px var(--mono)}.shortcut-art kbd:last-child{font-size:13px;padding-top:18px}.history-art{background:#fff;border:1px solid #e5dfee;border-radius:7px;padding:15px;width:100%;font-size:10px}.history-art>span{font:9px var(--mono);color:#93839d}.history-art p{padding-top:10px}.history-art small{display:block;font-size:8px;border-top:1px solid #eee8f3;padding-top:9px;margin-top:10px}.feature-glyph{font:50px var(--mono);color:var(--accent)}.integrations{display:grid;grid-template-columns:1fr 1fr;gap:70px}.integrations h2{margin:20px 0}.integrations>div>p:last-child{font-size:14px;color:var(--muted);max-width:390px}.provider-list>div{display:flex;align-items:center;justify-content:space-between;gap:15px;padding:22px 0;border-bottom:1px solid var(--line);font-size:14px}.provider-list>div>span{font-size:11px;color:var(--muted)}.provider-list .fine{margin-top:18px}.product-close{display:flex;align-items:center;gap:25px;padding:30px;border:1px solid var(--line);border-radius:14px;margin-bottom:60px;background:#f2f4ec}.product-close h2{font-size:26px;letter-spacing:-.8px;margin-top:7px}.product-close .eyebrow{font-size:9px}.product-close .button{margin-left:auto;white-space:nowrap}
@media(max-width:900px){.feature-grid{grid-template-columns:1fr 1fr}.benefit-strip{gap:20px}.product-close h2{font-size:22px}}
@media(max-width:760px){.product-subnav>div{gap:16px;font-size:10px}.product-hero{padding:30px 0}.hero-icon :global(.app-mark){width:75px;height:75px}.product-hero h1{font-size:clamp(39px,10vw,58px);letter-spacing:-2px}.product-hero .lead{font-size:16px}.product-hero>.eyebrow{font-size:8px;letter-spacing:1px}.product-hero .button{font-size:12px;padding-inline:13px;gap:8px}.hero-demo :global(.wisp-demo){padding:16px}.benefit-strip{display:grid;grid-template-columns:1fr 1fr;gap:14px;font-size:10px}.steps{grid-template-columns:1fr;gap:26px;margin-top:30px}.steps article{display:grid;grid-template-columns:38px 1fr;gap:8px 15px}.steps h3{margin:6px 0 0;font-size:20px}.steps p{grid-column:2}.feature-grid{grid-template-columns:1fr}.feature-art{height:175px}.feature-copy{padding:20px}.feature-copy p{font-size:14px}.integrations{grid-template-columns:1fr;gap:20px}.product-close{flex-wrap:wrap;gap:15px;padding:20px}.product-close>div{flex:1;min-width:170px}.product-close h2{font-size:23px}.product-close .button{margin-left:0;width:100%}.product-close :global(.app-mark){width:50px;height:50px}}
</style>
