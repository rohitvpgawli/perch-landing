---
import type { App } from "../data/apps";

interface Props {
  app: App;
  size?: number;
  class?: string;
  morph?: boolean;
  /** Force the full-colour icon even for an unreleased app. */
  reveal?: boolean;
}

const { app, size = 64, class: cls, morph = false, reveal = false } = Astro.props;
const soon = app.kind === "soon" && !reveal;
---

<span
  class:list={["icon", cls, { soon }]}
  style={`--c1:${app.grad[0]};--c2:${app.grad[1]};--s:${size}px${morph ? `;view-transition-name:icon-${app.slug}` : ""}`}
  aria-hidden="true"
>
  <svg viewBox="0 0 24 24" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
    {
      app.slug === "wisp" && (
        <>
          <path d="M4.5 10.5v3" />
          <path d="M8.25 8v8" />
          <path d="M12 5v14" stroke-width="2.6" />
          <path d="M15.75 8v8" />
          <path d="M19.5 10.5v3" />
        </>
      )
    }
    {
      app.slug === "perch" && (
        <>
          <path d="M3.5 16.5h17" />
          <circle cx="10.5" cy="11.2" r="4.2" fill="#fff" stroke="none" />
          <path d="M14.2 9.6 17 8.4l-2.3 2.6" fill="#fff" stroke="none" />
          <circle cx="11.9" cy="10.2" r=".7" fill="var(--c1)" stroke="none" />
        </>
      )
    }
    {
      app.slug === "handle" && (
        <>
          <rect x="4" y="9.5" width="16" height="5" rx="2.5" fill="#fff" stroke="none" />
          <circle cx="7" cy="12" r="1.1" fill="var(--c1)" stroke="none" />
        </>
      )
    }
    {
      app.slug === "sakana" && (
        <>
          <path d="M4 12c2.6-3.6 6-5.2 9.3-5.2 2.6 0 4.6 1.6 6.2 3.7a1.4 1.4 0 0 1 0 1.6c-1.6 2.1-3.6 3.7-6.2 3.7C10 15.8 6.6 15.6 4 12Z" fill="#fff" stroke="none" />
          <path d="M4 12 1.8 8.6c-.3-.5.1-1.1.6-1l5 1.3M4 12l-2.2 3.4c-.3.5.1 1.1.6 1l5-1.3" fill="#fff" stroke="none" />
          <circle cx="16" cy="11.4" r=".9" fill="var(--c1)" stroke="none" />
        </>
      )
    }
  </svg>
</span>

<style>
  .icon {
    position: relative;
    display: inline-grid;
    place-items: center;
    flex: none;
    width: var(--s);
    height: var(--s);
    border-radius: 22.5%;
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.3), transparent 55%),
      linear-gradient(160deg, var(--c2), var(--c1));
    box-shadow:
      inset 0 0.5px 0 rgb(255 255 255 / 0.55),
      inset 0 -1px 1px rgb(0 0 0 / 0.08),
      0 calc(var(--s) * 0.06) calc(var(--s) * 0.16) rgb(0 0 0 / 0.16);
    overflow: hidden;
  }

  svg {
    width: 58%;
    height: 58%;
    filter: drop-shadow(0 1px 1px rgb(0 0 0 / 0.14));
  }

  .soon {
    background:
      linear-gradient(180deg, rgb(255 255 255 / 0.1), transparent 55%),
      linear-gradient(160deg, #3a3a3f, #141416);
    box-shadow:
      inset 0 0.5px 0 rgb(255 255 255 / 0.22),
      0 calc(var(--s) * 0.06) calc(var(--s) * 0.16) rgb(0 0 0 / 0.3);
  }

  .soon svg {
    opacity: 0.38;
    filter: none;
  }

  .soon::after {
    content: "";
    position: absolute;
    inset: -40%;
    background: linear-gradient(115deg, transparent 42%, rgb(255 255 255 / 0.18) 50%, transparent 58%);
    transform: translateX(-60%);
    animation: shimmer 5.5s ease-in-out infinite;
  }

  @keyframes shimmer {
    0%,
    55% {
      transform: translateX(-60%);
    }
    85%,
    100% {
      transform: translateX(60%);
    }
  }
</style>
