---
import ProductPage from '../../../components/ProductPage.astro';
import ProductComingSoon from '../../../components/ProductComingSoon.astro';
import { getProductHost, productSlugs, type ProductSlug } from '../../../data/hosts';
import { productKeys, type ProductKey } from '../../../data/store';

export function getStaticPaths() {
  return productSlugs.map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug as ProductSlug;
const host = getProductHost(slug)!;
const isSellable = host.availability === 'live' && productKeys.includes(slug as ProductKey);
---
{isSellable ? (
  <ProductPage product={slug as ProductKey} />
) : (
  <ProductComingSoon slug={slug} />
)}
