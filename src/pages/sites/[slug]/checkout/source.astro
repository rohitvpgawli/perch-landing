---
import OrderPage from '../../../../components/store/OrderPage.astro';
import { productKeys, type ProductKey } from '../../../../data/store';
import { isProductSlug } from '../../../../data/hosts';

export function getStaticPaths() {
  return productKeys.map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug;
if (!isProductSlug(slug) || !productKeys.includes(slug as ProductKey)) {
  return Astro.redirect('/');
}
---
<OrderPage product={slug as ProductKey} variant="source" />
