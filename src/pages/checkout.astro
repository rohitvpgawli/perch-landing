---
import Store from '../layouts/Store.astro';
import Mark from '../components/store/Mark.astro';
import { perch, checkoutReady, paymentLink } from '../data/perch';
---
<Store title="Perch for Mac — $29 USD, one time" noindex>
  <section class="shell section order"><a class="text-link" href="/">← Back to Perch</a><div class="order-grid"><div><Mark product="perch" size={90}/><p class="eyebrow">A place at the edge</p><h1>Pay once.<br/><span class="serif">Keep your flow.</span></h1><p class="lead">{perch.description}</p><p class="fine">{perch.requirements}</p></div><div class="order-card"><span class="badge">Perch for Mac</span><h2>$29 <span>USD · one time</span></h2><p>No subscription. No recurring charges.</p><ul><li>Native Mac app and screen-edge shelf</li><li>Local agent activity and session shortcuts</li><li>Pinned sticky notes and keyboard shortcuts</li><li>Local storage, no account required</li></ul>{checkoutReady ? <><a class="button" href={paymentLink}>Continue to Stripe ↗</a><p class="fine">Applicable taxes are calculated at checkout.</p></> : <div class="closed"><h3>Nearly ready to perch.</h3><p>The app will be $29 USD, paid once. Purchases are closed while we prepare delivery. No payment is collected.</p><a class="text-link" href={perch.support}>Ask about availability ↗</a></div>}<p class="fine">App license only. Source code is not included. Update coverage, device limits, support, and refund details will be published before sales open.</p><p class="fine"><a href="/terms/">Terms</a> · <a href="/privacy/">Privacy</a></p></div></div></section>
</Store>
<style>
.order-grid{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center;margin-top:45px}.order h1{font-size:clamp(44px,5vw,66px);margin:20px 0}.order .eyebrow{margin-top:24px}.order .lead{font-size:17px}.order .fine{margin-top:18px}.order-card{border:1px solid var(--line);border-radius:16px;background:#fff;padding:32px}.order-card h2{font-size:64px;margin:20px 0 12px}.order-card h2 span{font-size:13px;letter-spacing:0;color:var(--muted)}.order-card>p{color:var(--muted);font-size:14px}.order-card ul{padding-left:20px;font-size:14px;line-height:2}.closed{padding:22px;background:#f3f0e7;border-radius:10px;margin:25px 0}.closed h3{font-size:22px}.closed p{font-size:14px;margin:12px 0;color:var(--muted)}.closed .text-link{font-size:13px}.order-card .button{width:100%}@media(max-width:760px){.order-grid{grid-template-columns:1fr;gap:35px}.order-card{padding:24px}}
</style>
