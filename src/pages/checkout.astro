---
import Store from '../layouts/Store.astro';
import Mark from '../components/store/Mark.astro';
import Waitlist from '../components/store/Waitlist.astro';
import { perch, checkoutReady, paymentLink } from '../data/perch';
const seats = perch.launchSeats.toLocaleString('en-US');
---
<Store title={`Perch for Mac: $${perch.price} once`} noindex>
  <section class="shell section order">
    <a class="text-link" href="/">← Back to Perch</a>
    <div class="order-grid">
      <div>
        <Mark product="perch" size={90}/>
        <p class="eyebrow">Launch pricing</p>
        <h1>Pay once.<br/><span class="soft">Keep your flow.</span></h1>
        <p class="lead">{perch.description}</p>
        <p class="fine">{perch.requirements}</p>
      </div>
      <div class="order-card">
        <span class="badge">First {seats} customers</span>
        <h2><s>${perch.regularPrice}</s> ${perch.price} <span>USD · one time</span></h2>
        <p>No subscription. No recurring charges. ${perch.regularPrice} after the first {seats} customers.</p>
        <ul><li>Native Mac app and screen-edge shelf</li><li>Live status for Claude Code, Codex and Cursor</li><li>Approve, answer and reply from the card</li><li>Pinned sticky notes and keyboard shortcuts</li><li>A year of updates and email support</li><li>Full refund within 14 days</li></ul>
        {checkoutReady
          ? <><a class="button" href={paymentLink}>Continue to Stripe ↗</a><p class="fine">Applicable taxes are calculated at checkout.</p></>
          : <div class="closed"><h3>Nearly ready to perch.</h3><p>Purchases are closed while we prepare delivery. No payment is collected yet. Leave your email and we’ll tell you the day it opens.</p><Waitlist source="checkout" compact note="One email on launch day. No spam."/></div>}
        <p class="fine">App license only. Source code is not included. See the <a href="/terms/">terms and refund policy</a> and <a href="/privacy/">privacy policy</a>.</p>
      </div>
    </div>
  </section>
</Store>
<style>
.order{padding-top:150px}
.order-grid{display:grid;grid-template-columns:1fr 1fr;gap:70px;align-items:center;margin-top:45px}
.order h1{font-size:clamp(44px,5vw,66px);margin:20px 0;letter-spacing:-.05em}
.soft{color:rgba(255,255,255,.5)}
.order .eyebrow{margin-top:24px;color:#FAC961}
.order .lead{font-size:17px}
.order .fine{margin-top:18px}
.order-card{border-radius:26px;background:#111215;box-shadow:inset 0 0 0 1px rgba(255,255,255,.1),0 40px 90px -40px rgba(250,201,97,.3);padding:34px}
.order-card .badge{border-color:rgba(250,201,97,.35);color:#FAC961}
.order-card h2{font-size:64px;margin:20px 0 12px;letter-spacing:-.05em}
.order-card h2 s{font-size:.5em;color:rgba(255,255,255,.4);text-decoration-thickness:2px;margin-right:6px}
.order-card h2 span{font-size:13px;letter-spacing:0;color:var(--muted)}
.order-card>p{color:var(--muted);font-size:14px}
.order-card ul{padding-left:20px;font-size:14px;line-height:2;color:rgba(255,255,255,.8)}
.closed{padding:22px;background:rgba(250,201,97,.08);box-shadow:inset 0 0 0 1px rgba(250,201,97,.2);border-radius:14px;margin:25px 0}
.closed h3{font-size:22px}
.closed p{font-size:14px;margin:12px 0;color:var(--muted)}
.closed .text-link{font-size:13px}
.order-card .button{width:100%}
@media(max-width:760px){.order{padding-top:120px}.order-grid{grid-template-columns:1fr;gap:35px}.order-card{padding:24px}}
</style>
