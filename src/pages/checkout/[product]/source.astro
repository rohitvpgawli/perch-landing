---
import { productHref, isProductSlug } from '../../../data/hosts';
import { productKeys, type ProductKey } from '../../../data/store';

export function getStaticPaths() {
  return productKeys.map((product) => ({ params: { product } }));
}

const product = Astro.params.product!;
if (isProductSlug(product) && productKeys.includes(product as ProductKey)) {
  return Astro.redirect(productHref(product as ProductKey, '/checkout/source'), 301);
}
return Astro.redirect('/');
---
