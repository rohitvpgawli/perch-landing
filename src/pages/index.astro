---
/**
 * Company apex: quietmachines.xyz
 * Product landings live on their own subdomains (see src/data/hosts.ts).
 */
import Store from '../layouts/Store.astro';
import Mark from '../components/store/Mark.astro';
import { productHosts, productHref, type ProductSlug } from '../data/hosts';
import { products, type ProductKey } from '../data/store';
import { site } from '../data/site';

const sellable = productHosts.filter((p) => p.availability === 'live');
const soon = productHosts.filter((p) => p.availability === 'soon');
---
<Store title="Quiet Machines" description={site.description} siteKind="company">
  <section class="shell hero">
    <p class="eyebrow hero-eyebrow"><span/> Quiet Machines</p>
    <h1>Move fast.<br/><span class="serif">Keep your freedom.</span></h1>
    <p class="lead">
      Quiet Machines builds small, focused tools that help thousands of people worldwide
      ship work faster — without renting their workflow from a subscription.
    </p>
    <div class="actions">
      <a class="button" href="#products">See what we’re building <span aria-hidden="true">↓</span></a>
      <a class="text-link" href={`mailto:${site.email}`}>Talk to us ↗</a>
    </div>
    <p class="hero-note">One company. Dedicated product homes. Pay once when a tool is ready.</p>
  </section>

  <section class="shell section company-mission" id="about">
    <div class="section-heading">
      <div>
        <p class="eyebrow">01 / The company</p>
        <h2>Software that gets out<br/><span class="serif">of your way.</span></h2>
      </div>
      <p>
        We make Mac tools for people who want speed and ownership —
        not another monthly bill between them and their work.
      </p>
    </div>
    <div class="mission-grid">
      <article>
        <h3>Move fast</h3>
        <p>Dictate the next idea. See which agent needs you. Spend less time babysitting the machine and more time building.</p>
      </article>
      <article>
        <h3>Stay free</h3>
        <p>One-time purchases. Local-first where it matters. Source packages when you want to take a tool further yourself.</p>
      </article>
      <article>
        <h3>Built for humans at scale</h3>
        <p>Quiet Machines tools are already helping thousands of users globally cut friction from everyday creative and technical work.</p>
      </article>
    </div>
  </section>

  <section class="shell tools section" id="products">
    <div class="section-heading">
      <div>
        <p class="eyebrow">02 / Products</p>
        <h2>Each product gets<br/><span class="serif">its own home.</span></h2>
      </div>
      <p>
        Company story lives here.<br/>
        Product details live on their subdomains.
      </p>
    </div>

    <div class="tool-shelf company-shelf">
      {sellable.map((host) => {
        const key = host.slug as ProductKey;
        const item = products[key];
        return (
          <a href={productHref(host.slug)} class={`shelf-item ${host.slug}`}>
            <Mark product={key} size={66}/>
            <div>
              <span class="shelf-name">{host.name}<span aria-hidden="true">↗</span></span>
              <p>{host.pitch}</p>
              <span class="status-label">{item.status}</span>
            </div>
            <span class="shelf-price">
              from ${item.price}
              <small>once · planned</small>
            </span>
          </a>
        );
      })}
      {soon.map((host) => (
        <a href={productHref(host.slug)} class={`shelf-item soon ${host.slug}`}>
          <div class="soon-mark" aria-hidden="true">{host.name.slice(0, 1)}</div>
          <div>
            <span class="shelf-name">{host.name}<span aria-hidden="true">↗</span></span>
            <p>{host.pitch}</p>
            <span class="status-label">{host.status}</span>
          </div>
          <span class="shelf-price"><small>{host.subdomain}.{site.domain}</small></span>
        </a>
      ))}
    </div>
  </section>

  <section class="shell maker section" id="why">
    <div>
      <p class="eyebrow">03 / Why Quiet Machines</p>
      <h2>Useful little tools.<br/><span class="serif">Zero interest in MRR.</span></h2>
    </div>
    <div class="maker-note">
      <p>
        We’re building a studio of independent Mac products — each with a clear job,
        its own address on the internet, and a purchase model that respects your attention.
      </p>
      <p>
        If a tool saves you days, buy it. If you want to take it somewhere else, get the source.
        Either way, you pay once.
      </p>
      <div class="signature">
        <span class="serif">{site.maker.name.split(' ')[0]}</span>
        <a class="text-link" href={`mailto:${site.email}`}>Say hello ↗</a>
      </div>
    </div>
  </section>

  <section class="shell closing">
    <p class="eyebrow">Find the tool that fits</p>
    <h2>Start with a product.<br/><span class="serif">Come back for the company.</span></h2>
    <div class="actions">
      {sellable.map((host) => (
        <a class="button" href={productHref(host.slug as ProductSlug)}>
          {host.name} <span aria-hidden="true">↗</span>
        </a>
      ))}
    </div>
    <p class="fine">wisp.{site.domain} · perch.{site.domain} · sakana.{site.domain}</p>
  </section>
</Store>
<style>
.hero{text-align:center;padding:72px 0 0}.hero-eyebrow{display:flex;align-items:center;justify-content:center;gap:9px}.hero-eyebrow>span{width:6px;height:6px;background:#7b946d;border-radius:50%;box-shadow:0 0 0 4px #e7eddf}.hero h1{margin:25px -30px 23px;font-size:clamp(42px,6vw,77px);letter-spacing:-3.5px}.hero h1 .serif{color:#667b5d}.hero .lead{margin:auto;font-size:18px;line-height:1.75;max-width:620px}.hero .actions{justify-content:center;margin:30px 0 16px;gap:25px}.hero-note{font-size:11px;color:#7a8278}.company-mission{padding-top:72px}.mission-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;margin-top:36px}.mission-grid article{padding-top:8px}.mission-grid h3{font-size:22px;margin-bottom:12px;letter-spacing:-.4px}.mission-grid p{font-size:14px;color:var(--muted);line-height:1.65}.tools{padding-top:70px;padding-bottom:70px}.company-shelf{display:grid;grid-template-columns:1fr;gap:16px;margin-top:36px;text-align:left}.shelf-item{display:flex;align-items:center;gap:15px;border:1px solid #e1ddeb;background:#f2eff7;border-radius:12px;padding:19px 24px;transition:transform .2s}.shelf-item:hover{transform:translateY(-3px)}.shelf-item.perch{background:#f4f0e6;border-color:#e7e0d2}.shelf-item.soon{background:#f5f6f2;border-color:#e2e5dc}.shelf-name{font-size:19px;font-weight:550;display:flex;gap:12px;align-items:center;letter-spacing:-.5px}.shelf-name>span{color:#9a93a3;font-size:14px}.shelf-item p{font-size:12px;color:var(--muted);margin-top:3px}.shelf-item .status-label{margin-top:8px}.shelf-price{margin-left:auto;white-space:nowrap;font:11px var(--mono);color:#596052}.shelf-price small{display:block;font:9px/1.7 var(--mono);color:#787f72;margin-top:3px}.soon-mark{width:66px;height:66px;border-radius:16px;background:#e8ebe3;display:grid;place-items:center;font-size:28px;font-weight:600;color:#6b7568;flex-shrink:0}.maker{display:grid;grid-template-columns:1fr 1fr;gap:85px;align-items:start;border-bottom:1px solid var(--line)}.maker h2{margin-top:25px;font-size:42px}.maker-note{padding-top:35px}.maker-note>p{font-size:16px;color:var(--muted);margin-bottom:17px}.signature{display:flex;justify-content:space-between;align-items:center;margin-top:28px}.signature .serif{font-size:34px;color:#738369}.signature .text-link{font-size:12px}.closing{text-align:center;background:#f0f3ea;border:1px solid #e0e6d6;border-radius:18px;padding:50px 24px;margin-bottom:70px}.closing h2{margin:20px 0 25px}.closing .actions{justify-content:center;flex-wrap:wrap}.closing .fine{margin-top:20px;font-size:11px}
@media(max-width:900px){.mission-grid{grid-template-columns:1fr;gap:22px}.maker{gap:40px}.hero h1{margin-inline:0}}
@media(max-width:760px){.hero{padding-top:43px}.hero h1{font-size:clamp(38px,9.4vw,62px);letter-spacing:-1.8px}.hero .lead{font-size:15px}.shelf-item{padding:13px 17px}.maker{grid-template-columns:1fr;gap:0}.maker h2{font-size:36px}.maker-note{padding-top:25px}.closing{padding:38px 18px;margin-bottom:45px}}
</style>
