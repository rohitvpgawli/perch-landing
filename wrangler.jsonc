{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "perchwebsite",
  "account_id": "9162db11ae335d803082e2df44534a88",
  "compatibility_date": "2026-10-14",
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "routes": [
    { "pattern": "perched.fyi", "custom_domain": true },
    { "pattern": "www.perched.fyi", "custom_domain": true }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
